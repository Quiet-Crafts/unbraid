+func TestHandoffStaleCheckNeverAppliesToSuccessor(t *testing.T) {
+	release := make(chan struct{})
+	w := &hoWorld{owner: func() ([]string, error) { <-release; return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	handshake(t, h, []byte("x"))
+	waitState(t, h, flowChecking)
+	// The peer resets and opens again before the first lookup returns.
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1002, 5001, tcpRST, nil))
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 7000, 0, tcpSYN, nil))
+	close(release)
+	time.Sleep(200 * time.Millisecond)
+	h.access.Lock()
+	f := h.tab.flows[flowKey{hoPeerEnd, 1716}]
+	h.access.Unlock()
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.state != flowOpening {
+		t.Fatalf("successor state %d, want opening", f.state)
+	}
+}
