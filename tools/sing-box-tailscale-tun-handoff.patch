+func TestHandoffUDPRefusals(t *testing.T) {
+	t.Run("app without UDP", func(t *testing.T) {
+		w := &hoWorld{listener: []string{"a"}, owner: func() ([]string, error) { return []string{"a"}, nil }}
+		h := newUDPHandoff(t, w, []string{"st"}) // "a" may take TCP only
+		if !h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("x"))) || w.systemCount() != 0 {
+			t.Fatal("UDP reached an app allowed TCP only")
+		}
+		h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("y")))
+		if w.lookupCount() != 1 || w.systemCount() != 0 {
+			t.Fatal("a refused exchange was looked up again or delivered")
+		}
+		if fromSystem(h, udpPacket(hoUDPLocal, hoPeerEnd, []byte("z"))) {
+			t.Fatal("a refused exchange took the app's own datagram")
+		}
+	})
+	t.Run("blocked app", func(t *testing.T) {
+		w := &hoWorld{listener: []string{"st"}, owner: func() ([]string, error) { return []string{"st"}, nil }}
+		h := newUDPHandoff(t, w, []string{"st"})
+		h.block["st"] = true
+		h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("x")))
+		if w.systemCount() != 0 {
+			t.Fatal("UDP reached a blocked app")
+		}
+	})
+	t.Run("device not chosen", func(t *testing.T) {
+		w := &hoWorld{listener: []string{"st"}, owner: func() ([]string, error) { return []string{"st"}, nil }}
+		h := newUDPHandoff(t, w, []string{"st"})
+		h.allowNodes = map[string]bool{"n2": true}
+		h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("x")))
+		if w.systemCount() != 0 {
+			t.Fatal("UDP from a device that isn't chosen")
+		}
+	})
+	t.Run("nobody holds the port, or UDP off", func(t *testing.T) {
+		w := &hoWorld{noListener: true, owner: func() ([]string, error) { return []string{"st"}, nil }}
+		h := newUDPHandoff(t, w, []string{"st"})
+		if h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("x"))) {
+			t.Fatal("took a datagram for a port nobody holds")
+		}
+		w2 := &hoWorld{listener: []string{"st"}, owner: func() ([]string, error) { return []string{"st"}, nil }}
+		h2 := newUDPHandoff(t, w2, nil)
+		if h2.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("x"))) || w2.lookupCount() != 0 {
+			t.Fatal("UDP handled with no app allowed it")
+		}
+		if h2.Inbound(udpPacket(hoPeerEnd, netip.AddrPortFrom(hoLocal, 53), []byte("x"))) {
+			t.Fatal("took a port below 1024")
+		}
+	})
+}
