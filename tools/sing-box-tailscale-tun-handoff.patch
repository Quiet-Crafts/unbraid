+func TestHandoffUDPAllowedBothWays(t *testing.T) {
+	tunhandoff.ClearEvents()
+	w := &hoWorld{listener: []string{"st"}, owner: func() ([]string, error) { return []string{"st"}, nil }}
+	h := newUDPHandoff(t, w, []string{"st"})
+	if !h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("hello"))) || w.systemCount() != 1 {
+		t.Fatal("first datagram of an allowed exchange not delivered")
+	}
+	h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("again")))
+	if w.systemCount() != 2 || w.lookupCount() != 1 {
+		t.Fatalf("later datagram: system %d, lookups %d", w.systemCount(), w.lookupCount())
+	}
+	if !fromSystem(h, udpPacket(hoUDPLocal, hoPeerEnd, []byte("reply"))) || w.peerCount() != 1 {
+		t.Fatal("the app's reply didn't reach the peer")
+	}
+	// The app's datagrams to anyone else are its own traffic.
+	if fromSystem(h, udpPacket(hoUDPLocal, netip.AddrPortFrom(hoPeer, 9), []byte("x"))) {
+		t.Fatal("took a datagram of no exchange")
+	}
+	if ev := tunhandoff.Events(); len(ev) != 1 || !ev[0].Allowed || ev[0].Proto != "udp" || ev[0].Port != 21027 {
+		t.Fatalf("events %+v", ev)
+	}
+}
