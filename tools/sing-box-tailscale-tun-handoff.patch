+//go:build with_gvisor
+
+package tailscale
+
+// The Tailscale endpoint's side of the TUN hand-off (unbraid patch).
+
+import (
+	"net/netip"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/tunhandoff"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/tailscale/net/packet"
+)
+
+// setupHandoff runs in NewEndpoint: it tells this engine instance's TUN to install the interceptor. CloseConstructed
+// gives the binding back, also when the endpoint never starts (a configuration check).
+func (t *Endpoint) setupHandoff(options *option.TailscaleTUNHandoffOptions) {
+	if options == nil {
+		return
+	}
+	t.handoffBinding = tunhandoff.Acquire(t.router)
+	t.handoffBinding.Want()
+	t.handoffRefresh = make(chan struct{}, 1)
+	t.handoff = newHandoff(t.logger, options, handoffDeps{
+		owner:    t.handoffOwner,
+		toPeer:   t.handoffToPeer,
+		toSystem: t.handoffBinding.Write,
+	})
+}
+
+// startHandoff runs in postStart, once the engine exists; scope undoes it.
+func (t *Endpoint) startHandoff(scope *adapter.Scope) {
+	if t.handoff == nil {
+		return
+	}
+	ns := t.server.ExportNetstack()
+	take := func(p *packet.Parsed) bool { return t.handoff.Inbound(p.Buffer()) }
+	ns.InboundHandoff.Store(&take)
+	token := t.handoffBinding.SetHandler(t.handoff)
+	t.requestHandoffRefresh()
+	go t.handoffRefresher()
+	go t.handoff.sweep()
+	scope.Add(func() error {
+		ns.InboundHandoff.Store(nil)
+		t.handoffBinding.ClearHandler(token)
+		return t.CloseConstructed()
+	})
+}
+
+// CloseConstructed stops the hand-off and gives the binding back, once.
+func (t *Endpoint) CloseConstructed() error {
+	if t.handoff != nil {
+		t.handoffCloseOnce.Do(func() {
+			t.handoff.close()
+			tunhandoff.Release(t.router, t.handoffBinding)
+		})
+	}
+	return nil
+}
+
+func (t *Endpoint) requestHandoffRefresh() {
+	select {
+	case t.handoffRefresh <- struct{}{}:
+	default: // one is pending already, and it reads the state when it runs
+	}
+}
+
+// handoffRefresher applies refreshes one at a time, each from the state current when it runs, so an older one never
+// overwrites a newer.
+func (t *Endpoint) handoffRefresher() {
+	for {
+		select {
+		case <-t.handoff.done:
+			return
+		case <-t.handoffRefresh:
+			t.refreshHandoff()
+		}
+	}
+}
+
+// refreshHandoff takes this node's IPv4 address and every peer's own node addresses, with the node holding each,
+// from one live netmap.
+func (t *Endpoint) refreshHandoff() {
+	var local netip.Addr
+	peers := map[netip.Addr]string{}
+	if nm := t.server.ExportLocalBackend().NetMapWithPeers(); nm != nil {
+		if nm.SelfNode.Valid() {
+			addresses := nm.SelfNode.Addresses()
+			for i := 0; i < addresses.Len() && !local.IsValid(); i++ {
+				if prefix := addresses.At(i); prefix.IsSingleIP() && prefix.Addr().Is4() {
+					local = prefix.Addr()
+				}
+			}
+		}
+		for _, node := range nm.Peers {
+			addresses := node.Addresses()
+			for i := 0; i < addresses.Len(); i++ {
+				if prefix := addresses.At(i); prefix.IsSingleIP() && prefix.Addr().Is4() {
+					peers[prefix.Addr()] = string(node.StableID())
+				}
+			}
+		}
+	}
+	t.handoff.setLocal(local, peers)
+}
+
+func (t *Endpoint) handoffOwner(udp bool, local, peer netip.AddrPort) ([]string, error) {
+	if t.platformInterface == nil {
+		return nil, E.New("no platform to name the app")
+	}
+	owner, err := t.platformInterface.FindConnectionOwner(&adapter.FindConnectionOwnerRequest{
+		IpProtocol:         protocol(udp),
+		SourceAddress:      local.Addr().String(),
+		SourcePort:         int32(local.Port()),
+		DestinationAddress: peer.Addr().String(),
+		DestinationPort:    int32(peer.Port()),
+	})
+	if err != nil {
+		return nil, err
+	}
+	return owner.AndroidPackageNames, nil
+}
+
+func (t *Endpoint) handoffToPeer(pkt []byte) bool {
+	engine := t.wgEngine
+	if engine == nil {
+		return false
+	}
+	unmatched, err := engine.InputPackets([][]byte{pkt})
+	return err == nil && len(unmatched) == 0
+}
+
+func protocol(udp bool) int32 {
+	if udp {
+		return 17
+	}
+	return 6
+}
