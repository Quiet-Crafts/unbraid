+func newUDPHandoff(t *testing.T, w *hoWorld, udpAllow []string) *handoff {
+	h := newHandoff(log.NewNOPFactory().NewLogger(""), &option.TailscaleTUNHandoffOptions{
+		TCPPorts: []string{"1714:1764"}, AllowPackages: []string{"a"}, UDPPorts: []string{"1024:65535"}, UDPAllowPackages: udpAllow,
+	}, w.deps())
+	w.h = h
+	h.setLocal(hoLocal, map[netip.Addr]string{hoPeer: "n1"})
+	t.Cleanup(h.close)
+	return h
+}
