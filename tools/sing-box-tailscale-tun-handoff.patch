+package libbox
+
+// Inbound tailnet connections' decisions for the app to show (unbraid patch): in memory only.
+
+import (
+	"encoding/json"
+
+	"github.com/sagernet/sing-box/common/tunhandoff"
+)
+
+// HandoffEvents returns the latest decisions as a JSON array, oldest first.
+func HandoffEvents() string {
+	b, err := json.Marshal(tunhandoff.Events())
+	if err != nil {
+		return "[]"
+	}
+	return string(b)
+}
+
+// ClearHandoffEvents forgets them.
+func ClearHandoffEvents() {
+	tunhandoff.ClearEvents()
+}
