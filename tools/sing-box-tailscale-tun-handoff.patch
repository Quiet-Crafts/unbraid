+func TestChecksumsAndHelpers(t *testing.T) {
+	r := rst4(hoPeerEnd, hoLocalEnd, 42, 7, true)
+	if !checksumsValid(r) {
+		t.Fatal("bad reset checksums")
+	}
+	if p, _ := parseTCP4(r); p.flags != tcpRST|tcpACK || p.seq != 42 || p.ack != 7 {
+		t.Fatalf("reset %+v", p)
+	}
+	pkt := tcpPacket(hoPeerEnd, hoLocalEnd, 1, 2, tcpACK|tcpPSH|tcpFIN|tcpURG, []byte("data"))
+	binary.BigEndian.PutUint16(pkt[38:40], 3)
+	fixChecksums(pkt, 20)
+	bare := bareACK(pkt)
+	p, ok := parseTCP4(bare)
+	if !ok || p.payload != 0 || p.flags != tcpACK || p.seq != 1 || p.ack != 2 || bare[38] != 0 || bare[39] != 0 || !checksumsValid(bare) {
+		t.Fatalf("bare ACK %+v", p)
+	}
+	icmp := make([]byte, 28+40)
+	icmp[0], icmp[9] = 0x45, 1
+	binary.BigEndian.PutUint16(icmp[2:4], uint16(len(icmp)))
+	l4, p4 := hoLocal.As4(), hoPeer.As4()
+	copy(icmp[12:16], p4[:])
+	copy(icmp[16:20], l4[:])
+	icmp[20] = 3
+	copy(icmp[28:], tcpPacket(hoLocalEnd, hoPeerEnd, 1, 1, tcpACK, nil))
+	if key, ok := icmpError(icmp, hoLocal, false, true); !ok || key != (flowKey{hoPeerEnd, 1716, false}) {
+		t.Fatalf("icmp quote %v %v", key, ok)
+	}
+	binary.BigEndian.PutUint16(icmp[28+6:28+8], 10) // the quote is a later fragment: no ports in it
+	if _, ok := icmpError(icmp, hoLocal, false, true); ok {
+		t.Fatal("took a quoted later fragment")
+	}
+	binary.BigEndian.PutUint16(icmp[28+6:28+8], 0)
+	binary.BigEndian.PutUint16(icmp[2:4], uint16(len(icmp)+1))
+	if _, ok := icmpError(icmp, hoLocal, false, true); ok {
+		t.Fatal("took a packet shorter than its length")
+	}
+	st := stream{}
+	st.sent(tcp4{seq: 10, payload: 5})
+	st.acknowledged(100) // beyond what was delivered
+	st.sent(tcp4{seq: 900, flags: tcpRST})
+	if st.acked || st.next != 15 {
+		t.Fatalf("stream %+v", st)
+	}
+}
