+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+var (
+	hoLocal = netip.MustParseAddr("100.64.0.5")
+	hoPeer  = netip.MustParseAddr("100.64.0.6")
+)
+
+type hoWorld struct {
+	mu       sync.Mutex
+	system   [][]byte
+	peer     [][]byte
+	owner    func() ([]string, error)
+	writeErr bool
+}
+
+func (w *hoWorld) deps() handoffDeps {
+	return handoffDeps{
+		owner: func(local, peer netip.AddrPort) ([]string, error) { return w.owner() },
+		toPeer: func(p []byte) {
+			w.mu.Lock()
+			w.peer = append(w.peer, p)
+			w.mu.Unlock()
+		},
+		toSystem: func(p []byte) bool {
+			w.mu.Lock()
+			defer w.mu.Unlock()
+			if w.writeErr {
+				return false
+			}
+			w.system = append(w.system, p)
+			return true
+		},
+	}
+}
+
+func (w *hoWorld) seen() (system, peer []tcp4) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	for _, b := range w.system {
+		p, _ := parseTCP4(b)
+		system = append(system, p)
+	}
+	for _, b := range w.peer {
+		p, _ := parseTCP4(b)
+		peer = append(peer, p)
+	}
+	return
+}
+
+func newTestHandoff(t *testing.T, w *hoWorld, allow, block []string) *handoff {
+	h := newHandoff(log.NewNOPFactory().NewLogger(""), &option.TailscaleTUNHandoffOptions{
+		TCPPorts: []string{"1714:1764", "22"}, AllowPackages: allow, BlockPackages: block,
+	}, w.deps())
+	h.setLocal(hoLocal, map[netip.Addr]struct{}{hoPeer: {}})
+	t.Cleanup(h.close)
+	return h
+}
+
+func tcpPacket(src, dst netip.AddrPort, seq, ack uint32, flags uint8, payload []byte) []byte {
+	b := make([]byte, 40+len(payload))
+	b[0], b[8], b[9] = 0x45, 64, 6
+	binary.BigEndian.PutUint16(b[2:4], uint16(len(b)))
+	s, d := src.Addr().As4(), dst.Addr().As4()
+	copy(b[12:16], s[:])
+	copy(b[16:20], d[:])
+	tcp := b[20:]
+	binary.BigEndian.PutUint16(tcp[0:2], src.Port())
+	binary.BigEndian.PutUint16(tcp[2:4], dst.Port())
+	binary.BigEndian.PutUint32(tcp[4:8], seq)
+	binary.BigEndian.PutUint32(tcp[8:12], ack)
+	tcp[12], tcp[13] = 5<<4, flags
+	copy(tcp[20:], payload)
+	fixChecksums(b, 20)
+	return b
+}
+
+func fromSystem(h *handoff, b []byte) bool {
+	return h.Intercept(hoLocal, func() ([]byte, bool) { return b, true })
+}
+
+var (
+	hoPeerEnd  = netip.AddrPortFrom(hoPeer, 40000)
+	hoLocalEnd = netip.AddrPortFrom(hoLocal, 1716)
+)
+
+// handshake opens a flow: SYN, SYN-ACK, final ACK (with data on it).
+func handshake(t *testing.T, h *handoff, data []byte) {
+	t.Helper()
+	if !h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil)) {
+		t.Fatal("SYN not taken")
+	}
+	if !fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK, nil)) {
+		t.Fatal("SYN-ACK not taken")
+	}
+	if !h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK|tcpPSH, data)) {
+		t.Fatal("final ACK not taken")
+	}
+}
+
+func waitState(t *testing.T, h *handoff, want handoffState) {
+	t.Helper()
+	deadline := time.Now().Add(3 * time.Second)
+	for time.Now().Before(deadline) {
+		h.access.Lock()
+		f := h.tab.flows[flowKey{hoPeerEnd, 1716}]
+		h.access.Unlock()
+		if f != nil {
+			f.mu.Lock()
+			s := f.state
+			f.mu.Unlock()
+			if s == want {
+				return
+			}
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("flow never reached state %d", want)
+}
+
+func payloadTo(ps []tcp4) int {
+	n := 0
+	for _, p := range ps {
+		n += p.payload
+	}
+	return n
+}
