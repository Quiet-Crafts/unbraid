+func TestChecksumsAndHelpers(t *testing.T) {
+	r := rst4(hoPeerEnd, hoLocalEnd, 42)
+	if checksum(r[:20], 0) != 0 {
+		t.Fatal("bad IP checksum")
+	}
+	pkt := tcpPacket(hoPeerEnd, hoLocalEnd, 1, 2, tcpACK|tcpPSH|tcpFIN, []byte("data"))
+	bare := bareACK(pkt)
+	p, ok := parseTCP4(bare)
+	if !ok || p.payload != 0 || p.flags != tcpACK || p.seq != 1 || p.ack != 2 {
+		t.Fatalf("bare ACK %+v", p)
+	}
+	// The TCP checksum of a valid segment, with the pseudo header, sums to zero.
+	sum := uint32(6) + uint32(len(bare)-20)
+	for i := 12; i < 20; i += 2 {
+		sum += uint32(binary.BigEndian.Uint16(bare[i:]))
+	}
+	if checksum(bare[20:], sum) != 0 {
+		t.Fatal("bad TCP checksum on the bare ACK")
+	}
+	icmp := make([]byte, 28+40)
+	icmp[0], icmp[9] = 0x45, 1
+	binary.BigEndian.PutUint16(icmp[2:4], uint16(len(icmp)))
+	l4, p4 := hoLocal.As4(), hoPeer.As4()
+	copy(icmp[12:16], p4[:])
+	copy(icmp[16:20], l4[:])
+	icmp[20] = 3
+	copy(icmp[28:], tcpPacket(hoLocalEnd, hoPeerEnd, 1, 1, tcpACK, nil))
+	key, ok := icmpQuote(icmp, hoLocal)
+	if !ok || key != (flowKey{hoPeerEnd, 1716}) {
+		t.Fatalf("icmp quote %v %v", key, ok)
+	}
+}
