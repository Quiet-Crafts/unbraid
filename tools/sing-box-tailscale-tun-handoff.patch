@@ -0,0 +1,1201 @@
+//go:build with_gvisor
+
+package tailscale
+
+// Hand-off of inbound tailnet TCP to the system through the TUN (unbraid patch). A connection a peer opens to this
+// node's own tailnet address is written into the TUN, so the system delivers it to the listening app with the peer's
+// real address; the app's packets for it are taken back from the TUN before the stack and sent to Tailscale.
+//
+// Two checks guard it. Before the system sees the SYN, it names the app listening on the port: an app that isn't
+// allowed, or a peer that isn't among the allowed devices when only some are, is refused with a reset, and a port no
+// app of the VPN listens on is left to the Tailscale stack as before (its own services live there). After the handshake, it names the app holding the connection, and no byte of payload
+// passes either way until that app is allowed and none of its user id is blocked; otherwise both ends are reset.
+//
+// UDP, when allowed for an app: the first datagram of an exchange (peer address and port, local port) waits for the
+// platform to name the app holding the port; an allowed exchange then passes both ways, the app is named again every
+// few seconds while it lasts, and it ends when idle. A refused exchange is dropped for a while without new lookups.
+// There is no handshake, so no second check: the listener check alone decides.
+//
+// Locking: handoff.access guards the table; each flow's mu orders its state and delivery. access is always taken
+// before a flow's mu, and never while holding one. No I/O happens under access. Every write goes through write, which
+// refuses for a retired flow or a closed hand-off; close waits for the writes under way.
+
+import (
+	"encoding/binary"
+	"net/netip"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/sagernet/sing-box/common/tunhandoff"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+const (
+	handoffMaxFlows     = 512
+	handoffMaxPerPeer   = 64
+	handoffMaxHeldFlow  = 64 << 10
+	handoffMaxHeldTotal = 4 << 20
+	handoffHeldCost     = 64                     // charged per held packet besides its bytes
+	handoffVetWait      = 300 * time.Millisecond // the listener lookup, made before the system sees the SYN
+	handoffOpenWait     = 10 * time.Second       // SYN to the final ACK
+	handoffCheckWait    = 3 * time.Second        // final ACK to the decision
+	handoffIdle         = 2 * time.Hour          // an allowed connection silent this long is closed
+	handoffTombstone    = 30 * time.Second       // a refused or closed tuple stays dead this long
+	handoffPeek         = 136                    // enough for any IPv4 header, TCP flags, or an ICMP error's quote
+	handoffUDPIdle      = 2 * time.Minute        // a UDP exchange silent this long ends
+	handoffUDPRecheck   = 10 * time.Second       // how often the app holding a UDP exchange's port is named again
+	handoffUDPTombstone = 10 * time.Second       // a refused UDP exchange stays dropped this long, without new lookups
+
+	tcpFIN = 0x01
+	tcpSYN = 0x02
+	tcpRST = 0x04
+	tcpPSH = 0x08
+	tcpACK = 0x10
+	tcpURG = 0x20
+)
+
+// handoffCalls bounds the owner lookups in flight in the whole process, stuck ones included: the platform call can't
+// be cancelled, so a reload must not bring fresh slots.
+var handoffCalls = make(chan struct{}, 8)
+
+type handoffState uint8
+
+const (
+	flowOpening  handoffState = iota // SYN delivered, handshake under way
+	flowChecking                     // handshake done, owner check running
+	flowAllowed
+	flowClosing // reset: dropped until removed
+	flowDenied  // refused: dropped until removed
+)
+
+type flowKey struct {
+	peer netip.AddrPort
+	port uint16
+	udp  bool // a UDP exchange; otherwise a TCP connection
+}
+
+// stream is what one direction delivered, and what its receiver acknowledged.
+type stream struct {
+	started, acked, fin bool
+	next                uint32 // after the highest segment delivered
+	ack                 uint32 // the highest acknowledgment the receiver sent back
+	finEnd              uint32
+}
+
+func (s *stream) sent(p tcp4) {
+	if p.flags&tcpRST != 0 {
+		return // takes no sequence space, and the receiver may well reject it
+	}
+	if n := p.next(); !s.started || seqAfter(n, s.next) {
+		s.next, s.started = n, true
+	}
+	if p.flags&tcpFIN != 0 {
+		s.fin, s.finEnd = true, p.next()
+	}
+}
+
+func (s *stream) acknowledged(ack uint32) {
+	if !s.started || seqAfter(ack, s.next) {
+		return // nothing can be acknowledged beyond what was delivered
+	}
+	if !s.acked || seqAfter(ack, s.ack) {
+		s.ack, s.acked = ack, true
+	}
+}
+
+func (s *stream) done() bool { return s.fin && s.acked && !seqAfter(s.finEnd, s.ack) }
+
+// resetAt: the sequence numbers a reset must carry for this stream's receiver to take it. Its next expected byte is
+// the last it acknowledged, or the end of what was delivered when it hasn't acknowledged that yet.
+func (s *stream) resetAt() []uint32 {
+	switch {
+	case !s.started:
+		return nil
+	case s.acked && s.ack != s.next:
+		return []uint32{s.ack, s.next}
+	default:
+		return []uint32{s.next}
+	}
+}
+
+type handoffFlow struct {
+	key     flowKey
+	node    string     // the peer node that opened it
+	local   netip.Addr // this node's address when it opened
+	retired atomic.Bool
+
+	mu                sync.Mutex
+	state             handoffState
+	peerISN, localISN uint32
+	haveLocalISN      bool
+	rx, tx            stream   // peer to system, system to peer
+	in, out           [][]byte // held: towards the system, towards the peer
+	held              int
+	ending            bool      // both ends closed: forwarded until expires, then removed
+	recheckAt         time.Time // UDP: when to name the app holding the port again
+	rechecking        bool      // UDP: a lookup for that is running
+	deadline          time.Time // opening and checking
+	expires           time.Time // closing, denied and ending
+	lastActive        time.Time
+}
+
+type handoffTable struct {
+	local   netip.Addr // invalid: nothing is handed off
+	closed  bool
+	flows   map[flowKey]*handoffFlow
+	perPeer map[netip.Addr]int
+}
+
+func newHandoffTable(local netip.Addr) *handoffTable {
+	return &handoffTable{local: local, flows: map[flowKey]*handoffFlow{}, perPeer: map[netip.Addr]int{}}
+}
+
+// handoffDeps is the outside world, replaced in tests.
+type handoffDeps struct {
+	owner    func(udp bool, local, peer netip.AddrPort) ([]string, error) // packages of the user id holding the socket
+	toPeer   func(packet []byte) bool                                     // into Tailscale, towards the peer
+	toSystem func(packet []byte) bool                                     // into the TUN, towards the system
+}
+
+type portRange struct{ from, to uint16 }
+
+type handoff struct {
+	logger   log.ContextLogger
+	ports    []portRange
+	allow    map[string]bool
+	udpPorts []portRange
+	udpAllow map[string]bool // apps that may take UDP; none: UDP is never handed off
+	block    map[string]bool
+	// allowNodes, when not empty, are the only peer nodes that may connect; the others are refused like an app that
+	// isn't allowed, once the listener check found an app of the VPN on the port.
+	allowNodes map[string]bool
+	deps       handoffDeps
+	heldTotal  atomic.Int64
+	done       chan struct{}
+	closeOnce  sync.Once
+	local      atomic.Pointer[netip.Addr] // lock-free first test for packets from the system
+	closed     atomic.Bool
+	gate       sync.RWMutex // writes hold it shared; close takes it to wait for them
+
+	access sync.Mutex
+	tab    *handoffTable
+	peers  map[netip.Addr]string // peer node address -> node
+}
+
+func newHandoff(logger log.ContextLogger, options *option.TailscaleTUNHandoffOptions, deps handoffDeps) *handoff {
+	h := &handoff{
+		logger: logger, deps: deps, allow: map[string]bool{}, block: map[string]bool{}, allowNodes: map[string]bool{}, udpAllow: map[string]bool{},
+		done: make(chan struct{}), tab: newHandoffTable(netip.Addr{}),
+	}
+	h.ports = parsePorts(options.TCPPorts)
+	h.udpPorts = parsePorts(options.UDPPorts)
+	for _, p := range options.UDPAllowPackages {
+		h.udpAllow[p] = true
+	}
+	for _, p := range options.AllowPackages {
+		h.allow[p] = true
+	}
+	for _, p := range options.BlockPackages {
+		h.block[p] = true
+	}
+	for _, n := range options.AllowNodes {
+		h.allowNodes[n] = true
+	}
+	return h
+}
+
+// parsePorts reads "from:to" or single ports. Ports below 1024 are never handed off: they belong to the system and to
+// Tailscale's own services.
+func parsePorts(list []string) (ports []portRange) {
+	for _, p := range list {
+		from, to, _ := strings.Cut(p, ":")
+		a, err1 := strconv.ParseUint(from, 10, 16)
+		b := a
+		var err2 error
+		if to != "" {
+			b, err2 = strconv.ParseUint(to, 10, 16)
+		}
+		if err1 == nil && err2 == nil && a >= 1024 && b >= a {
+			ports = append(ports, portRange{uint16(a), uint16(b)})
+		}
+	}
+	return
+}
+
+func inRanges(ranges []portRange, port uint16) bool {
+	for _, r := range ranges {
+		if port >= r.from && port <= r.to {
+			return true
+		}
+	}
+	return false
+}
+
+func (h *handoff) portAllowed(port uint16) bool {
+	for _, r := range h.ports {
+		if port >= r.from && port <= r.to {
+			return true
+		}
+	}
+	return false
+}
+
+// setLocal installs this node's IPv4 tailnet address (invalid: off) and the peers' own node addresses with their node,
+// read together from one snapshot. A new address starts an empty table; flows whose address left or now belongs to
+// another node are retired.
+func (h *handoff) setLocal(local netip.Addr, peers map[netip.Addr]string) {
+	h.access.Lock()
+	old := h.tab
+	if old.closed {
+		h.access.Unlock()
+		return
+	}
+	h.peers = peers
+	var retired []*handoffFlow
+	if old.local != local {
+		h.tab = newHandoffTable(local)
+		if local.IsValid() {
+			h.local.Store(&local)
+		} else {
+			h.local.Store(nil)
+		}
+		for _, f := range old.flows {
+			f.retired.Store(true)
+			retired = append(retired, f)
+		}
+	} else {
+		for _, f := range old.flows {
+			if node, ok := peers[f.key.peer.Addr()]; !ok || node != f.node {
+				h.retireLocked(old, f)
+				retired = append(retired, f)
+			}
+		}
+	}
+	h.access.Unlock()
+	for _, f := range retired {
+		h.release(f)
+	}
+}
+
+// close stops the hand-off: nothing is written any more once it returns.
+func (h *handoff) close() {
+	h.access.Lock()
+	old := h.tab
+	h.closed.Store(true)
+	h.tab = &handoffTable{closed: true, flows: map[flowKey]*handoffFlow{}, perPeer: map[netip.Addr]int{}}
+	h.local.Store(nil)
+	for _, f := range old.flows {
+		f.retired.Store(true)
+	}
+	h.access.Unlock()
+	h.gate.Lock() // the writes under way end; every later one sees closed
+	h.gate.Unlock()
+	for _, f := range old.flows {
+		h.release(f)
+	}
+	h.closeOnce.Do(func() { close(h.done) })
+}
+
+// retireLocked detaches a flow from its table; from then on nothing of it is written.
+func (h *handoff) retireLocked(tab *handoffTable, f *handoffFlow) {
+	if tab.flows[f.key] != f {
+		return
+	}
+	f.retired.Store(true)
+	delete(tab.flows, f.key)
+	if tab.perPeer[f.key.peer.Addr()]--; tab.perPeer[f.key.peer.Addr()] <= 0 {
+		delete(tab.perPeer, f.key.peer.Addr())
+	}
+}
+
+// release frees what a retired flow holds, after a delivery in progress on it.
+func (h *handoff) release(f *handoffFlow) {
+	f.mu.Lock()
+	h.dropHeldLocked(f)
+	f.mu.Unlock()
+}
+
+// write sends one packet, unless the flow (nil: none) is retired or the hand-off closed.
+func (h *handoff) write(f *handoffFlow, toSystem bool, pkt []byte) bool {
+	h.gate.RLock()
+	defer h.gate.RUnlock()
+	if h.closed.Load() || f != nil && f.retired.Load() {
+		return false
+	}
+	if toSystem {
+		return h.deps.toSystem(pkt)
+	}
+	return h.deps.toPeer(pkt)
+}
+
+// Inbound sees a packet from a peer after Tailscale's access rules; true means it was taken. It runs on the
+// receiving path of that one peer, so the listener lookup only ever holds up that peer.
+func (h *handoff) Inbound(b []byte) bool {
+	h.access.Lock()
+	tab := h.tab
+	if tab.closed || !tab.local.IsValid() {
+		h.access.Unlock()
+		return false
+	}
+	if len(b) >= 20 && b[0]>>4 == 4 && b[9] == 17 {
+		return h.inboundUDPLocked(tab, b) // unlocks
+	}
+	p, ok := parseTCP4(b)
+	if !ok {
+		return h.inboundICMPLocked(tab, b) // unlocks
+	}
+	if p.dst.Addr() != tab.local {
+		h.access.Unlock()
+		return false
+	}
+	key := flowKey{p.src, p.dst.Port(), false}
+	f := tab.flows[key]
+	opening := p.flags&(tcpSYN|tcpACK|tcpRST|tcpFIN) == tcpSYN
+	if f != nil && !(opening && p.seq != f.peerISN) {
+		h.access.Unlock()
+		pkt := append([]byte(nil), b...)
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		if !f.retired.Load() {
+			h.fromPeerLocked(f, p, pkt)
+		}
+		return true
+	}
+	if f != nil {
+		h.retireLocked(tab, f) // a new connection on the same tuple: nothing carries over
+	}
+	node, isPeer := h.peers[p.src.Addr()]
+	room := len(tab.flows) < handoffMaxFlows && tab.perPeer[p.src.Addr()] < handoffMaxPerPeer
+	h.access.Unlock()
+	if f != nil {
+		h.release(f)
+	}
+	// Anything else is the stack's, as without the hand-off: its own connections, and SYNs this can't take.
+	if !opening || p.payload != 0 || !isPeer || !room || !h.portAllowed(p.dst.Port()) {
+		return false
+	}
+	return h.open(tab, key, node, p, b)
+}
+
+// open vets a peer's SYN by the app listening on its port, then delivers it to the system under a new flow.
+func (h *handoff) open(tab *handoffTable, key flowKey, node string, p tcp4, b []byte) bool {
+	packages, found := h.lookup(false, p.dst, p.src, handoffVetWait)
+	if !found {
+		return false // no app of the VPN listens there: the stack's
+	}
+	reason := ""
+	if len(h.allowNodes) > 0 && !h.allowNodes[node] {
+		reason = "device"
+	} else if !h.allowed(packages) {
+		reason = h.refusal(packages)
+	}
+	if reason != "" {
+		h.write(nil, false, rst4(p.dst, p.src, 0, p.seq+1, true))
+		h.logger.Info("tun hand-off: refused ", p.src, " -> port ", p.dst.Port(), " (", reason, ": ", strings.Join(packages, ","), ")")
+		h.record(false, p.src, node, p.dst.Port(), packages, false, reason)
+		return true
+	}
+	now := time.Now()
+	f := &handoffFlow{key: key, node: node, local: tab.local, state: flowOpening, peerISN: p.seq, deadline: now.Add(handoffOpenWait), lastActive: now}
+	h.access.Lock()
+	if h.tab != tab || tab.flows[key] != nil || h.peers[p.src.Addr()] != node || len(tab.flows) >= handoffMaxFlows || tab.perPeer[p.src.Addr()] >= handoffMaxPerPeer {
+		h.access.Unlock()
+		return true // things changed during the lookup: dropped, the peer sends the SYN again
+	}
+	tab.flows[key] = f
+	tab.perPeer[p.src.Addr()]++
+	h.access.Unlock()
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !h.deliverSystemLocked(f, append([]byte(nil), b...)) {
+		h.closeLocked(f)
+	}
+	return true
+}
+
+func (h *handoff) fromPeerLocked(f *handoffFlow, p tcp4, pkt []byte) {
+	if p.flags&tcpSYN != 0 && f.state != flowOpening {
+		return // the handshake is over: a SYN now is stale or forged
+	}
+	switch f.state {
+	case flowAllowed:
+		f.lastActive = time.Now()
+		if p.flags&tcpRST != 0 {
+			// The system decides whether a reset is in its window; only one it surely takes closes the flow.
+			valid := p.seq == f.rx.next || f.rx.acked && p.seq == f.rx.ack
+			if h.deliverSystemLocked(f, rstOnly(pkt)) && valid {
+				h.closeLocked(f)
+			}
+			return
+		}
+		if !h.deliverSystemLocked(f, pkt) {
+			h.denyLocked(f)
+		}
+	case flowOpening:
+		switch {
+		case p.flags&tcpRST != 0:
+			h.deliverSystemLocked(f, rstOnly(pkt))
+			h.closeLocked(f)
+		case p.flags&tcpSYN != 0:
+			if p.flags&tcpACK == 0 && p.payload == 0 {
+				h.deliverSystemLocked(f, pkt) // retransmitted SYN, same ISN
+			}
+		case p.flags&tcpACK != 0 && f.haveLocalISN && p.seq == f.peerISN+1 && p.ack == f.localISN+1:
+			// The final ACK. Data on it is held; the system gets a bare ACK so its socket can be established.
+			if time.Now().After(f.deadline) {
+				h.denyLocked(f)
+				return
+			}
+			if p.payload > 0 || p.flags&(tcpFIN|tcpURG) != 0 {
+				if !checksumsValid(pkt) {
+					return // damaged: the peer sends it again
+				}
+				if !h.deliverSystemLocked(f, bareACK(pkt)) || !h.holdLocked(f, &f.in, pkt) {
+					h.denyLocked(f)
+					return
+				}
+			} else if !h.deliverSystemLocked(f, pkt) {
+				h.denyLocked(f)
+				return
+			}
+			f.state = flowChecking
+			f.deadline = time.Now().Add(handoffCheckWait)
+			go h.check(f)
+		}
+	case flowChecking:
+		switch {
+		case p.flags&tcpRST != 0:
+			h.deliverSystemLocked(f, rstOnly(pkt))
+			h.closeLocked(f)
+		case p.payload > 0 || p.flags&(tcpFIN|tcpURG) != 0:
+			h.holdLocked(f, &f.in, pkt)
+		default:
+			h.deliverSystemLocked(f, pkt)
+		}
+	}
+}
+
+// inboundUDPLocked hands a peer's UDP datagram to the system when the exchange it belongs to was allowed: the first
+// datagram of an exchange (peer address and port, local port) waits for the platform to name the app holding the
+// port. Called with access held; unlocks it.
+func (h *handoff) inboundUDPLocked(tab *handoffTable, b []byte) bool {
+	p, ok := parseUDP4(b)
+	if !ok || p.dst.Addr() != tab.local || len(h.udpAllow) == 0 || !inRanges(h.udpPorts, p.dst.Port()) {
+		h.access.Unlock()
+		return false
+	}
+	key := flowKey{p.src, p.dst.Port(), true}
+	if f := tab.flows[key]; f != nil {
+		h.access.Unlock()
+		pkt := append([]byte(nil), b...)
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		if f.state == flowAllowed && !f.retired.Load() {
+			f.lastActive = time.Now()
+			h.write(f, true, pkt)
+		}
+		return true // a refused exchange's datagrams are dropped until its tombstone ends
+	}
+	node, isPeer := h.peers[p.src.Addr()]
+	room := len(tab.flows) < handoffMaxFlows && tab.perPeer[p.src.Addr()] < handoffMaxPerPeer
+	h.access.Unlock()
+	if !isPeer || !room {
+		return false
+	}
+	return h.openUDP(tab, key, node, p, b)
+}
+
+// openUDP names the app holding the port, then starts an allowed exchange with the datagram, or a refused one.
+func (h *handoff) openUDP(tab *handoffTable, key flowKey, node string, p udp4, b []byte) bool {
+	packages, found := h.lookup(true, p.dst, p.src, handoffVetWait)
+	if !found {
+		return false // no app of the VPN holds the port: the stack's
+	}
+	reason := ""
+	if len(h.allowNodes) > 0 && !h.allowNodes[node] {
+		reason = "device"
+	} else if !h.allowedIn(h.udpAllow, packages) {
+		reason = h.refusal(packages)
+	}
+	now := time.Now()
+	f := &handoffFlow{key: key, node: node, local: tab.local, state: flowAllowed, lastActive: now, recheckAt: now.Add(handoffUDPRecheck)}
+	if reason != "" {
+		f.state, f.expires = flowDenied, now.Add(handoffUDPTombstone)
+	}
+	h.access.Lock()
+	if h.tab != tab || tab.flows[key] != nil || h.peers[p.src.Addr()] != node || len(tab.flows) >= handoffMaxFlows || tab.perPeer[p.src.Addr()] >= handoffMaxPerPeer {
+		h.access.Unlock()
+		return true // things changed during the lookup: dropped
+	}
+	tab.flows[key] = f
+	tab.perPeer[p.src.Addr()]++
+	h.access.Unlock()
+	h.record(true, p.src, node, p.dst.Port(), packages, reason == "", reason)
+	if reason != "" {
+		h.logger.Info("tun hand-off: refused udp ", p.src, " -> port ", p.dst.Port(), " (", reason, ": ", strings.Join(packages, ","), ")")
+		return true
+	}
+	h.logger.Info("tun hand-off: allowed udp ", p.src, " -> port ", p.dst.Port(), " (", strings.Join(packages, ","), ")")
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	h.write(f, true, append([]byte(nil), b...))
+	return true
+}
+
+// recheckUDP names the app holding an allowed exchange's port again: another app may hold it now.
+func (h *handoff) recheckUDP(f *handoffFlow) {
+	packages, found := h.lookup(true, netip.AddrPortFrom(f.local, f.key.port), f.key.peer, handoffCheckWait)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.rechecking = false
+	if f.retired.Load() || f.state != flowAllowed {
+		return
+	}
+	now := time.Now()
+	if !found {
+		f.recheckAt = now.Add(time.Second) // no answer yet (every lookup slot busy, or the socket closing): soon again
+		return
+	}
+	if h.allowedIn(h.udpAllow, packages) {
+		f.recheckAt = now.Add(handoffUDPRecheck)
+		return
+	}
+	reason := h.refusal(packages)
+	f.state, f.expires = flowDenied, now.Add(handoffUDPTombstone)
+	h.record(true, f.key.peer, f.node, f.key.port, packages, false, reason)
+	h.logger.Info("tun hand-off: refused udp ", f.key.peer, " -> port ", f.key.port, " (", reason, ": ", strings.Join(packages, ","), ")")
+}
+
+// inboundICMPLocked hands an ICMP error about an allowed connection to the system, which owns that connection.
+// Called with access held; unlocks it.
+func (h *handoff) inboundICMPLocked(tab *handoffTable, b []byte) bool {
+	key, ok := icmpError(b, tab.local, false, true)
+	if !ok {
+		h.access.Unlock()
+		return false
+	}
+	f := tab.flows[key]
+	h.access.Unlock()
+	if f == nil {
+		return false
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.state == flowAllowed {
+		h.write(f, true, append([]byte(nil), b...))
+	}
+	return true
+}
+
+// Intercept sees a packet the system writes into the TUN; true means it was taken (tunhandoff.Handler). Only the
+// headers are read until the packet turns out to belong to a handed-off connection.
+func (h *handoff) Intercept(source netip.Addr, packet func(n int) ([]byte, bool)) bool {
+	local := h.local.Load()
+	if local == nil || *local != source {
+		return false
+	}
+	head, ok := packet(handoffPeek)
+	if !ok {
+		return false
+	}
+	key, kind, ok := systemKey(head, *local)
+	if !ok {
+		return false
+	}
+	h.access.Lock()
+	tab := h.tab
+	if tab.closed || tab.local != *local {
+		h.access.Unlock()
+		return false
+	}
+	f := tab.flows[key]
+	if f != nil && kind == keyOpening {
+		h.retireLocked(tab, f) // the system opens a connection of its own on that tuple: the old entry has no say in it
+	}
+	h.access.Unlock()
+	if f == nil {
+		return false
+	}
+	if kind == keyOpening {
+		h.release(f)
+		return false // normal routing and policy
+	}
+	if kind == keyUDP {
+		f.mu.Lock()
+		defer f.mu.Unlock()
+		if f.state != flowAllowed || f.retired.Load() {
+			return false // not an allowed exchange: the app's own traffic, normal routing and policy
+		}
+		b, ok := packet(0)
+		if !ok {
+			return true
+		}
+		f.lastActive = time.Now()
+		h.write(f, false, append([]byte(nil), b...))
+		return true
+	}
+	b, ok := packet(0)
+	if !ok {
+		return true
+	}
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if kind == keyICMP {
+		// An error the system sends about an allowed connection goes to the peer; any other is dropped.
+		if k, ok := icmpError(b, *local, true, true); ok && k == key && f.state == flowAllowed {
+			h.write(f, false, append([]byte(nil), b...))
+		}
+		return true
+	}
+	p, ok := parseTCP4(b)
+	if !ok || f.retired.Load() {
+		return true
+	}
+	pkt := append([]byte(nil), b...)
+	switch f.state {
+	case flowOpening:
+		switch {
+		case p.flags&(tcpSYN|tcpACK|tcpRST|tcpFIN) == tcpSYN|tcpACK && p.ack == f.peerISN+1 && p.payload == 0 && (!f.haveLocalISN || p.seq == f.localISN):
+			f.localISN, f.haveLocalISN = p.seq, true
+			if !h.deliverPeerLocked(f, pkt) {
+				h.denyLocked(f)
+			}
+		case p.flags&tcpRST != 0:
+			h.deliverPeerLocked(f, rstOnly(pkt))
+			h.closeLocked(f)
+		}
+	case flowChecking:
+		switch {
+		case p.flags&tcpRST != 0:
+			h.deliverPeerLocked(f, rstOnly(pkt))
+			h.closeLocked(f)
+		case p.flags&tcpSYN != 0:
+		case p.payload > 0 || p.flags&(tcpFIN|tcpURG) != 0:
+			h.holdLocked(f, &f.out, pkt)
+		default:
+			if !h.deliverPeerLocked(f, pkt) {
+				h.denyLocked(f)
+			}
+		}
+	case flowAllowed:
+		switch {
+		case p.flags&tcpRST != 0:
+			h.deliverPeerLocked(f, rstOnly(pkt))
+			h.closeLocked(f)
+		case p.flags&tcpSYN != 0:
+		default:
+			f.lastActive = time.Now()
+			if !h.deliverPeerLocked(f, pkt) {
+				h.denyLocked(f)
+			}
+		}
+	}
+	return true
+}
+
+// deliverSystemLocked writes a peer's segment into the TUN and tracks both streams.
+func (h *handoff) deliverSystemLocked(f *handoffFlow, pkt []byte) bool {
+	p, ok := parseTCP4(pkt)
+	if !ok || !h.write(f, true, pkt) {
+		return false
+	}
+	f.rx.sent(p)
+	if p.flags&tcpACK != 0 {
+		f.tx.acknowledged(p.ack)
+	}
+	h.endLocked(f)
+	return true
+}
+
+// deliverPeerLocked sends a system's segment to the peer and tracks both streams.
+func (h *handoff) deliverPeerLocked(f *handoffFlow, pkt []byte) bool {
+	p, ok := parseTCP4(pkt)
+	if !ok || !h.write(f, false, pkt) {
+		return false
+	}
+	f.tx.sent(p)
+	if p.flags&tcpACK != 0 {
+		f.rx.acknowledged(p.ack)
+	}
+	h.endLocked(f)
+	return true
+}
+
+// endLocked: once both ends sent a FIN and both FINs are acknowledged, the flow is forwarded a while longer, for
+// the retransmissions of a closing connection, then removed.
+func (h *handoff) endLocked(f *handoffFlow) {
+	if f.state == flowAllowed && !f.ending && f.rx.done() && f.tx.done() {
+		f.ending = true
+		f.expires = time.Now().Add(handoffTombstone)
+	}
+}
+
+// holdLocked queues a packet while the check runs; past the limits the flow is refused.
+func (h *handoff) holdLocked(f *handoffFlow, q *[][]byte, pkt []byte) bool {
+	cost := len(pkt) + handoffHeldCost
+	if f.held+cost > handoffMaxHeldFlow {
+		h.denyLocked(f)
+		return false
+	}
+	if h.heldTotal.Add(int64(cost)) > handoffMaxHeldTotal {
+		h.heldTotal.Add(-int64(cost))
+		h.denyLocked(f)
+		return false
+	}
+	f.held += cost
+	*q = append(*q, pkt)
+	return true
+}
+
+func (h *handoff) dropHeldLocked(f *handoffFlow) {
+	h.heldTotal.Add(-int64(f.held))
+	f.in, f.out, f.held = nil, nil, 0
+}
+
+func (h *handoff) closeLocked(f *handoffFlow) {
+	h.dropHeldLocked(f)
+	f.state = flowClosing
+	f.expires = time.Now().Add(handoffTombstone)
+}
+
+// denyLocked drops what is held, resets both ends where each will take it, and keeps a tombstone.
+func (h *handoff) denyLocked(f *handoffFlow) {
+	if f.state == flowDenied || f.state == flowClosing {
+		return
+	}
+	h.dropHeldLocked(f)
+	f.state = flowDenied
+	f.expires = time.Now().Add(handoffTombstone)
+	me := netip.AddrPortFrom(f.local, f.key.port)
+	for _, seq := range f.rx.resetAt() {
+		h.write(f, true, rst4(f.key.peer, me, seq, 0, false))
+	}
+	for _, seq := range f.tx.resetAt() {
+		h.write(f, false, rst4(me, f.key.peer, seq, f.rx.next, f.rx.started))
+	}
+}
+
+// lookup asks the platform which packages hold local's socket for peer: its listener before the handshake, the
+// connection after it. The call can't be cancelled, so it runs on its own, under the process-wide limit, and its
+// answer is awaited at most wait; found is false without an answer naming a package.
+func (h *handoff) lookup(udp bool, local, peer netip.AddrPort, wait time.Duration) (packages []string, found bool) {
+	select {
+	case handoffCalls <- struct{}{}:
+	default:
+		return nil, false
+	}
+	result := make(chan []string, 1)
+	go func() {
+		defer func() { <-handoffCalls }()
+		packages, err := h.deps.owner(udp, local, peer)
+		if err != nil {
+			packages = nil
+		}
+		result <- packages
+	}()
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+	select {
+	case packages = <-result:
+		return packages, len(packages) > 0
+	case <-timer.C:
+	case <-h.done:
+	}
+	return nil, false
+}
+
+// check names the app holding an established connection, then lets it through or refuses it, by its deadline.
+func (h *handoff) check(f *handoffFlow) {
+	f.mu.Lock()
+	deadline := f.deadline
+	f.mu.Unlock()
+	local := netip.AddrPortFrom(f.local, f.key.port)
+	for !f.retired.Load() {
+		wait := time.Until(deadline)
+		if wait <= 0 {
+			h.decide(f, nil)
+			return
+		}
+		if packages, found := h.lookup(false, local, f.key.peer, wait); found {
+			h.decide(f, packages)
+			return
+		}
+		select { // not found yet: the socket may still be appearing, or every slot is taken
+		case <-time.After(50 * time.Millisecond):
+		case <-h.done:
+			return
+		}
+	}
+}
+
+// allowed: every package of the user id is chosen and none is blocked.
+func (h *handoff) allowed(packages []string) bool { return h.allowedIn(h.allow, packages) }
+
+// allowedIn: every package of the user id is in allow and none is blocked.
+func (h *handoff) allowedIn(allow map[string]bool, packages []string) bool {
+	if len(packages) == 0 {
+		return false
+	}
+	for _, name := range packages {
+		if h.block[name] || !allow[name] {
+			return false
+		}
+	}
+	return true
+}
+
+func (h *handoff) decide(f *handoffFlow, packages []string) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.retired.Load() || f.state != flowChecking {
+		return // a result for a flow that is gone never applies to its successor
+	}
+	if !h.allowed(packages) || time.Now().After(f.deadline) {
+		h.denyLocked(f)
+		h.logger.Info("tun hand-off: refused ", f.key.peer, " -> port ", f.key.port, " (", strings.Join(packages, ","), ")")
+		reason := h.refusal(packages)
+		if len(packages) == 0 {
+			reason = "unknown"
+		}
+		h.record(f.key.udp, f.key.peer, f.node, f.key.port, packages, false, reason)
+		return
+	}
+	f.state = flowAllowed
+	f.lastActive = time.Now()
+	for _, pkt := range f.in {
+		if !h.deliverSystemLocked(f, pkt) {
+			h.denyLocked(f)
+			return
+		}
+	}
+	for _, pkt := range f.out {
+		if !h.deliverPeerLocked(f, pkt) {
+			h.denyLocked(f)
+			return
+		}
+	}
+	h.dropHeldLocked(f)
+	h.logger.Info("tun hand-off: allowed ", f.key.peer, " -> port ", f.key.port, " (", strings.Join(packages, ","), ")")
+	h.record(f.key.udp, f.key.peer, f.node, f.key.port, packages, true, "")
+}
+
+// refusal says why packages that aren't allowed are refused: "blocked" when one of them is on Block, else "app".
+func (h *handoff) refusal(packages []string) string {
+	for _, name := range packages {
+		if h.block[name] {
+			return "blocked"
+		}
+	}
+	return "app"
+}
+
+// record keeps a decision for the app to show (tunhandoff.Event): in memory only.
+func (h *handoff) record(udp bool, peer netip.AddrPort, node string, port uint16, packages []string, allowed bool, reason string) {
+	proto := "tcp"
+	if udp {
+		proto = "udp"
+	}
+	tunhandoff.Record(tunhandoff.Event{
+		Time: time.Now().UnixMilli(), Peer: peer.Addr().String(), Node: node, Port: port, Proto: proto,
+		Packages: append([]string(nil), packages...), Allowed: allowed, Reason: reason,
+	})
+}
+
+// sweep enforces deadlines and removes dead flows.
+func (h *handoff) sweep() {
+	t := time.NewTicker(time.Second)
+	defer t.Stop()
+	for {
+		select {
+		case <-h.done:
+			return
+		case now := <-t.C:
+			h.sweepOnce(now)
+		}
+	}
+}
+
+func (h *handoff) sweepOnce(now time.Time) {
+	h.access.Lock()
+	tab := h.tab
+	flows := make([]*handoffFlow, 0, len(tab.flows))
+	for _, f := range tab.flows {
+		flows = append(flows, f)
+	}
+	h.access.Unlock()
+	var dead []*handoffFlow
+	for _, f := range flows {
+		if !f.mu.TryLock() {
+			continue // busy delivering: next round, so one slow flow holds up no other
+		}
+		if !f.retired.Load() {
+			switch f.state {
+			case flowOpening, flowChecking:
+				if now.After(f.deadline) {
+					h.denyLocked(f)
+				}
+			case flowAllowed:
+				if f.key.udp {
+					if now.Sub(f.lastActive) > handoffUDPIdle {
+						dead = append(dead, f)
+					} else if now.After(f.recheckAt) && !f.rechecking {
+						f.rechecking = true
+						go h.recheckUDP(f)
+					}
+				} else if f.ending && now.After(f.expires) {
+					dead = append(dead, f)
+				} else if now.Sub(f.lastActive) > handoffIdle {
+					h.denyLocked(f) // closed on purpose rather than left half-known
+				}
+			case flowClosing, flowDenied:
+				if now.After(f.expires) {
+					dead = append(dead, f)
+				}
+			}
+		}
+		f.mu.Unlock()
+	}
+	if len(dead) > 0 {
+		h.access.Lock()
+		for _, f := range dead {
+			h.retireLocked(tab, f)
+		}
+		h.access.Unlock()
+	}
+}
+
+func seqAfter(a, b uint32) bool { return int32(a-b) > 0 }
+
+// tcp4 is the part of an IPv4 TCP packet the hand-off needs.
+type tcp4 struct {
+	src, dst netip.AddrPort
+	seq, ack uint32
+	flags    uint8
+	payload  int
+}
+
+func parseTCP4(b []byte) (tcp4, bool) {
+	if len(b) < 20 || b[0]>>4 != 4 || b[9] != 6 {
+		return tcp4{}, false
+	}
+	ihl := int(b[0]&0x0f) * 4
+	total := int(binary.BigEndian.Uint16(b[2:4]))
+	if ihl < 20 || total > len(b) || total < ihl+20 || binary.BigEndian.Uint16(b[6:8])&0x3fff != 0 {
+		return tcp4{}, false // fragments are not handed off
+	}
+	t := b[ihl:total]
+	off := int(t[12]>>4) * 4
+	if off < 20 || off > len(t) {
+		return tcp4{}, false
+	}
+	return tcp4{
+		src:     netip.AddrPortFrom(netip.AddrFrom4([4]byte(b[12:16])), binary.BigEndian.Uint16(t[0:2])),
+		dst:     netip.AddrPortFrom(netip.AddrFrom4([4]byte(b[16:20])), binary.BigEndian.Uint16(t[2:4])),
+		seq:     binary.BigEndian.Uint32(t[4:8]),
+		ack:     binary.BigEndian.Uint32(t[8:12]),
+		flags:   t[13],
+		payload: len(t) - off,
+	}, true
+}
+
+// udp4 is the part of an IPv4 UDP datagram the hand-off needs.
+type udp4 struct{ src, dst netip.AddrPort }
+
+func parseUDP4(b []byte) (udp4, bool) {
+	if len(b) < 28 || b[0]>>4 != 4 || b[9] != 17 {
+		return udp4{}, false
+	}
+	ihl := int(b[0]&0x0f) * 4
+	total := int(binary.BigEndian.Uint16(b[2:4]))
+	if ihl < 20 || total > len(b) || total < ihl+8 || binary.BigEndian.Uint16(b[6:8])&0x3fff != 0 {
+		return udp4{}, false // fragments are not handed off
+	}
+	u := b[ihl:total]
+	if n := int(binary.BigEndian.Uint16(u[4:6])); n < 8 || n > len(u) {
+		return udp4{}, false
+	}
+	return udp4{
+		src: netip.AddrPortFrom(netip.AddrFrom4([4]byte(b[12:16])), binary.BigEndian.Uint16(u[0:2])),
+		dst: netip.AddrPortFrom(netip.AddrFrom4([4]byte(b[16:20])), binary.BigEndian.Uint16(u[2:4])),
+	}, true
+}
+
+// next is the sequence number that follows this segment.
+func (p tcp4) next() uint32 {
+	n := p.seq + uint32(p.payload)
+	if p.flags&tcpSYN != 0 {
+		n++
+	}
+	if p.flags&tcpFIN != 0 {
+		n++
+	}
+	return n
+}
+
+const (
+	keyTCP     = iota // a segment of a connection
+	keyOpening        // the system opening a connection of its own
+	keyICMP           // an ICMP error about a connection
+	keyUDP            // a datagram of a UDP exchange
+)
+
+// systemKey finds the hand-off tuple of a packet from the system by its headers alone: a TCP segment from local, or
+// an ICMPv4 error from local about a segment a peer sent to local.
+func systemKey(b []byte, local netip.Addr) (key flowKey, kind int, ok bool) {
+	if len(b) < 20 || b[0]>>4 != 4 || binary.BigEndian.Uint16(b[6:8])&0x3fff != 0 || netip.AddrFrom4([4]byte(b[12:16])) != local {
+		return flowKey{}, 0, false
+	}
+	ihl := int(b[0]&0x0f) * 4
+	if ihl < 20 {
+		return flowKey{}, 0, false
+	}
+	switch b[9] {
+	case 6:
+		if len(b) < ihl+14 {
+			return flowKey{}, 0, false
+		}
+		kind = keyTCP
+		if b[ihl+13]&(tcpSYN|tcpACK) == tcpSYN {
+			kind = keyOpening
+		}
+		t := b[ihl:]
+		peer := netip.AddrPortFrom(netip.AddrFrom4([4]byte(b[16:20])), binary.BigEndian.Uint16(t[2:4]))
+		return flowKey{peer, binary.BigEndian.Uint16(t[0:2]), false}, kind, true
+	case 1:
+		key, ok := icmpError(b, local, true, false)
+		return key, keyICMP, ok
+	case 17:
+		if len(b) < ihl+4 {
+			return flowKey{}, 0, false
+		}
+		t := b[ihl:]
+		peer := netip.AddrPortFrom(netip.AddrFrom4([4]byte(b[16:20])), binary.BigEndian.Uint16(t[2:4]))
+		return flowKey{peer, binary.BigEndian.Uint16(t[0:2]), true}, keyUDP, true
+	}
+	return flowKey{}, 0, false
+}
+
+// icmpError finds the hand-off tuple an ICMPv4 error (destination unreachable, time exceeded) is about: one local
+// sends to the peer whose segment it quotes (fromLocal), or one arriving for local about a segment local sent. whole:
+// b is the complete packet, checked against its length; otherwise only its headers.
+func icmpError(b []byte, local netip.Addr, fromLocal, whole bool) (flowKey, bool) {
+	if len(b) < 20 || b[0]>>4 != 4 || b[9] != 1 || binary.BigEndian.Uint16(b[6:8])&0x3fff != 0 {
+		return flowKey{}, false
+	}
+	ihl := int(b[0]&0x0f) * 4
+	if whole {
+		total := int(binary.BigEndian.Uint16(b[2:4]))
+		if total > len(b) {
+			return flowKey{}, false
+		}
+		b = b[:total]
+	}
+	if ihl < 20 || len(b) < ihl+8+20+8 || (b[ihl] != 3 && b[ihl] != 11) {
+		return flowKey{}, false
+	}
+	in := b[ihl+8:]
+	inIHL := int(in[0]&0x0f) * 4
+	if in[0]>>4 != 4 || in[9] != 6 || inIHL < 20 || len(in) < inIHL+8 || binary.BigEndian.Uint16(in[6:8])&0x1fff != 0 {
+		return flowKey{}, false // the quote must hold the start of a TCP segment
+	}
+	outerSrc, outerDst := netip.AddrFrom4([4]byte(b[12:16])), netip.AddrFrom4([4]byte(b[16:20]))
+	inSrc, inDst := netip.AddrFrom4([4]byte(in[12:16])), netip.AddrFrom4([4]byte(in[16:20]))
+	inSport, inDport := binary.BigEndian.Uint16(in[inIHL:inIHL+2]), binary.BigEndian.Uint16(in[inIHL+2:inIHL+4])
+	if fromLocal {
+		if outerSrc != local || inDst != local || outerDst != inSrc {
+			return flowKey{}, false
+		}
+		return flowKey{netip.AddrPortFrom(inSrc, inSport), inDport, false}, true
+	}
+	if outerDst != local || inSrc != local {
+		return flowKey{}, false
+	}
+	return flowKey{netip.AddrPortFrom(inDst, inDport), inSport, false}, true
+}
+
+// bareACK is the packet's headers alone, without data, FIN or urgent data, checksums recomputed.
+func bareACK(pkt []byte) []byte {
+	ihl := int(pkt[0]&0x0f) * 4
+	off := int(pkt[ihl+12]>>4) * 4
+	b := append([]byte(nil), pkt[:ihl+off]...)
+	binary.BigEndian.PutUint16(b[2:4], uint16(ihl+off))
+	b[ihl+13] &^= tcpFIN | tcpPSH | tcpURG
+	b[ihl+18], b[ihl+19] = 0, 0
+	fixChecksums(b, ihl)
+	return b
+}
+
+// rstOnly keeps a reset's headers and drops any data on it.
+func rstOnly(pkt []byte) []byte {
+	ihl := int(pkt[0]&0x0f) * 4
+	off := int(pkt[ihl+12]>>4) * 4
+	if len(pkt) == ihl+off {
+		return pkt
+	}
+	b := append([]byte(nil), pkt[:ihl+off]...)
+	binary.BigEndian.PutUint16(b[2:4], uint16(ihl+off))
+	fixChecksums(b, ihl)
+	return b
+}
+
+// rst4 builds an IPv4 TCP RST from src to dst; withACK also acknowledges ack.
+func rst4(src, dst netip.AddrPort, seq, ack uint32, withACK bool) []byte {
+	b := make([]byte, 40)
+	b[0], b[8], b[9] = 0x45, 64, 6
+	binary.BigEndian.PutUint16(b[2:4], 40)
+	s4, d4 := src.Addr().As4(), dst.Addr().As4()
+	copy(b[12:16], s4[:])
+	copy(b[16:20], d4[:])
+	t := b[20:]
+	binary.BigEndian.PutUint16(t[0:2], src.Port())
+	binary.BigEndian.PutUint16(t[2:4], dst.Port())
+	binary.BigEndian.PutUint32(t[4:8], seq)
+	t[12], t[13] = 5<<4, tcpRST
+	if withACK {
+		binary.BigEndian.PutUint32(t[8:12], ack)
+		t[13] |= tcpACK
+	}
+	fixChecksums(b, 20)
+	return b
+}
+
+// pseudoSum is the TCP pseudo-header's sum for the IPv4 packet b.
+func pseudoSum(b []byte, ihl int) uint32 {
+	sum := uint32(6) + uint32(len(b)-ihl)
+	for i := 12; i < 20; i += 2 {
+		sum += uint32(binary.BigEndian.Uint16(b[i:]))
+	}
+	return sum
+}
+
+func fixChecksums(b []byte, ihl int) {
+	b[10], b[11] = 0, 0
+	binary.BigEndian.PutUint16(b[10:12], checksum(b[:ihl], 0))
+	t := b[ihl:]
+	t[16], t[17] = 0, 0
+	binary.BigEndian.PutUint16(t[16:18], checksum(t, pseudoSum(b, ihl)))
+}
+
+// checksumsValid: the IPv4 header and TCP checksums of a packet parseTCP4 took are right.
+func checksumsValid(b []byte) bool {
+	ihl := int(b[0]&0x0f) * 4
+	b = b[:binary.BigEndian.Uint16(b[2:4])]
+	return checksum(b[:ihl], 0) == 0 && checksum(b[ihl:], pseudoSum(b, ihl)) == 0
+}
+
+func checksum(b []byte, sum uint32) uint16 {
+	for i := 0; i+1 < len(b); i += 2 {
+		sum += uint32(binary.BigEndian.Uint16(b[i:]))
+	}
+	if len(b)%2 == 1 {
+		sum += uint32(b[len(b)-1]) << 8
+	}
+	for sum>>16 != 0 {
+		sum = sum&0xffff + sum>>16
+	}
+	return ^uint16(sum)
+}
