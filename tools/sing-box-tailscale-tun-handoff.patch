+func TestHandoffNewConnectionOnSameTupleStartsOver(t *testing.T) {
+	w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	handshake(t, h, nil)
+	waitState(t, h, flowAllowed)
+	// A new SYN (new ISN) on the same tuple must not inherit the approval.
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 90000, 0, tcpSYN, nil))
+	waitState(t, h, flowOpening)
+	before := payloadTo(func() []tcp4 { s, _ := w.seen(); return s }())
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 90001, 7, tcpACK|tcpPSH, []byte("sneak")))
+	if s, _ := w.seen(); payloadTo(s) != before {
+		t.Fatal("data passed on a reused tuple before any check")
+	}
+}
