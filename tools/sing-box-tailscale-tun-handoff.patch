+func TestHandoffUDPRecheckAndIdle(t *testing.T) {
+	owner := []string{"st"}
+	var mu sync.Mutex
+	w := &hoWorld{listener: []string{"st"}, owner: func() ([]string, error) { mu.Lock(); defer mu.Unlock(); return owner, nil }}
+	h := newUDPHandoff(t, w, []string{"st"})
+	h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("x")))
+	key := flowKey{hoPeerEnd, 21027, true}
+	h.access.Lock()
+	f := h.tab.flows[key]
+	h.access.Unlock()
+	// Another app holds the port now: the next check refuses the exchange.
+	mu.Lock()
+	owner = []string{"other"}
+	mu.Unlock()
+	h.recheckUDP(f)
+	if s := stateOf(f); s != flowDenied {
+		t.Fatalf("exchange still %d after its port changed hands", s)
+	}
+	before := w.systemCount()
+	h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("late")))
+	if w.systemCount() != before {
+		t.Fatal("datagram delivered after the refusal")
+	}
+	// A refused exchange ends after its tombstone; an allowed one when idle.
+	h.sweepOnce(time.Now().Add(handoffUDPTombstone + time.Second))
+	h.access.Lock()
+	gone := h.tab.flows[key] == nil
+	h.access.Unlock()
+	if !gone {
+		t.Fatal("refused exchange not removed")
+	}
+	mu.Lock()
+	owner = []string{"st"}
+	mu.Unlock()
+	h.Inbound(udpPacket(hoPeerEnd, hoUDPLocal, []byte("new")))
+	h.sweepOnce(time.Now().Add(handoffUDPIdle + time.Second))
+	h.access.Lock()
+	gone = h.tab.flows[key] == nil
+	h.access.Unlock()
+	if !gone {
+		t.Fatal("idle exchange not removed")
+	}
+}
