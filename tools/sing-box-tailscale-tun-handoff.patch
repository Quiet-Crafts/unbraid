+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"encoding/binary"
+	"errors"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+)
+
+var (
+	hoLocal = netip.MustParseAddr("100.64.0.5")
+	hoPeer  = netip.MustParseAddr("100.64.0.6")
+)
+
+// hoWorld stands in for the TUN, Tailscale and the platform. A lookup made before the flow exists is the listener
+// check, answered by listener; one made after it is the connection check, answered by owner.
+type hoWorld struct {
+	mu         sync.Mutex
+	h          *handoff
+	system     [][]byte
+	peer       [][]byte
+	listener   []string
+	noListener bool
+	owner      func() ([]string, error)
+	writeErr   bool
+}
+
+func (w *hoWorld) deps() handoffDeps {
+	return handoffDeps{
+		owner: func(local, peer netip.AddrPort) ([]string, error) {
+			w.h.access.Lock()
+			f := w.h.tab.flows[flowKey{peer, local.Port()}]
+			w.h.access.Unlock()
+			if f == nil {
+				if w.noListener {
+					return nil, errors.New("no socket")
+				}
+				return w.listener, nil
+			}
+			return w.owner()
+		},
+		toPeer: func(p []byte) bool {
+			w.mu.Lock()
+			w.peer = append(w.peer, p)
+			w.mu.Unlock()
+			return true
+		},
+		toSystem: func(p []byte) bool {
+			w.mu.Lock()
+			defer w.mu.Unlock()
+			if w.writeErr {
+				return false
+			}
+			w.system = append(w.system, p)
+			return true
+		},
+	}
+}
+
+func (w *hoWorld) seen() (system, peer []tcp4) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	for _, b := range w.system {
+		p, _ := parseTCP4(b)
+		system = append(system, p)
+	}
+	for _, b := range w.peer {
+		p, _ := parseTCP4(b)
+		peer = append(peer, p)
+	}
+	return
+}
+
+func (w *hoWorld) counts() (system, peer int) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	return len(w.system), len(w.peer)
+}
+
+func newTestHandoff(t *testing.T, w *hoWorld, allow, block []string) *handoff {
+	h := newHandoff(log.NewNOPFactory().NewLogger(""), &option.TailscaleTUNHandoffOptions{
+		TCPPorts: []string{"1714:1764", "22"}, AllowPackages: allow, BlockPackages: block,
+	}, w.deps())
+	w.h = h
+	if w.listener == nil {
+		w.listener = allow
+	}
+	h.setLocal(hoLocal, map[netip.Addr]string{hoPeer: "n1"})
+	t.Cleanup(h.close)
+	return h
+}
+
+func tcpPacket(src, dst netip.AddrPort, seq, ack uint32, flags uint8, payload []byte) []byte {
+	b := make([]byte, 40+len(payload))
+	b[0], b[8], b[9] = 0x45, 64, 6
+	binary.BigEndian.PutUint16(b[2:4], uint16(len(b)))
+	s, d := src.Addr().As4(), dst.Addr().As4()
+	copy(b[12:16], s[:])
+	copy(b[16:20], d[:])
+	tcp := b[20:]
+	binary.BigEndian.PutUint16(tcp[0:2], src.Port())
+	binary.BigEndian.PutUint16(tcp[2:4], dst.Port())
+	binary.BigEndian.PutUint32(tcp[4:8], seq)
+	binary.BigEndian.PutUint32(tcp[8:12], ack)
+	tcp[12], tcp[13] = 5<<4, flags
+	copy(tcp[20:], payload)
+	fixChecksums(b, 20)
+	return b
+}
+
+func fromSystem(h *handoff, b []byte) bool {
+	return h.Intercept(hoLocal, pullOf(b, nil))
+}
+
+// pullOf hands out b as the TUN does; full counts the calls for the whole packet.
+func pullOf(b []byte, full *int) func(int) ([]byte, bool) {
+	return func(n int) ([]byte, bool) {
+		if n <= 0 || n > len(b) {
+			if full != nil {
+				*full++
+			}
+			return b, true
+		}
+		return b[:n], true
+	}
+}
+
+var (
+	hoPeerEnd  = netip.AddrPortFrom(hoPeer, 40000)
+	hoLocalEnd = netip.AddrPortFrom(hoLocal, 1716)
+)
+
+// handshake opens a flow: SYN, SYN-ACK, final ACK (with data on it).
+func handshake(t *testing.T, h *handoff, data []byte) {
+	t.Helper()
+	if !h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil)) {
+		t.Fatal("SYN not taken")
+	}
+	if !fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK, nil)) {
+		t.Fatal("SYN-ACK not taken")
+	}
+	if !h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK|tcpPSH, data)) {
+		t.Fatal("final ACK not taken")
+	}
+}
+
+func flowOf(h *handoff, peer netip.AddrPort) *handoffFlow {
+	h.access.Lock()
+	defer h.access.Unlock()
+	return h.tab.flows[flowKey{peer, 1716}]
+}
+
+func stateOf(f *handoffFlow) handoffState {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.state
+}
+
+func waitState(t *testing.T, h *handoff, want handoffState) {
+	t.Helper()
+	deadline := time.Now().Add(handoffCheckWait + 2*time.Second) // a refusal may come at the check's own deadline
+	for time.Now().Before(deadline) {
+		if f := flowOf(h, hoPeerEnd); f != nil && stateOf(f) == want {
+			return
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	t.Fatalf("flow never reached state %d", want)
+}
+
+func payloadTo(ps []tcp4) int {
+	n := 0
+	for _, p := range ps {
+		n += p.payload
+	}
+	return n
+}
+
+func TestHandoffAllowsChosenApp(t *testing.T) {
+	w := &hoWorld{owner: func() ([]string, error) { return []string{"org.kde.kdeconnect_tp"}, nil }}
+	h := newTestHandoff(t, w, []string{"org.kde.kdeconnect_tp"}, nil)
+	handshake(t, h, []byte("hello"))
+	waitState(t, h, flowAllowed)
+	system, peer := w.seen()
+	if len(system) != 3 || payloadTo(system) != 5 || len(peer) != 1 || peer[0].flags != tcpSYN|tcpACK {
+		t.Fatalf("system %d packets, payload %d, peer %d", len(system), payloadTo(system), len(peer))
+	}
+	if system[1].payload != 0 || system[2].payload != 5 {
+		t.Fatal("data was not held behind a bare ACK")
+	}
+	fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5001, 1006, tcpACK|tcpPSH, []byte("hi")))
+	if _, peer = w.seen(); payloadTo(peer) != 2 {
+		t.Fatal("reply not sent to the peer")
+	}
+}
+
+func TestHandoffListenerCheck(t *testing.T) {
+	t.Run("unchosen app never sees the SYN", func(t *testing.T) {
+		w := &hoWorld{listener: []string{"com.other"}, owner: func() ([]string, error) { return []string{"a"}, nil }}
+		h := newTestHandoff(t, w, []string{"a"}, nil)
+		if !h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil)) {
+			t.Fatal("refused SYN left to the stack")
+		}
+		system, peer := w.seen()
+		if len(system) != 0 || len(peer) != 1 || peer[0].flags != tcpRST|tcpACK || peer[0].ack != 1001 {
+			t.Fatalf("system %d, peer %+v", len(system), peer)
+		}
+		if flowOf(h, hoPeerEnd) != nil {
+			t.Fatal("a refused SYN left a flow")
+		}
+	})
+	t.Run("blocked app never sees the SYN", func(t *testing.T) {
+		w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+		h := newTestHandoff(t, w, []string{"a"}, []string{"a"})
+		h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil))
+		if s, _ := w.counts(); s != 0 {
+			t.Fatal("SYN reached the system")
+		}
+	})
+	t.Run("no app listening: the stack's", func(t *testing.T) {
+		w := &hoWorld{noListener: true, owner: func() ([]string, error) { return []string{"a"}, nil }}
+		h := newTestHandoff(t, w, []string{"a"}, nil)
+		if h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil)) {
+			t.Fatal("took a port no app listens on")
+		}
+	})
+}
+
+func TestHandoffRefusesOthersAndBlock(t *testing.T) {
+	for name, tc := range map[string]struct {
+		owner []string
+		err   error
+		block []string
+	}{
+		"not chosen":    {owner: []string{"com.other"}},
+		"shared uid":    {owner: []string{"org.kde.kdeconnect_tp", "com.other"}},
+		"blocked":       {owner: []string{"org.kde.kdeconnect_tp"}, block: []string{"org.kde.kdeconnect_tp"}},
+		"unknown owner": {err: errors.New("owner not found")},
+	} {
+		t.Run(name, func(t *testing.T) {
+			w := &hoWorld{owner: func() ([]string, error) { return tc.owner, tc.err }}
+			h := newTestHandoff(t, w, []string{"org.kde.kdeconnect_tp"}, nil)
+			h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil))
+			for _, b := range tc.block { // blocked after the listener check: the connection check meets it
+				h.block[b] = true
+			}
+			fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK, nil))
+			h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK|tcpPSH, []byte("secret")))
+			fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5001, 1001, tcpACK|tcpPSH, []byte("banner")))
+			waitState(t, h, flowDenied)
+			system, peer := w.seen()
+			if payloadTo(system) != 0 || payloadTo(peer) != 0 {
+				t.Fatal("payload passed a refused connection")
+			}
+			if last := system[len(system)-1]; last.flags != tcpRST || last.seq != 1001 {
+				t.Fatalf("system reset %x seq %d, want RST at 1001", last.flags, last.seq)
+			}
+			if p := peer[len(peer)-1]; p.flags != tcpRST|tcpACK || p.seq != 5001 {
+				t.Fatalf("peer reset %x seq %d, want RST at 5001", p.flags, p.seq)
+			}
+			h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1007, 5001, tcpACK|tcpPSH, []byte("more")))
+			if system, _ = w.seen(); payloadTo(system) != 0 {
+				t.Fatal("payload after refusal")
+			}
+		})
+	}
+}
+
+func TestHandoffStuckLookupRefusesAtTheDeadline(t *testing.T) {
+	stuck := make(chan struct{})
+	defer close(stuck)
+	w := &hoWorld{owner: func() ([]string, error) { <-stuck; return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	start := time.Now()
+	handshake(t, h, []byte("x"))
+	waitState(t, h, flowDenied)
+	if d := time.Since(start); d > handoffCheckWait+time.Second {
+		t.Fatalf("refused after %s, past the deadline", d)
+	}
+	// Every slot of the process taken: a new connection is not handed off at all.
+	filled := 0
+	for full := false; !full; {
+		select {
+		case handoffCalls <- struct{}{}:
+			filled++
+		default:
+			full = true
+		}
+	}
+	defer func() {
+		for ; filled > 0; filled-- {
+			<-handoffCalls
+		}
+	}()
+	if h.Inbound(tcpPacket(netip.AddrPortFrom(hoPeer, 40001), hoLocalEnd, 1, 0, tcpSYN, nil)) {
+		t.Fatal("handed off without a listener check")
+	}
+}
+
+func TestHandoffCleanCloseLingers(t *testing.T) {
+	w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	handshake(t, h, []byte("bye")) // 1001..1004
+	waitState(t, h, flowAllowed)
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1004, 5001, tcpACK|tcpFIN, nil))     // peer FIN: 1004..1005
+	fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5001, 1005, tcpACK|tcpFIN, nil)) // system ACK + FIN: 5001..5002
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1005, 5002, tcpACK, nil))            // last ACK
+	f := flowOf(h, hoPeerEnd)
+	f.mu.Lock()
+	ending, state := f.ending, f.state
+	f.mu.Unlock()
+	if !ending || state != flowAllowed {
+		t.Fatalf("ending %v state %d", ending, state)
+	}
+	// A retransmitted FIN still reaches the system, so it can answer it.
+	before, _ := w.counts()
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1004, 5002, tcpACK|tcpFIN, nil))
+	if after, _ := w.counts(); after != before+1 {
+		t.Fatal("teardown retransmission dropped")
+	}
+	h.sweepOnce(time.Now().Add(handoffTombstone + time.Second))
+	if flowOf(h, hoPeerEnd) != nil {
+		t.Fatal("closed flow not removed")
+	}
+}
+
+func TestHandoffHeldFINIsTracked(t *testing.T) {
+	release := make(chan struct{})
+	w := &hoWorld{owner: func() ([]string, error) { <-release; return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	handshake(t, h, []byte("ab"))
+	waitState(t, h, flowChecking)
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1003, 5001, tcpACK|tcpFIN, nil))
+	close(release)
+	waitState(t, h, flowAllowed)
+	f := flowOf(h, hoPeerEnd)
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if !f.rx.fin || f.rx.finEnd != 1004 {
+		t.Fatalf("held FIN not tracked: %+v", f.rx)
+	}
+}
+
+func TestHandoffResetOutsideWindowKeepsFlow(t *testing.T) {
+	w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	handshake(t, h, nil)
+	waitState(t, h, flowAllowed)
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 99999, 0, tcpRST, nil))
+	if s := stateOf(flowOf(h, hoPeerEnd)); s != flowAllowed {
+		t.Fatalf("an out-of-window reset closed the flow: %d", s)
+	}
+	h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 0, tcpRST, nil))
+	if s := stateOf(flowOf(h, hoPeerEnd)); s != flowClosing {
+		t.Fatalf("an exact reset did not close the flow: %d", s)
+	}
+}
+
+func TestHandoffHandshakeChecks(t *testing.T) {
+	open := func(t *testing.T) (*hoWorld, *handoff) {
+		w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+		h := newTestHandoff(t, w, []string{"a"}, nil)
+		h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil))
+		return w, h
+	}
+	t.Run("late final ACK", func(t *testing.T) {
+		_, h := open(t)
+		fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK, nil))
+		f := flowOf(h, hoPeerEnd)
+		f.mu.Lock()
+		f.deadline = time.Now().Add(-time.Second)
+		f.mu.Unlock()
+		h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK, nil))
+		if s := stateOf(f); s != flowDenied {
+			t.Fatalf("late handshake state %d", s)
+		}
+	})
+	t.Run("damaged data on the final ACK", func(t *testing.T) {
+		_, h := open(t)
+		fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK, nil))
+		bad := tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK|tcpURG, []byte("x"))
+		bad[len(bad)-1] ^= 0xff
+		h.Inbound(bad)
+		if s := stateOf(flowOf(h, hoPeerEnd)); s != flowOpening {
+			t.Fatalf("damaged segment moved the flow to %d", s)
+		}
+	})
+	t.Run("SYN-ACK with FIN or another ISN", func(t *testing.T) {
+		w, h := open(t)
+		fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK|tcpFIN, nil))
+		fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5000, 1001, tcpSYN|tcpACK, nil))
+		fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 6000, 1001, tcpSYN|tcpACK, nil))
+		if _, p := w.counts(); p != 1 {
+			t.Fatalf("%d SYN-ACKs reached the peer, want 1", p)
+		}
+	})
+	t.Run("SYN after the handshake", func(t *testing.T) {
+		w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+		h := newTestHandoff(t, w, []string{"a"}, nil)
+		handshake(t, h, nil)
+		waitState(t, h, flowAllowed)
+		before, _ := w.counts()
+		h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, []byte("data")))
+		if after, _ := w.counts(); after != before {
+			t.Fatal("a SYN reached an established connection")
+		}
+	})
+}
