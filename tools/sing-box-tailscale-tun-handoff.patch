+func TestHandoffSystemICMPOnlyForAllowed(t *testing.T) {
+	icmpFromSystem := func(to netip.Addr) []byte {
+		quote := tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK, nil)
+		b := make([]byte, 28+len(quote))
+		b[0], b[8], b[9] = 0x45, 64, 1
+		binary.BigEndian.PutUint16(b[2:4], uint16(len(b)))
+		l4, p4 := hoLocal.As4(), to.As4()
+		copy(b[12:16], l4[:])
+		copy(b[16:20], p4[:])
+		b[20] = 3
+		copy(b[28:], quote)
+		return b
+	}
+	for _, allowedApp := range []bool{true, false} {
+		owner := "com.other"
+		if allowedApp {
+			owner = "a"
+		}
+		w := &hoWorld{owner: func() ([]string, error) { return []string{owner}, nil }}
+		h := newTestHandoff(t, w, []string{"a"}, nil)
+		handshake(t, h, nil)
+		if allowedApp {
+			waitState(t, h, flowAllowed)
+		} else {
+			waitState(t, h, flowDenied)
+		}
+		_, before := w.counts()
+		if !fromSystem(h, icmpFromSystem(hoPeer)) {
+			t.Fatal("an ICMP error about a handed-off flow was left to the stack")
+		}
+		fromSystem(h, icmpFromSystem(netip.MustParseAddr("100.64.0.7"))) // sent elsewhere than the peer it quotes
+		_, after := w.counts()
+		if got := after - before; allowedApp && got != 1 || !allowedApp && got != 0 {
+			t.Fatalf("allowed=%v: %d ICMP packets reached the peer", allowedApp, got)
+		}
+	}
+}
