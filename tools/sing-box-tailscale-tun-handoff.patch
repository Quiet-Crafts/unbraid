+// Package tunhandoff links the TUN inbound and an endpoint that hands inbound packets to the system through the TUN
+// (unbraid patch). One Binding per engine instance, keyed by its router, so an engine that is shutting down never
+// reaches the TUN of the engine that replaced it.
+package tunhandoff
+
+import (
+	"net/netip"
+	"sync"
+	"sync/atomic"
+)
+
+// Handler takes packets the system writes into the TUN before they reach the stack.
+type Handler interface {
+	// Intercept is called once per packet; packet(n) returns its first n bytes (all for n <= 0). True: taken.
+	Intercept(source netip.Addr, packet func(n int) ([]byte, bool)) bool
+}
+
+type handlerBox struct{ Handler }
+
+type writerBox struct{ write func([]byte) error }
+
+// Binding is what one engine instance's TUN and endpoint share.
+type Binding struct {
+	refs    int // guarded by bindingsAccess
+	wanted  atomic.Bool
+	handler atomic.Pointer[handlerBox]
+	writer  atomic.Pointer[writerBox]
+}
+
+var (
+	bindingsAccess sync.Mutex
+	bindings       = map[any]*Binding{}
+)
+
+// Acquire returns the binding of the engine instance identified by owner (its router); Release drops it.
+func Acquire(owner any) *Binding {
+	bindingsAccess.Lock()
+	defer bindingsAccess.Unlock()
+	b := bindings[owner]
+	if b == nil {
+		b = &Binding{}
+		bindings[owner] = b
+	}
+	b.refs++
+	return b
+}
+
+func Release(owner any, b *Binding) {
+	bindingsAccess.Lock()
+	defer bindingsAccess.Unlock()
+	if b.refs--; b.refs <= 0 && bindings[owner] == b {
+		delete(bindings, owner)
+	}
+}
+
+// Want marks that an endpoint of this instance hands packets off, so its TUN installs the interceptor.
+func (b *Binding) Want() { b.wanted.Store(true) }
+
+func (b *Binding) Wanted() bool { return b.wanted.Load() }
+
+// SetHandler registers h and returns a token for ClearHandler, which removes it only if it is still the one.
+func (b *Binding) SetHandler(h Handler) any {
+	box := &handlerBox{h}
+	b.handler.Store(box)
+	return box
+}
+
+func (b *Binding) ClearHandler(token any) {
+	if box, ok := token.(*handlerBox); ok {
+		b.handler.CompareAndSwap(box, nil)
+	}
+}
+
+// SetWriter registers the TUN's raw writer and returns a token for ClearWriter.
+func (b *Binding) SetWriter(w func([]byte) error) any {
+	box := &writerBox{w}
+	b.writer.Store(box)
+	return box
+}
+
+func (b *Binding) ClearWriter(token any) {
+	if box, ok := token.(*writerBox); ok {
+		b.writer.CompareAndSwap(box, nil)
+	}
+}
+
+// Write writes one IP packet into the TUN, towards the system. False when there is no TUN or the write failed.
+func (b *Binding) Write(packet []byte) bool {
+	w := b.writer.Load()
+	return w != nil && w.write(packet) == nil
+}
+
+// InterceptPacket is the TUN stack's interceptor: the handler is loaded once per packet.
+func (b *Binding) InterceptPacket(source netip.Addr, packet func(n int) ([]byte, bool)) bool {
+	h := b.handler.Load()
+	return h != nil && h.Intercept(source, packet)
+}
