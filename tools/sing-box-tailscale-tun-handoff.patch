+func TestParseUDP(t *testing.T) {
+	b := udpPacket(hoPeerEnd, hoUDPLocal, []byte("x"))
+	if p, ok := parseUDP4(b); !ok || p.src != hoPeerEnd || p.dst != hoUDPLocal {
+		t.Fatalf("parse %+v %v", p, ok)
+	}
+	frag := append([]byte(nil), b...)
+	binary.BigEndian.PutUint16(frag[6:8], 0x2000) // more fragments
+	if _, ok := parseUDP4(frag); ok {
+		t.Fatal("took a fragment")
+	}
+	short := append([]byte(nil), b...)
+	binary.BigEndian.PutUint16(short[24:26], 200) // UDP length beyond the packet
+	if _, ok := parseUDP4(short); ok {
+		t.Fatal("took a datagram longer than its packet")
+	}
+	if _, ok := parseUDP4(b[:20]); ok {
+		t.Fatal("took a truncated packet")
+	}
+}
