+func TestHandoffRetiresOnPeerChanges(t *testing.T) {
+	for name, peers := range map[string]map[netip.Addr]string{
+		"address change": nil,
+		"peer left":      {},
+		"other node":     {hoPeer: "n2"},
+	} {
+		t.Run(name, func(t *testing.T) {
+			w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+			h := newTestHandoff(t, w, []string{"a"}, nil)
+			handshake(t, h, nil)
+			waitState(t, h, flowAllowed)
+			f := flowOf(h, hoPeerEnd)
+			if peers == nil {
+				h.setLocal(netip.MustParseAddr("100.64.0.9"), map[netip.Addr]string{hoPeer: "n1"})
+			} else {
+				h.setLocal(hoLocal, peers)
+			}
+			before, beforePeer := w.counts()
+			h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1001, 5001, tcpACK|tcpPSH, []byte("late")))
+			fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 5001, 1001, tcpACK|tcpPSH, []byte("late")))
+			// Even a timeout on the retired flow writes nothing: a successor may own the tuple.
+			f.mu.Lock()
+			h.denyLocked(f)
+			f.mu.Unlock()
+			if after, afterPeer := w.counts(); after != before || afterPeer != beforePeer {
+				t.Fatal("a retired flow still wrote")
+			}
+		})
+	}
+}
