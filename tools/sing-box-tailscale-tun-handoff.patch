+//go:build with_gvisor
+
+package tailscale
+
+// The Tailscale endpoint's side of the TUN hand-off (unbraid patch).
+
+import (
+	"net/netip"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/tunhandoff"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/tailscale/net/packet"
+)
+
+// setupHandoff runs in NewEndpoint: it tells this engine instance's TUN to install the interceptor.
+func (t *Endpoint) setupHandoff(options *option.TailscaleTUNHandoffOptions) {
+	if options == nil {
+		return
+	}
+	t.handoffBinding = tunhandoff.Acquire(t.router)
+	t.handoffBinding.Want()
+	t.handoff = newHandoff(t.logger, options, handoffDeps{
+		owner:    t.handoffOwner,
+		toPeer:   t.handoffToPeer,
+		toSystem: t.handoffBinding.Write,
+	})
+}
+
+// startHandoff runs in postStart, once the engine exists; scope undoes it.
+func (t *Endpoint) startHandoff(scope *adapter.Scope) {
+	if t.handoff == nil {
+		return
+	}
+	ns := t.server.ExportNetstack()
+	take := func(p *packet.Parsed) bool { return t.handoff.Inbound(p.Buffer()) }
+	ns.InboundHandoff.Store(&take)
+	token := t.handoffBinding.SetHandler(t.handoff)
+	t.refreshHandoff()
+	go t.handoff.sweep()
+	scope.Add(func() error {
+		ns.InboundHandoff.Store(nil)
+		t.handoffBinding.ClearHandler(token)
+		t.handoff.close()
+		tunhandoff.Release(t.router, t.handoffBinding)
+		return nil
+	})
+}
+
+// refreshHandoff takes this node's IPv4 address and every peer's own node addresses from the current netmap.
+func (t *Endpoint) refreshHandoff() {
+	if t.handoff == nil {
+		return
+	}
+	addr4, _ := t.server.TailscaleIPs()
+	peers := map[netip.Addr]struct{}{}
+	if nm := t.server.ExportLocalBackend().NetMap(); nm != nil {
+		for _, node := range nm.Peers {
+			addresses := node.Addresses()
+			for i := 0; i < addresses.Len(); i++ {
+				if prefix := addresses.At(i); prefix.IsSingleIP() && prefix.Addr().Is4() {
+					peers[prefix.Addr()] = struct{}{}
+				}
+			}
+		}
+	}
+	t.handoff.setLocal(addr4, peers)
+}
+
+func (t *Endpoint) handoffOwner(local, peer netip.AddrPort) ([]string, error) {
+	if t.platformInterface == nil {
+		return nil, E.New("no platform to name the app")
+	}
+	owner, err := t.platformInterface.FindConnectionOwner(&adapter.FindConnectionOwnerRequest{
+		IpProtocol:         6,
+		SourceAddress:      local.Addr().String(),
+		SourcePort:         int32(local.Port()),
+		DestinationAddress: peer.Addr().String(),
+		DestinationPort:    int32(peer.Port()),
+	})
+	if err != nil {
+		return nil, err
+	}
+	return owner.AndroidPackageNames, nil
+}
+
+func (t *Endpoint) handoffToPeer(pkt []byte) {
+	if engine := t.wgEngine; engine != nil {
+		_, _ = engine.InputPackets([][]byte{pkt})
+	}
+}
