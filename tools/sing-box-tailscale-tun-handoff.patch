+func TestHandoffAllowedDevicesAndEvents(t *testing.T) {
+	tunhandoff.ClearEvents()
+	w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	h.allowNodes = map[string]bool{"n2": true} // the peer is node n1
+	if !h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1000, 0, tcpSYN, nil)) {
+		t.Fatal("a device that isn't allowed was left to the stack")
+	}
+	system, peer := w.seen()
+	if len(system) != 0 || len(peer) != 1 || peer[0].flags != tcpRST|tcpACK || flowOf(h, hoPeerEnd) != nil {
+		t.Fatalf("device not refused: system %d, peer %+v", len(system), peer)
+	}
+	h.allowNodes["n1"] = true
+	handshake(t, h, nil)
+	waitState(t, h, flowAllowed)
+	h.block["b"] = true
+	other := netip.AddrPortFrom(hoPeer, 40002)
+	w.listener = []string{"b"}
+	h.Inbound(tcpPacket(other, hoLocalEnd, 1, 0, tcpSYN, nil))
+	w.listener = []string{"a"}
+	ev := tunhandoff.Events()
+	if len(ev) != 3 || ev[2].Reason != "blocked" {
+		t.Fatalf("blocked refusal %+v", ev)
+	}
+	ev = ev[:2]
+	if len(ev) != 2 || ev[0].Allowed || ev[0].Reason != "device" || ev[0].Node != "n1" || ev[0].Peer != "100.64.0.6" || ev[0].Port != 1716 ||
+		!ev[1].Allowed || len(ev[1].Packages) != 1 || ev[1].Packages[0] != "a" {
+		t.Fatalf("events %+v", ev)
+	}
+	for i := 0; i < 60; i++ {
+		tunhandoff.Record(tunhandoff.Event{Port: uint16(i)})
+	}
+	if ev = tunhandoff.Events(); len(ev) != 50 || ev[49].Port != 59 {
+		t.Fatalf("kept %d events, newest %d", len(ev), ev[len(ev)-1].Port)
+	}
+	tunhandoff.ClearEvents()
+}
