+func TestHandoffIgnoresWhatIsNotItsOwn(t *testing.T) {
+	w := &hoWorld{owner: func() ([]string, error) { return []string{"a"}, nil }}
+	h := newTestHandoff(t, w, []string{"a"}, nil)
+	if h.Inbound(tcpPacket(hoPeerEnd, netip.AddrPortFrom(hoLocal, 5555), 1, 0, tcpSYN, nil)) {
+		t.Fatal("took a port outside the list")
+	}
+	if h.Inbound(tcpPacket(hoPeerEnd, netip.AddrPortFrom(hoLocal, 22), 1, 0, tcpSYN, nil)) {
+		t.Fatal("took a port below 1024")
+	}
+	stranger := netip.AddrPortFrom(netip.MustParseAddr("100.70.0.9"), 1)
+	if h.Inbound(tcpPacket(stranger, hoLocalEnd, 1, 0, tcpSYN, nil)) {
+		t.Fatal("took a SYN from an address that is no peer's own")
+	}
+	// Segments of a connection the stack holds (an outgoing one of Tailscale's, say).
+	if h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1, 1, tcpACK|tcpSYN, nil)) || h.Inbound(tcpPacket(hoPeerEnd, hoLocalEnd, 1, 1, tcpACK, []byte("x"))) {
+		t.Fatal("took a segment of no handed-off flow")
+	}
+	if s, _ := w.counts(); s != 0 {
+		t.Fatal("something reached the system")
+	}
+	if fromSystem(h, tcpPacket(hoLocalEnd, hoPeerEnd, 1, 0, tcpSYN, nil)) {
+		t.Fatal("took the system's own SYN")
+	}
+}
