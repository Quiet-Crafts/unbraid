+type pingTestPort struct {
+	N.Dialer
+	O.Adapter
+	written chan []byte
+	back    tun.Return
+}
+
+func (*pingTestPort) PreMatchFlow(string, netip.Addr) adapter.PreMatchAction {
+	return adapter.PreMatchFlow
+}
+func (*pingTestPort) PortAddresses() (netip.Addr, netip.Addr) {
+	return netip.IPv4Unspecified(), netip.IPv6Unspecified()
+}
+func (*pingTestPort) PortMTU() uint32 { return 0 }
+func (p *pingTestPort) AttachReturn(r tun.Return) error {
+	if p.back != nil && p.back != r {
+		return errors.New("a different return path is already attached")
+	}
+	p.back = r
+	return nil
+}
+func (*pingTestPort) DetachReturn(tun.Return) error { return nil }
+func (p *pingTestPort) WritePackets(packets [][]byte) error {
+	for _, v := range packets {
+		p.written <- slices.Clone(v)
+	}
+	return nil
+}
+
+type pingTestTun struct {
+	udpTestTun
+	returned chan []byte
+}
+
+func (p pingTestTun) WritePacket(pkt *stack.PacketBuffer) (int, error) {
+	v := pkt.ToView()
+	defer v.Release()
+	b := slices.Clone(v.AsSlice())
+	p.returned <- b
+	return len(b), nil
+}
+
+type pingTestStore struct {
+	adapter.FakeIPStore
+	alias netip.Addr
+}
+
+func (s pingTestStore) Contains(a netip.Addr) bool { return a == s.alias || a == s.alias.Next() }
+func (s pingTestStore) Lookup(a netip.Addr) (string, bool) {
+	if a == s.alias.Next() {
+		return "second.example", true
+	}
+	return "device.example", a == s.alias
+}
+
+type pingTestFake struct {
+	adapter.FakeIPTransport
+	store pingTestStore
+}
+
+func (f pingTestFake) Store() adapter.FakeIPStore { return f.store }
