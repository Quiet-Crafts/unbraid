+func pingTestIP(src, dst netip.Addr, protocol tcpip.TransportProtocolNumber, data []byte) []byte {
+	if src.Is6() {
+		raw := make([]byte, header.IPv6MinimumSize+len(data))
+		header.IPv6(raw).Encode(&header.IPv6Fields{PayloadLength: uint16(len(data)), TransportProtocol: protocol, HopLimit: 64, SrcAddr: tun.AddressFromAddr(src), DstAddr: tun.AddressFromAddr(dst)})
+		copy(raw[header.IPv6MinimumSize:], data)
+		return raw
+	}
+	raw := make([]byte, header.IPv4MinimumSize+len(data))
+	ip := header.IPv4(raw)
+	ip.Encode(&header.IPv4Fields{TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(protocol), SrcAddr: tun.AddressFromAddr(src), DstAddr: tun.AddressFromAddr(dst)})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	copy(ip.Payload(), data)
+	return raw
+}
+func pingTestEcho(src, dst netip.Addr, id uint16, body []byte, reply bool) []byte {
+	e := make([]byte, 8+len(body))
+	copy(e[8:], body)
+	if src.Is4() {
+		h := header.ICMPv4(e)
+		h.SetType(header.ICMPv4Echo)
+		if reply {
+			h.SetType(header.ICMPv4EchoReply)
+		}
+		h.SetIdent(id)
+		h.SetSequence(7)
+		h.SetChecksum(header.ICMPv4Checksum(h, 0))
+		return pingTestIP(src, dst, header.ICMPv4ProtocolNumber, e)
+	}
+	h := header.ICMPv6(e)
+	h.SetType(header.ICMPv6EchoRequest)
+	if reply {
+		h.SetType(header.ICMPv6EchoReply)
+	}
+	h.SetIdent(id)
+	h.SetSequence(7)
+	h.SetChecksum(header.ICMPv6Checksum(header.ICMPv6ChecksumParams{Header: h, Src: tun.AddressFromAddr(src), Dst: tun.AddressFromAddr(dst)}))
+	return pingTestIP(src, dst, header.ICMPv6ProtocolNumber, e)
+}
+func pingTestFragments(raw []byte, src, dst netip.Addr) [][]byte {
+	var ip header.Network = header.IPv4(raw)
+	if src.Is6() {
+		ip = header.IPv6(raw)
+	}
+	split := 16
+	if len(raw) > 9000 {
+		split = 8976
+	}
+	var out [][]byte
+	for i, data := range [][]byte{ip.Payload()[:split], ip.Payload()[split:]} {
+		if src.Is4() {
+			r := pingTestIP(src, dst, header.ICMPv4ProtocolNumber, data)
+			h := header.IPv4(r)
+			h.SetID(311)
+			flags := uint8(header.IPv4FlagMoreFragments)
+			if i == 1 {
+				flags = 0
+			}
+			h.SetFlagsFragmentOffset(flags, uint16(i*split))
+			h.SetChecksum(0)
+			h.SetChecksum(^h.CalculateChecksum())
+			out = append(out, r)
+		} else {
+			f := make([]byte, 8+len(data))
+			f[0] = uint8(header.ICMPv6ProtocolNumber)
+			off := uint16(1)
+			if i == 1 {
+				off = uint16(split)
+			}
+			binary.BigEndian.PutUint16(f[2:], off)
+			binary.BigEndian.PutUint32(f[4:], 311)
+			copy(f[8:], data)
+			out = append(out, pingTestIP(src, dst, 44, f))
+		}
+	}
+	return out
+}
+func pingTestInject(ep *channel.Endpoint, src, dst netip.Addr, id uint16, body []byte, fragmented bool) {
+	raw := pingTestEcho(src, dst, id, body, false)
+	frames := [][]byte{raw}
+	if fragmented {
+		frames = pingTestFragments(raw, src, dst)
+	}
+	proto := header.IPv4ProtocolNumber
+	if src.Is6() {
+		proto = header.IPv6ProtocolNumber
+	}
+	for _, frame := range frames {
+		p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(frame)})
+		ep.InjectInbound(proto, p)
+		p.DecRef()
+	}
+}
+
+func pingTestNetwork(t *testing.T, raw []byte, v6 bool) header.Network {
+	t.Helper()
+	if v6 {
+		h := header.IPv6(raw)
+		require.True(t, h.IsValid(len(raw)))
+		require.Equal(t, header.ICMPv6ProtocolNumber, h.TransportProtocol())
+		return h
+	}
+	h := header.IPv4(raw)
+	require.True(t, h.IsValid(len(raw)))
+	require.True(t, h.IsChecksumValid())
+	require.Equal(t, header.ICMPv4ProtocolNumber, h.TransportProtocol())
+	return h
+}
+
+func pingTestReceive(t *testing.T, ctx context.Context, c <-chan []byte) []byte {
+	t.Helper()
+	select {
+	case b := <-c:
+		return b
+	case <-ctx.Done():
+		t.Fatal("expected an echo at the selected port or tunnel")
+	}
+	return nil
+}
