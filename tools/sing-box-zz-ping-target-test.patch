+func TestPingUsesNarrowedDestination(t *testing.T) {
+	for _, family := range []struct{ name, src, alias, home, other, network string }{
+		{"IPv4", "192.0.2.10", "198.18.0.20", "192.168.1.20", "203.0.113.10", "192.168.0.0/16"},
+		{"IPv6", "2001:db8:1::10", "fd00::20", "fd12::20", "2001:db8:2::10", "fd12::/64"},
+	} {
+		for _, form := range []string{"ordinary", "reassembled"} {
+			t.Run(family.name+"/"+form, func(t *testing.T) {
+				src, alias, home := netip.MustParseAddr(family.src), netip.MustParseAddr(family.alias), netip.MustParseAddr(family.home)
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				rule, err := R.NewRule(ctx, log.StdLogger(), option.Rule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{
+					RawDefaultRule: option.RawDefaultRule{IPCIDR: []string{family.network}}, RuleAction: option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: "home"}},
+				}}, true)
+				require.NoError(t, err)
+				var lookups atomic.Int32
+				r := flowTestRouter(flowTestDNS{lookup: func(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error) {
+					lookups.Add(1)
+					return []netip.Addr{netip.MustParseAddr(family.other), home}, nil
+				}},
+					flowTestRule{action: &R.RuleActionResolve{Server: "a"}}, rule)
+				r.dnsTransport = pingTestTransports{r.dnsTransport.(flowTestTransports), pingTestFake{store: pingTestStore{alias: alias}}}
+				port := &pingTestPort{Adapter: O.NewAdapter(C.TypeDirect, "home", []string{"icmp"}, nil), written: make(chan []byte, 2)}
+				otherPort := &pingTestPort{Adapter: O.NewAdapter(C.TypeDirect, "proxy", []string{"icmp"}, nil), written: make(chan []byte, 1)}
+				r.outbound = udpTestOutbounds{byTag: map[string]adapter.Outbound{"home": port, "proxy": otherPort}}
+				ep := channel.New(8, 9000, "")
+				defer ep.Close()
+				dev := pingTestTun{udpTestTun{link: ep}, make(chan []byte, 1)}
+				s, err := tun.NewGVisor(tun.StackOptions{Context: ctx, Tun: dev, Handler: warmTestHandler{router: r}, UDPTimeout: time.Minute, Logger: log.StdLogger()})
+				require.NoError(t, err)
+				require.NoError(t, s.Start())
+				defer s.Close()
+				const id = 43
+				firstFragmented := form == "reassembled"
+				type peer struct {
+					alias, source netip.Addr
+					wireID        uint16
+				}
+				var peers []peer
+				for i, target := range []netip.Addr{alias, alias.Next(), alias} {
+					fragmented := (i == 0) == firstFragmented
+					body := []byte("hello from the tunnel")
+					if fragmented && src.Is4() {
+						body = bytes.Repeat(body, 435)
+					}
+					pingTestInject(ep, src, target, id, body, fragmented)
+					raw := pingTestReceive(t, ctx, port.written)
+					h := pingTestNetwork(t, raw, src.Is6())
+					require.Equal(t, home, tun.AddrFromAddress(h.DestinationAddress()))
+					wire := peer{target, tun.AddrFromAddress(h.SourceAddress()), binary.BigEndian.Uint16(h.Payload()[4:])}
+					expected := pingTestEcho(wire.source, home, wire.wireID, body, false)
+					require.Equal(t, expected[len(expected)-len(h.Payload()):], h.Payload())
+					peers = append(peers, wire)
+				}
+				require.EqualValues(t, 2, lookups.Load(), "both forms reuse the established decision")
+				require.NotEqual(t, peers[0].wireID, peers[1].wireID)
+				require.Equal(t, peers[0], peers[2], "mixed forms share the established wire identity")
+				for _, remote := range []peer{peers[1], peers[0]} {
+					// A distinct reply body proves that the physical peer responded.
+					body := []byte("reply to " + remote.alias.String())
+					raw := pingTestEcho(home, remote.source, remote.wireID, body, true)
+					require.Empty(t, port.back.ReturnPackets([][]byte{append(make([]byte, port.back.ReturnHeadroom()), raw...)}))
+					reply := pingTestReceive(t, ctx, dev.returned)
+					h := pingTestNetwork(t, reply, src.Is6())
+					require.Equal(t, remote.alias, tun.AddrFromAddress(h.SourceAddress()))
+					require.Equal(t, src, tun.AddrFromAddress(h.DestinationAddress()))
+					expected := pingTestEcho(remote.alias, src, id, body, true)
+					require.Equal(t, expected[len(expected)-len(h.Payload()):], h.Payload())
+				}
+				// A literal outside the selected network must use its normal route.
+				outside := netip.MustParseAddr(family.other)
+				pingTestInject(ep, src, outside, id, []byte("direct literal peer"), false)
+				literal := pingTestNetwork(t, pingTestReceive(t, ctx, otherPort.written), src.Is6())
+				require.Equal(t, outside, tun.AddrFromAddress(literal.DestinationAddress()))
+				require.Empty(t, port.written)
+
+				s.ResetNetwork()
+				remote := peers[0]
+				late := pingTestEcho(home, remote.source, remote.wireID, []byte("previous echo"), true)
+				packets := [][]byte{append(make([]byte, port.back.ReturnHeadroom()), late...)}
+				require.Len(t, port.back.ReturnPackets(packets), 1, "a retired alias must not consume old replies")
+				require.Empty(t, dev.returned)
+			})
+		}
+	}
+}
