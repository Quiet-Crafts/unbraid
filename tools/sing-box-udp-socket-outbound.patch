+// HasPlainUDPOptions reports whether the rule leaves UDP destinations, dialing and socket lifetime unchanged.
+func (r *RuleActionRouteOptions) HasPlainUDPOptions() bool {
+	return !r.OverrideAddress.IsValid() && r.OverridePort == 0 && !r.UDPConnect &&
+		!r.UDPDisableDomainUnmapping && r.UDPTimeout == 0 && r.NetworkStrategy == nil &&
+		len(r.NetworkType) == 0 && len(r.FallbackNetworkType) == 0 && r.FallbackDelay == 0
+}
