+
+type udpTestTun struct {
+	tun.GVisorTun
+	link *channel.Endpoint
+}
+
+func (t udpTestTun) Name() (string, error) { return "test", nil }
+func (t udpTestTun) NewEndpoint() (stack.LinkEndpoint, stack.NICOptions, error) {
+	return t.link, stack.NICOptions{}, nil
+}
+
+type udpTestOutbounds struct {
+	adapter.OutboundManager
+	byTag map[string]adapter.Outbound
+}
+
+func (m udpTestOutbounds) Outbound(tag string) (adapter.Outbound, bool) {
+	o, ok := m.byTag[tag]
+	return o, ok
+}
+func (m udpTestOutbounds) Default() adapter.Outbound { return m.byTag["proxy"] }
+
+type udpTestHandler struct {
+	warmTestHandler
+	changedPeer netip.Addr
+	finished    chan struct{}
+}
+
+func (h udpTestHandler) NewPacketConnectionEx(ctx context.Context, c N.PacketConn, src, dst M.Socksaddr, close N.CloseHandlerFunc) {
+	h.router.RoutePacketConnectionEx(ctx, c, adapter.InboundContext{Inbound: "tun", InboundType: C.TypeTun, Network: N.NetworkUDP, Source: src, Destination: dst}, close)
+	if dst.Addr == h.changedPeer {
+		h.finished <- struct{}{}
+	}
+}
+
+type udpTestDelivery struct {
+	owner string
+	conn  N.PacketConn
+	dest  M.Socksaddr
+}
+type udpTestConnections struct {
+	adapter.ConnectionManager
+	received chan udpTestDelivery
+}
+
+func (p udpTestConnections) NewPacketConnection(ctx context.Context, dialer N.Dialer, c N.PacketConn, meta adapter.InboundContext, _ N.CloseHandlerFunc) {
+	b := buf.New()
+	defer b.Release()
+	for {
+		b.Reset()
+		dest, err := c.ReadPacket(b)
+		if err != nil {
+			return
+		}
+		select {
+		case p.received <- udpTestDelivery{meta.RouteOutbound, c, dest}:
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+// Exercise both the real per-destination rule match and the writer actually chosen
+// by the socket router. The in-memory tunnel and connection manager do no I/O.
+func TestUDPWriterFollowsTheSelectedOutbound(t *testing.T) {
+	cfg := func(typ, tag string, networks ...string) O.Adapter { return O.NewAdapter(typ, tag, networks, nil) }
+	out := udpTestOutbounds{byTag: map[string]adapter.Outbound{
+		"direct": &direct.Outbound{Adapter: cfg(C.TypeDirect, "direct", "udp")},
+		"proxy":  &shadowsocks.Outbound{Adapter: cfg(C.TypeShadowsocks, "proxy", "udp")},
+	}}
+	ctx := context.Background()
+	rule, err := R.NewRule(ctx, log.StdLogger(), option.Rule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{
+		RawDefaultRule: option.RawDefaultRule{IPCIDR: []string{"192.168.0.0/16", "fd00::/8"}},
+		RuleAction:     option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: "direct"}},
+	}}, true)
+	require.NoError(t, err)
+	changedPeer := netip.MustParseAddr("203.0.113.77")
+	r := flowTestRouter(flowTestDNS{}, rule, flowTestRule{match: func(m *adapter.InboundContext) bool {
+		return m.Destination.Addr == changedPeer && !m.PreMatch
+	}, action: &R.RuleActionRoute{Outbound: "direct"}})
+	finished := make(chan struct{}, 1)
+	r.outbound = out
+	received := make(chan udpTestDelivery, 1)
+	r.connection = udpTestConnections{received: received}
+	ep := channel.New(8, 1500, "")
+	defer ep.Close()
+	s, err := tun.NewGVisor(tun.StackOptions{Context: ctx, Tun: udpTestTun{link: ep}, Handler: udpTestHandler{warmTestHandler{router: r}, changedPeer, finished}, UDPTimeout: time.Minute, Logger: log.StdLogger()})
+	require.NoError(t, err)
+	require.NoError(t, s.Start())
+	defer s.Close()
+	inject := func(addr string, port, sourcePort uint16) {
+		dst := netip.MustParseAddr(addr)
+		src := netip.MustParseAddr("192.0.2.10")
+		protocol := header.IPv4ProtocolNumber
+		networkSize := header.IPv4MinimumSize
+		if dst.Is6() {
+			src = netip.MustParseAddr("2001:db8::10")
+			protocol = header.IPv6ProtocolNumber
+			networkSize = header.IPv6MinimumSize
+		}
+		raw := make([]byte, networkSize+header.UDPMinimumSize+2)
+		source, target := tun.AddressFromAddr(src), tun.AddressFromAddr(dst)
+		udp := header.UDP(raw[networkSize:])
+		udp.Encode(&header.UDPFields{SrcPort: sourcePort, DstPort: port, Length: uint16(len(udp))})
+		udp.SetChecksum(^udp.CalculateChecksum(header.PseudoHeaderChecksum(header.UDPProtocolNumber, source, target, uint16(len(udp)))))
+		if dst.Is4() {
+			ip := header.IPv4(raw)
+			ip.Encode(&header.IPv4Fields{TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(header.UDPProtocolNumber), SrcAddr: source, DstAddr: target})
+			ip.SetChecksum(^ip.CalculateChecksum())
+		} else {
+			ip := header.IPv6(raw)
+			ip.Encode(&header.IPv6Fields{PayloadLength: uint16(len(udp)), TransportProtocol: header.UDPProtocolNumber, HopLimit: 64, SrcAddr: source, DstAddr: target})
+		}
+		p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(raw)})
+		ep.InjectInbound(protocol, p)
+		p.DecRef()
+	}
+	send := func(addr string, port, sourcePort uint16) udpTestDelivery {
+		t.Helper()
+		inject(addr, port, sourcePort)
+		dst := netip.MustParseAddr(addr)
+		select {
+		case delivered := <-received:
+			require.Equal(t, netip.AddrPortFrom(dst, port), delivered.dest.AddrPort())
+			return delivered
+		case <-time.After(3 * time.Second):
+			t.Fatal("no outgoing datagram")
+			return udpTestDelivery{}
+		}
+	}
+	reply := func(writer udpTestDelivery) {
+		t.Helper()
+		body := []byte("ok")
+		require.NoError(t, writer.conn.WritePacket(buf.As(body), writer.dest))
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		p := ep.ReadContext(ctx)
+		require.NotNil(t, p)
+		defer p.DecRef()
+		v := p.ToView()
+		defer v.Release()
+		var ip header.Network = header.IPv4(v.AsSlice())
+		local := netip.MustParseAddr("192.0.2.10")
+		if writer.dest.IsIPv6() {
+			ip = header.IPv6(v.AsSlice())
+			local = netip.MustParseAddr("2001:db8::10")
+		}
+		require.Equal(t, writer.dest.Addr, tun.AddrFromAddress(ip.SourceAddress()))
+		require.Equal(t, local, tun.AddrFromAddress(ip.DestinationAddress()))
+		udp := header.UDP(ip.Payload())
+		require.Equal(t, writer.dest.Port, udp.SourcePort())
+		require.EqualValues(t, 45000, udp.DestinationPort())
+		require.Equal(t, body, udp.Payload())
+	}
+	for _, peers := range [][4]string{{"203.0.113.4", "192.168.1.4", "203.0.113.8", "192.168.1.8"}, {"2001:db8:1::4", "fd00::4", "2001:db8:1::8", "fd00::8"}} {
+		first := send(peers[0], 9000, 45000)
+		require.Equal(t, "proxy", first.owner)
+		second := send(peers[1], 9001, 45000)
+		require.Equal(t, "direct", second.owner)
+		require.NotSame(t, first.conn, second.conn)
+		proxyPeer := send(peers[2], 9002, 45000)
+		require.Equal(t, "proxy", proxyPeer.owner)
+		require.Same(t, first.conn, proxyPeer.conn)
+		directPeer := send(peers[3], 9003, 45000)
+		require.Equal(t, "direct", directPeer.owner)
+		require.Same(t, second.conn, directPeer.conn)
+		reply(proxyPeer)
+		reply(directPeer)
+	}
+	// Simulate updated owner information between admission and full routing.
+	// A different outbound cannot take the new association. Its source is usable again.
+	inject(changedPeer.String(), 9000, 45001)
+	select {
+	case <-finished:
+	case wrong := <-received:
+		t.Fatalf("changed selection installed writer %q", wrong.owner)
+	case <-time.After(3 * time.Second):
+		t.Fatal("changed selection did not retire")
+	}
+	require.Equal(t, "proxy", send("203.0.113.8", 9001, 45001).owner)
+}
+
+// An early handoff or changed socket options cannot name an interchangeable writer.
+func TestUDPUnprovenWriterIsBoundToItsDestination(t *testing.T) {
+	plain := &direct.Outbound{Adapter: O.NewAdapter(C.TypeDirect, "direct", []string{N.NetworkUDP}, nil)}
+	tcpOnly := &shadowsocks.Outbound{Adapter: O.NewAdapter(C.TypeShadowsocks, "proxy", []string{N.NetworkTCP}, nil)}
+	for _, test := range []struct {
+		name    string
+		actions []adapter.RuleAction
+	}{
+		{"missing outbound", []adapter.RuleAction{&R.RuleActionRoute{Outbound: "missing"}}},
+		{"unsupported UDP", []adapter.RuleAction{&R.RuleActionRoute{Outbound: "proxy"}}},
+		{"connected UDP", []adapter.RuleAction{&R.RuleActionRoute{Outbound: "direct", RuleActionRouteOptions: R.RuleActionRouteOptions{UDPConnect: true}}}},
+		{"previous route options", []adapter.RuleAction{&R.RuleActionRouteOptions{UDPTimeout: time.Minute}, &R.RuleActionRoute{Outbound: "direct"}}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			r := flowTestRouter(flowTestDNS{})
+			r.outbound = udpTestOutbounds{byTag: map[string]adapter.Outbound{"direct": plain, "proxy": tcpOnly}}
+			for _, action := range test.actions {
+				r.rules = append(r.rules, flowTestRule{action: action})
+			}
+			v, pending := adapter.BeginFlow(r, "tun", C.TypeTun, uint8(header.UDPProtocolNumber), netip.MustParseAddrPort("192.0.2.2:4000"), netip.MustParseAddrPort("203.0.113.9:9000"), nil)
+			require.Nil(t, pending)
+			require.True(t, v.DestinationBound)
+		})
+	}
+}
