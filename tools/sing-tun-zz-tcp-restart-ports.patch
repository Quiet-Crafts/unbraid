diff --git a/flow_nat_tcp_test.go b/flow_nat_tcp_test.go
new file mode 100644
index 0000000..5d74aed
--- /dev/null
+++ b/flow_nat_tcp_test.go
@@ -0,0 +1,80 @@
+package tun
+
+import (
+	"math"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-tun/gtcpip/header"
+)
+
+type selectorTestPort struct {
+	Port
+	start, count uint16
+}
+
+func (p selectorTestPort) PortSelectorRange() (uint16, uint16) { return p.start, p.count }
+
+func TestTCPFallbackVisitsEverySlot(t *testing.T) {
+	const tcp = uint8(header.TCPProtocolNumber)
+	local := netip.MustParseAddr("192.0.2.1")
+	remote := netip.MustParseAddr("192.0.2.2")
+	for _, width := range []uint16{1, 3, 7, 16} {
+		start := uint16(65536 - uint32(width))
+		for available := range width {
+			nat := newPortNAT(selectorTestPort{start: start, count: width})
+			nat.counter = math.MaxUint32 - 1
+			for index := range width {
+				if index != available {
+					nat.insert(nat.reverseKeyFor(tcp, local, remote, 443, start+index), &forwardFlow{})
+				}
+			}
+			port, key, ok := nat.allocateSelector(tcp, local, remote, 443, 80)
+			if !ok || port != start+available {
+				t.Fatalf("width %d: free %d, selected %d, ok %v", width, start+available, port, ok)
+			}
+			nat.insert(key, &forwardFlow{})
+			if _, _, ok := nat.allocateSelector(tcp, local, remote, 443, 80); ok {
+				t.Fatal("allocated over an occupied tuple")
+			}
+			// The same translated source is still free to another remote port.
+			if p, _, ok := nat.allocateSelector(tcp, local, remote, 444, port); !ok || p != port {
+				t.Fatal("distinct destination lost its preferred port")
+			}
+		}
+	}
+}
+
+func TestTCPFallbackAcrossPortNATs(t *testing.T) {
+	const tcp = uint8(header.TCPProtocolNumber)
+	local := netip.MustParseAddr("192.0.2.1")
+	remote := netip.MustParseAddr("192.0.2.2")
+	for _, offset := range []uint32{0, 1, 6} {
+		nat := newPortNAT(selectorTestPort{start: 55000, count: 7})
+		if nat.tcpOffset >= 7 {
+			t.Fatalf("TCP offset %d outside custom range", nat.tcpOffset)
+		}
+		// Control the offset on each new map. Two real starts can legitimately draw the same value.
+		nat.tcpOffset = offset
+		port, preferred, ok := nat.allocateSelector(tcp, local, remote, 443, 55003)
+		if !ok || port != 55003 || nat.counter != 0 {
+			t.Fatal("free preferred source consumed a fallback")
+		}
+		nat.insert(preferred, &forwardFlow{})
+		want := uint16(55000 + (offset+1)%7)
+		port, _, ok = nat.allocateSelector(tcp, local, remote, 443, 55003)
+		if !ok || port != want {
+			t.Fatalf("offset %d: fallback got %d, want %d", offset, port, want)
+		}
+		port, _, ok = nat.allocateSelector(uint8(header.UDPProtocolNumber), local, remote, 443, 80)
+		if !ok || port != 55002 {
+			t.Fatal("TCP offset changed next UDP fallback")
+		}
+		for i, protocol := range []uint8{uint8(header.ICMPv4ProtocolNumber), uint8(header.ICMPv6ProtocolNumber)} {
+			port, _, ok = nat.allocateSelector(protocol, local, remote, 0, 1)
+			if !ok || port != uint16(natSelectorMin+3+i) {
+				t.Fatal("TCP offset changed echo identifier fallback")
+			}
+		}
+	}
+}
