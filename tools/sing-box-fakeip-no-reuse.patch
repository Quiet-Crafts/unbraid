+// FakeIPLost: the file was found damaged and replaced by an empty one since a table on another range last reset it, so
+// fake-IP names it held are gone while programs may still hold their addresses. Also when it can't be read.
+func (c *CacheFile) FakeIPLost() bool {
+	var lost bool
+	err := c.view(func(tx *bbolt.Tx) error {
+		bucket := tx.Bucket(bucketFakeIP)
+		lost = bucket != nil && bucket.Get(keyLost) != nil
+		return nil
+	})
+	return lost || err != nil
+}
+
+func markFakeIPLost(db *bbolt.DB) error {
+	return db.Update(func(tx *bbolt.Tx) error {
+		bucket, err := tx.CreateBucketIfNotExists(bucketFakeIP)
+		if err != nil {
+			return err
+		}
+		return bucket.Put(keyLost, []byte{1})
+	})
+}
