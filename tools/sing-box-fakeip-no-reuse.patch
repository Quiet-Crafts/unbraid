+
+func open(t *testing.T, path string) *CacheFile {
+	t.Helper()
+	cache := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path, StoreFakeIP: true})
+	if err := cache.start(); err != nil {
+		t.Fatal(err)
+	}
+	return cache
+}
+
+func TestAFakeIPReadOrWriteThatFailsIsTrouble(t *testing.T) {
+	address := netip.MustParseAddr("198.18.0.2")
+	for name, f := range map[string]func(*CacheFile){
+		"checkpoint": func(c *CacheFile) { c.FakeIPMetadata() },
+		"address":    func(c *CacheFile) { c.FakeIPLoad(address) },
+		"name":       func(c *CacheFile) { c.FakeIPLoadDomain("a.example", false) },
+		"save":       func(c *CacheFile) { c.FakeIPStore(address, "a.example") },
+		"reset":      func(c *CacheFile) { c.FakeIPReset() },
+		"checkpoint save": func(c *CacheFile) {
+			c.FakeIPSaveMetadata(&adapter.FakeIPMetadata{Inet4Range: netip.MustParsePrefix("198.18.0.0/28"), Inet4Current: address})
+		},
+	} {
+		cache := open(t, t.TempDir()+"/cache.db")
+		if f(cache); cache.FakeIPTrouble() {
+			t.Fatalf("%s: trouble on a working cache (a missing checkpoint is none)", name)
+		}
+		cache.database().Close()
+		if f(cache); !cache.FakeIPTrouble() {
+			t.Fatalf("%s: a failure not noted as trouble", name)
+		}
+	}
+}
+
+// A background save asked for before trouble saves nothing once trouble came: after it no checkpoint is saved.
+func TestNoLateCheckpointAfterTrouble(t *testing.T) {
+	cache := open(t, t.TempDir()+"/cache.db")
+	defer cache.database().Close()
+	cache.saveMetadata = &adapter.FakeIPMetadata{Inet4Range: netip.MustParsePrefix("198.18.0.0/28"), Inet4Current: netip.MustParseAddr("198.18.0.2")}
+	cache.saveMetadataLater()
+	if cache.FakeIPMetadata() == nil {
+		t.Fatal("a late save without trouble saved nothing")
+	}
+	cache.fakeIPTrouble.Store(true)
+	cache.saveMetadataLater()
+	if cache.FakeIPMetadata() != nil {
+		t.Fatal("a late save after trouble saved a checkpoint")
+	}
+}
+
+func TestADatabaseFailureKeepsTheFileAndIsTrouble(t *testing.T) {
+	path := t.TempDir() + "/cache.db"
+	cache := open(t, path)
+	if err := cache.FakeIPStore(netip.MustParseAddr("198.18.0.2"), "a.example"); err != nil {
+		t.Fatal(err)
+	}
+	cache.resetDB(cache.database(), "test")
+	if !cache.FakeIPTrouble() {
+		t.Fatal("a database failure not noted as trouble")
+	}
+	if err := cache.FakeIPStore(netip.MustParseAddr("198.18.0.3"), "b.example"); err == nil {
+		t.Fatal("a closed cache saved a name")
+	}
+	again := open(t, path)
+	defer again.database().Close()
+	if again.FakeIPTrouble() {
+		t.Fatal("trouble carried into another instance")
+	}
+	if name, _ := again.FakeIPLoad(netip.MustParseAddr("198.18.0.2")); name != "a.example" {
+		t.Fatalf("the file was replaced: 198.18.0.2 maps to %q", name)
+	}
+}
+
+func TestADamagedFileIsKeptOnlyWithFakeIPNames(t *testing.T) {
+	path := t.TempDir() + "/cache.db"
+	if err := os.WriteFile(path, make([]byte, 2*os.Getpagesize()), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cache := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path, StoreFakeIP: true})
+	if err := cache.start(); err == nil {
+		t.Fatal("a damaged file opened")
+	}
+	if info, err := os.Stat(path); err != nil || info.Size() != int64(2*os.Getpagesize()) {
+		t.Fatal("the damaged file was replaced")
+	}
+	// A file that opens but fails its check is kept too.
+	os.Remove(path)
+	cache = open(t, path)
+	cache.FakeIPStore(netip.MustParseAddr("198.18.0.2"), "a.example")
+	cache.database().Close()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// The header of the page holding the name: its type becomes one no page has.
+	at := bytes.Index(data, []byte("a.example")) / os.Getpagesize() * os.Getpagesize()
+	data[at+8], data[at+9] = 0xff, 0xff
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	info, _ := os.Stat(path)
+	cache = New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path, StoreFakeIP: true})
+	if err := cache.start(); err == nil {
+		cache.database().Close()
+		t.Fatal("a file that fails its check opened")
+	}
+	if after, err := os.Stat(path); err != nil || after.Size() != info.Size() {
+		t.Fatal("the file that fails its check was replaced")
+	}
+	// Without fake-IP names the file is replaced, as before.
+	cache = New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path})
+	if err := cache.start(); err != nil {
+		t.Fatal(err)
+	}
+	cache.database().Close()
+}
+
+// A background save whose trouble check passed just before trouble came can't land after a troubled store took the
+// checkpoint away (Store.Close reads it, which removes it): that reading waits for the write, and removes it too.
+func TestNoCheckpointSurvivesATroubledClose(t *testing.T) {
+	cache := open(t, t.TempDir()+"/cache.db")
+	defer cache.database().Close()
+	checked, release := make(chan struct{}), make(chan struct{})
+	afterTroubleCheck = func() { close(checked); <-release }
+	defer func() { afterTroubleCheck = func() {} }()
+	cache.saveMetadata = &adapter.FakeIPMetadata{Inet4Range: netip.MustParsePrefix("198.18.0.0/28"), Inet4Current: netip.MustParseAddr("198.18.0.2")}
+	saved := make(chan struct{})
+	go func() { cache.saveMetadataLater(); close(saved) }()
+	<-checked
+	cache.fakeIPTrouble.Store(true) // a failed allocation, while the database is still open
+	taken := make(chan struct{})
+	go func() { cache.FakeIPMetadata(); close(taken) }() // the troubled close's reading
+	select {
+	case <-taken:
+	case <-time.After(100 * time.Millisecond): // it waits for the write
+	}
+	close(release)
+	<-saved
+	<-taken
+	if cache.FakeIPMetadata() != nil {
+		t.Fatal("a checkpoint survived the troubled close")
+	}
+}
+
+// The final checkpoint is the last word: a background save asked for before it, or one already under way, never lands
+// after it, and trouble at the moment of the final write removes the checkpoint instead.
+func TestTheFinalCheckpointIsTheLast(t *testing.T) {
+	cache := open(t, t.TempDir()+"/cache.db")
+	defer cache.database().Close()
+	prefix := netip.MustParsePrefix("198.18.0.0/28")
+	older := &adapter.FakeIPMetadata{Inet4Range: prefix, Inet4Current: netip.MustParseAddr("198.18.0.2")}
+	final := &adapter.FakeIPMetadata{Inet4Range: prefix, Inet4Current: netip.MustParseAddr("198.18.0.5")}
+	cache.FakeIPSaveMetadataAsync(older)
+	if err := cache.FakeIPSaveFinalMetadata(final); err != nil {
+		t.Fatal(err)
+	}
+	cache.saveMetadata = older
+	cache.saveMetadataLater() // a timer that had already fired, waiting for the lock
+	if got := cache.FakeIPMetadata(); got == nil || got.Inet4Current != final.Inet4Current {
+		t.Fatalf("checkpoint %v after the final one, want %v", got, final)
+	}
+	cache.FakeIPSaveMetadata(older)
+	cache.fakeIPTrouble.Store(true)
+	if err := cache.FakeIPSaveFinalMetadata(final); err != nil || cache.FakeIPMetadata() != nil {
+		t.Fatalf("a final checkpoint written after trouble (%v)", err)
+	}
+}
