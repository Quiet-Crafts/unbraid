+// A store on a real cache file at path, as an engine start opens it ([wrap] may stand in front of the cache); the
+// cache's start error if it refuses the file.
+func startOnCache(t *testing.T, path string, prefix netip.Prefix, wrap func(*cachefile.CacheFile) adapter.CacheFile) (*Store, *cachefile.CacheFile, func(), error) {
+	t.Helper()
+	ctx := context.Background()
+	cache := cachefile.New(ctx, logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path, StoreFakeIP: true})
+	scope := adapter.NewScope(ctx, log.NewNOPFactory().NewLogger(""))
+	if err := cache.Start(adapter.StartStateInitialize, scope); err != nil {
+		return nil, nil, nil, err
+	}
+	var shown adapter.CacheFile = cache
+	if wrap != nil {
+		shown = wrap(cache)
+	}
+	store := NewStore(service.ContextWith[adapter.CacheFile](ctx, shown), logger.NOP(), prefix, netip.Prefix{})
+	if err := store.Start(); err != nil {
+		scope.Close()
+		t.Fatal(err)
+	}
+	return store, cache, func() {
+		store.Close()
+		scope.Close()
+	}, nil
+}
+
+func mustStart(t *testing.T, path string, prefix netip.Prefix) (*Store, *cachefile.CacheFile, func()) {
+	t.Helper()
+	store, cache, stop, err := startOnCache(t, path, prefix, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return store, cache, stop
+}
+
+// Opens the cache file alone, to change what a store will find in it.
+func onCache(t *testing.T, path string, f func(*cachefile.CacheFile)) {
+	t.Helper()
+	ctx := context.Background()
+	cache := cachefile.New(ctx, logger.NOP(), option.CacheFileOptions{Enabled: true, Path: path, StoreFakeIP: true})
+	scope := adapter.NewScope(ctx, log.NewNOPFactory().NewLogger(""))
+	if err := cache.Start(adapter.StartStateInitialize, scope); err != nil {
+		t.Fatal(err)
+	}
+	f(cache)
+	scope.Close()
+}
