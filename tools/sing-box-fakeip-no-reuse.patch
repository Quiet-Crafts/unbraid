+		t.Fatalf("c.example given %s (%v), want 198.18.0.4", address, err)
+	}
+	if left := Remaining(); left != 10 {
+		t.Fatalf("remaining %d, want 10", left)
+	}
+	stop()
+	// The next range starts afresh, and drops the names of the last.
+	store, _, stop = mustStart(t, path, rangeB)
+	defer stop()
+	if address, err := store.Create("a.example", false); err != nil || address != netip.MustParseAddr("198.18.0.18") {
+		t.Fatalf("a.example on the next range given %s (%v), want 198.18.0.18", address, err)
