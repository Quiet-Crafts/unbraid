+// reconcile moves each position past the addresses storage still maps: a restored position can be older than what was
+// handed out (the cache saves it in the background, and a late save can land after the final one), and Remaining
+// must count only what Create can still hand out. Allocation is in order, so they follow the position.
+func (s *Store) reconcile() {
+	pastMapped := func(current netip.Addr, last netip.Addr, prefix netip.Prefix) netip.Addr {
+		for current.IsValid() {
+			next := current.Next()
+			if next == last || !prefix.Contains(next) {
+				break
+			}
+			if _, used := s.storage.FakeIPLoad(next); !used {
+				break
+			}
+			current = next
+		}
+		return current
+	}
+	s.inet4Current = pastMapped(s.inet4Current, s.inet4Last, s.inet4Range)
+	s.inet6Current = pastMapped(s.inet6Current, s.inet6Last, s.inet6Range)
+}
