+++ b/experimental/cachefile/fakeip_test.go
@@ -0,0 +1,35 @@
+package cachefile
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/logger"
+)
+
+func TestAResetWhileRunningMarksTheFakeIPNamesLost(t *testing.T) {
+	cache := New(context.Background(), logger.NOP(), option.CacheFileOptions{Enabled: true, Path: t.TempDir() + "/cache.db", StoreFakeIP: true})
+	if err := cache.start(); err != nil {
+		t.Fatal(err)
+	}
+	defer func() { cache.database().Close() }()
+	if err := cache.FakeIPStore(netip.MustParseAddr("198.18.0.2"), "a.example"); err != nil {
+		t.Fatal(err)
+	}
+	if cache.FakeIPLost() {
+		t.Fatal("lost before any reset")
+	}
+	cache.resetDB(cache.database(), "test")
+	if !cache.FakeIPLost() {
+		t.Fatal("not lost after the file was replaced")
+	}
+	// A table on another range clears the cache, and with it the mark.
+	if err := cache.FakeIPReset(); err != nil {
+		t.Fatal(err)
+	}
+	if cache.FakeIPLost() {
+		t.Fatal("still lost after a reset")
+	}
+}
