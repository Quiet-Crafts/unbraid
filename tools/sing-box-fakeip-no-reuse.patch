diff --git a/dns/transport/fakeip/store_test.go b/dns/transport/fakeip/store_test.go
new file mode 100644
index 0000000..67092c9
--- /dev/null
+++ b/dns/transport/fakeip/store_test.go
@@ -0,0 +1,158 @@
+package fakeip
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing/common/logger"
+)
+
+func TestStoreNeverReusesAnAddress(t *testing.T) {
+	store := NewStore(context.Background(), logger.NOP(), netip.MustParsePrefix("198.18.0.0/28"), netip.Prefix{})
+	if left := Remaining(); left != -1 {
+		t.Fatalf("remaining %d before start, want -1", left)
+	}
+	if err := store.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if left := Remaining(); left != 13 {
+		t.Fatalf("remaining %d, want 13", left)
+	}
+	seen := map[netip.Addr]string{}
+	for i := 0; i < 13; i++ {
+		name := fmt.Sprint("n", i, ".example")
+		address, err := store.Create(name, false)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		if other, used := seen[address]; used {
+			t.Fatalf("%s given %s, already %s's", name, address, other)
+		}
+		seen[address] = name
+	}
+	if left := Remaining(); left != 0 {
+		t.Fatalf("remaining %d, want 0", left)
+	}
+	if _, err := store.Create("late.example", false); err != ErrExhausted {
+		t.Fatalf("late lookup: %v, want ErrExhausted", err)
+	}
+	for address, name := range seen {
+		if again, err := store.Create(name, false); err != nil || again != address {
+			t.Fatalf("%s now %s (%v), want %s", name, again, err, address)
+		}
+		if owner, _ := store.Lookup(address); owner != name {
+			t.Fatalf("%s maps to %s, want %s", address, owner, name)
+		}
+	}
+	if err := store.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if left := Remaining(); left != -1 {
+		t.Fatalf("remaining %d after close, want -1", left)
+	}
+}
+
+func TestStoreSkipsAddressesAStalePositionWouldReuse(t *testing.T) {
+	store := NewStore(context.Background(), logger.NOP(), netip.MustParsePrefix("198.18.0.0/28"), netip.Prefix{})
+	if err := store.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	first, _ := store.Create("a.example", false)
+	second, _ := store.Create("b.example", false)
+	// As if started from a position saved before both were handed out.
+	store.inet4Current = netip.MustParseAddr("198.18.0.1")
+	third, err := store.Create("c.example", false)
+	if err != nil || third == first || third == second || third != netip.MustParseAddr("198.18.0.4") {
+		t.Fatalf("c.example given %s (%v) after a and b had %s and %s", third, err, first, second)
+	}
+	for address, name := range map[netip.Addr]string{first: "a.example", second: "b.example", third: "c.example"} {
+		if owner, _ := store.Lookup(address); owner != name {
+			t.Fatalf("%s maps to %s, want %s", address, owner, name)
+		}
+	}
+	if left := Remaining(); left != 10 {
+		t.Fatalf("remaining %d, want 10", left)
+	}
+}
+
+func TestStartCountsOnlyWhatCanStillBeHandedOut(t *testing.T) {
+	store := NewStore(context.Background(), logger.NOP(), netip.MustParsePrefix("198.18.0.0/28"), netip.Prefix{})
+	if err := store.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	for i := 0; i < 3; i++ {
+		store.Create(fmt.Sprint("n", i, ".example"), false)
+	}
+	// A position saved before those three, as a start restores it.
+	store.inet4Current = netip.MustParseAddr("198.18.0.1")
+	store.reconcile()
+	if left := Remaining(); left != 10 {
+		t.Fatalf("remaining %d with three mapped, want 10", left)
+	}
+	for i := 3; i < 13; i++ {
+		store.Create(fmt.Sprint("n", i, ".example"), false)
+	}
+	store.inet4Current = netip.MustParseAddr("198.18.0.1")
+	store.reconcile()
+	if left := Remaining(); left != 0 {
+		t.Fatalf("remaining %d with the block mapped, want 0", left)
+	}
+	if address, err := store.Create("n0.example", false); err != nil || address != netip.MustParseAddr("198.18.0.2") {
+		t.Fatalf("n0.example now %s (%v), want 198.18.0.2", address, err)
+	}
+}
+
+type failingStorage struct {
+	*MemoryStorage
+	fail bool
+}
+
+func (s *failingStorage) FakeIPStore(address netip.Addr, domain string) error {
+	if s.fail {
+		return errors.New("disk full")
+	}
+	return s.MemoryStorage.FakeIPStore(address, domain)
+}
+
+func TestAFailedSaveLeavesNoGapAndCountsThePoolUsedUp(t *testing.T) {
+	prefix := netip.MustParsePrefix("198.18.0.0/28")
+	store := NewStore(context.Background(), logger.NOP(), prefix, netip.Prefix{})
+	if err := store.Start(); err != nil {
+		t.Fatal(err)
+	}
+	storage := &failingStorage{MemoryStorage: store.storage.(*MemoryStorage)}
+	store.storage = storage
+	store.Create("a.example", false)
+	storage.fail = true
+	if _, err := store.Create("b.example", false); err == nil {
+		t.Fatal("b.example given an address whose name wasn't saved")
+	}
+	if left := Remaining(); left != 0 {
+		t.Fatalf("remaining %d after a failed save, want 0", left)
+	}
+	storage.fail = false
+	for i := 0; i < 11; i++ {
+		store.Create(fmt.Sprint("n", i, ".example"), false)
+	}
+	if address, _ := store.Create("c.example", false); address != netip.MustParseAddr("198.18.0.14") {
+		t.Fatalf("c.example given %s, want 198.18.0.14 (no gap left at 198.18.0.3)", address)
+	}
+	store.Close()
+	// A start on the same cache from a position saved before all of it counts nothing free.
+	again := NewStore(context.Background(), logger.NOP(), prefix, netip.Prefix{})
+	again.storage, again.inet4Current, again.inet4Last = storage, netip.MustParseAddr("198.18.0.1"), store.inet4Last
+	again.reconcile()
+	running.Store(again)
+	defer running.CompareAndSwap(again, nil)
+	if left := Remaining(); left != 0 {
+		t.Fatalf("remaining %d after a restart on a full cache, want 0", left)
+	}
+	if _, err := again.Create("d.example", false); err != ErrExhausted {
+		t.Fatalf("d.example: %v, want ErrExhausted", err)
+	}
+}
