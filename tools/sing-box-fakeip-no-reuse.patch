+func TestADamagedCacheFileIsRefusedAndKept(t *testing.T) {
+	path := t.TempDir() + "/cache.db"
+	store, _, stop := mustStart(t, path, rangeA)
+	handOut(t, store, "a.example")
+	stop()
+	file, err := os.OpenFile(path, os.O_WRONLY, 0)
+	if err == nil { // both meta pages overwritten: the file no longer opens as a database
+		_, err = file.WriteAt(bytes.Repeat([]byte{0xff}, 2*os.Getpagesize()), 0)
+		file.Close()
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		if _, _, _, err := startOnCache(t, path, rangeA, nil); err == nil {
+			t.Fatalf("start %d opened a damaged cache file", i)
+		}
+		if left := Remaining(); left != -1 {
+			t.Fatalf("start %d: remaining %d, want -1 (no store runs)", i, left)
+		}
+	}
+	head, err := os.ReadFile(path)
+	if err != nil || len(head) < 16 || !bytes.Equal(head[:16], bytes.Repeat([]byte{0xff}, 16)) {
+		t.Fatalf("the damaged file was replaced (%v)", err)
+	}
+}
