+//go:build with_gvisor
+
+package tailscale
+
+import (
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+type failReader struct{ t *testing.T }
+
+func (f failReader) Read([]byte) (int, error) { f.t.Error("request body was read"); return 0, errors.New("read") }
+
+// Unbraid: every Taildrop upload is refused without reading it.
+func TestTaildropRefused(t *testing.T) {
+	for _, method := range []string{http.MethodPut, http.MethodGet, http.MethodPost} {
+		w := httptest.NewRecorder()
+		handleTaildropRequest(nil, w, httptest.NewRequest(method, "/v0/put/file.txt", failReader{t}))
+		if w.Code != http.StatusForbidden {
+			t.Fatalf("%s: got %d, want 403", method, w.Code)
+		}
+	}
+}
