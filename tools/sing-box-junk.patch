diff --git a/transport/wireguard/client_bind_junk_test.go b/transport/wireguard/client_bind_junk_test.go
new file mode 100644
index 0000000..81d4fcc
--- /dev/null
+++ b/transport/wireguard/client_bind_junk_test.go
@@ -0,0 +1,144 @@
+package wireguard
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing/common/logger"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// The junk burst goes out before a handshake initiation, from the same socket to the same peer; other packets don't get one.
+func TestJunkBeforeHandshake(t *testing.T) {
+	l, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	peer := l.LocalAddr().(*net.UDPAddr).AddrPort()
+	b := NewClientBind(context.Background(), logger.NOP(), N.SystemDialer, true, peer, [3]uint8{})
+	b.junk = 5
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	hs := make([]byte, 148)
+	hs[0] = 1
+	data := make([]byte, 64)
+	data[0] = 4
+	if err := b.Send([][]byte{hs}, remoteEndpoint(peer), 0); err != nil {
+		t.Fatal(err)
+	}
+	if err := b.Send([][]byte{data}, remoteEndpoint(peer), 0); err != nil {
+		t.Fatal(err)
+	}
+	var sizes []int
+	var from *net.UDPAddr
+	buf := make([]byte, 2048)
+	for i := 0; i < 7; i++ {
+		_ = l.SetReadDeadline(time.Now().Add(2 * time.Second))
+		n, a, err := l.ReadFromUDP(buf)
+		if err != nil {
+			t.Fatalf("packet %d: %v", i, err)
+		}
+		if from != nil && a.Port != from.Port {
+			t.Fatalf("packet %d from port %d, not %d", i, a.Port, from.Port)
+		}
+		from = a
+		sizes = append(sizes, n)
+		if i == 5 && (n != 148 || buf[0] != 1) {
+			t.Fatalf("handshake not sixth: %v", sizes)
+		}
+	}
+	for _, n := range sizes[:5] {
+		if n < 30 || n > 100 {
+			t.Fatalf("junk sizes %v", sizes)
+		}
+	}
+	if sizes[6] != 64 {
+		t.Fatalf("data packet got junk too: %v", sizes)
+	}
+}
+
+// A socket that refuses every packet shorter than a handshake initiation, as a transient send error on the junk would.
+type junkRefusingConn struct {
+	net.PacketConn
+	sent [][]byte
+}
+
+func (c *junkRefusingConn) WriteTo(b []byte, addr net.Addr) (int, error) {
+	if len(b) < 148 {
+		return 0, errors.New("send failed")
+	}
+	c.sent = append(c.sent, append([]byte(nil), b...))
+	return len(b), nil
+}
+
+// Junk is best effort: an error sending it never stops the handshake, and never closes the socket.
+func TestJunkErrorDoesNotStopHandshake(t *testing.T) {
+	l, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	peer := l.LocalAddr().(*net.UDPAddr).AddrPort()
+	b := NewClientBind(context.Background(), logger.NOP(), N.SystemDialer, false, netip.AddrPort{}, [3]uint8{})
+	b.junk = 3
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	fake := &junkRefusingConn{PacketConn: l}
+	w := &wireConn{PacketConn: fake, done: make(chan struct{})}
+	b.conn = w
+	hs := make([]byte, 148)
+	hs[0] = 1
+	if err := b.Send([][]byte{hs}, remoteEndpoint(peer), 0); err != nil {
+		t.Fatalf("handshake not sent: %v", err)
+	}
+	if len(fake.sent) != 1 || len(fake.sent[0]) != 148 {
+		t.Fatalf("handshake not written once: %d writes", len(fake.sent))
+	}
+	select {
+	case <-w.done:
+		t.Fatal("socket closed after a junk error")
+	default:
+	}
+}
+
+// The receive goroutine and a sender open or replace the socket at the same time (run with -race).
+func TestConnectConcurrent(t *testing.T) {
+	l, err := net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	b := NewClientBind(context.Background(), logger.NOP(), N.SystemDialer, true, l.LocalAddr().(*net.UDPAddr).AddrPort(), [3]uint8{})
+	if _, _, err := b.Open(0); err != nil {
+		t.Fatal(err)
+	}
+	defer b.Close()
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				w, err := b.connect()
+				if err != nil {
+					t.Error(err)
+					return
+				}
+				if j%20 == 0 {
+					w.Close() // the next connect replaces it
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
