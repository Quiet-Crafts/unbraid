+func TestDeferredLookupCancellationAndPermanentPolicyRejection(t *testing.T) {
+	var calls atomic.Int32
+	started := make(chan struct{})
+	dns := flowTestDNS{lookup: func(ctx context.Context, _ string, _ adapter.DNSQueryOptions) ([]netip.Addr, error) {
+		calls.Add(1)
+		close(started)
+		<-ctx.Done()
+		return nil, ctx.Err()
+	}}
+	r := flowTestRouter(dns, flowTestRule{action: &R.RuleActionResolve{Server: "a"}}, flowTestRule{action: &R.RuleActionReject{Method: C.RuleActionRejectMethodDrop}})
+	_, p := r.BeginPreMatch(flowTestMetadata(), nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.True(t, p.Resolve(ctx).Transient)
+	require.Zero(t, calls.Load())
+	_, p = r.BeginPreMatch(flowTestMetadata(), nil)
+	ctx, cancel = context.WithCancel(context.Background())
+	result := make(chan adapter.PreMatchResult, 1)
+	go func() { result <- p.Resolve(ctx) }()
+	<-started
+	cancel()
+	require.True(t, (<-result).Transient)
+	require.Zero(t, r.tunResolves.total)
+	_, p = r.BeginPreMatch(flowTestMetadata(), nil)
+	r.InvalidateFlowResolves()
+	require.False(t, p.Valid())
+	direct := flowTestMetadata()
+	direct.Destination = M.ParseSocksaddr("192.0.2.12:443")
+	fast, p := r.BeginPreMatch(direct, nil)
+	require.Nil(t, p)
+	require.Equal(t, adapter.PreMatchDrop, fast.Action)
+	require.False(t, fast.Transient)
+}
