+// Admission can precede the first lookup when its worker is scheduled after reset.
+func TestNetworkResetRetiresDeferredLookupContext(t *testing.T) {
+	ctx := context.Background()
+	r := raceTestRouter(t)
+	r.client = NewClient(ClientOptions{Context: ctx, Logger: r.logger})
+	admitted := r.ContextWithCacheGeneration(ctx)
+	r.ResetNetwork()
+	old := &fakeDNSTransport{tag: "route", address: netip.MustParseAddr("192.0.2.1")}
+	current := &fakeDNSTransport{tag: "route", address: netip.MustParseAddr("192.0.2.2")}
+	lookup := func(ctx context.Context, transport *fakeDNSTransport) netip.Addr {
+		result, err := r.Lookup(ctx, "admission.example", adapter.DNSQueryOptions{Strategy: C.DomainStrategyIPv4Only, Transport: transport})
+		require.NoError(t, err)
+		return result[0]
+	}
+	require.Equal(t, old.address, lookup(admitted, old))
+	require.Equal(t, current.address, lookup(ctx, current))
+	require.Equal(t, current.address, lookup(ctx, current))
+	require.EqualValues(t, 1, current.queryCount.Load())
+}
+
+func TestReverseMappingIgnoresRetiredLookupContext(t *testing.T) {
+	ctx := context.Background()
+	ip := netip.MustParseAddr("192.0.2.4")
+	transport := &fakeDNSTransport{tag: "route", address: ip, immediate: true}
+	r := raceTestRouter(t, transport)
+	var err error
+	r.dnsReverseMapping, err = freelru.New[netip.Addr, string](16, maphash.NewHasher[netip.Addr]().Hash32, true)
+	require.NoError(t, err)
+	admitted := r.ContextWithCacheGeneration(ctx)
+	r.ResetNetwork()
+	options := adapter.DNSQueryOptions{Transport: transport}
+	_, err = r.Exchange(ctx, new(dns.Msg).SetQuestion("current.example.", dns.TypeA), options)
+	require.NoError(t, err)
+	done := make(chan error, 1)
+	r.ExchangeAsync(admitted, new(dns.Msg).SetQuestion("earlier.example.", dns.TypeA), options, func(_ *dns.Msg, err error) { done <- err })
+	require.NoError(t, <-done)
+	actual, found := r.LookupReverseMapping(ip)
+	require.True(t, found)
+	require.Equal(t, "current.example", actual)
+}
