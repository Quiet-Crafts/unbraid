+func (s *warmTestTransport) Type() string { return "udp" }
+func (s *warmTestTransport) Exchange(ctx context.Context, q *mDNS.Msg) (*mDNS.Msg, error) {
+	if q.Question[0].Name != "warm.example." {
+		s.cold.Add(1)
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-time.After(time.Minute):
+			return nil, fmt.Errorf("cold request exceeded virtual test guard")
+		}
+	}
+	s.warm.Add(1)
+	return D.FixedResponse(q.Id, q.Question[0], []netip.Addr{netip.MustParseAddr("203.0.113.7")}, 120), nil
+}
+func (s *warmTestTransport) ExchangeAsync(ctx context.Context, q *mDNS.Msg, done func(*mDNS.Msg, error)) {
+	go func() { done(s.Exchange(ctx, q)) }()
+}
