+func TestFlowResolveReplayFullMatchUsesOneLookupAndNarrows(t *testing.T) {
+	ctx := context.Background()
+	zero := uint32(0)
+	makeRule := func(cond option.RawDefaultRule, action option.RuleAction) adapter.Rule {
+		rule, err := R.NewRule(ctx, log.StdLogger(), option.Rule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{RawDefaultRule: cond, RuleAction: action}}, true)
+		require.NoError(t, err)
+		return rule
+	}
+	resolve := makeRule(option.RawDefaultRule{Domain: []string{"printer.example"}}, option.RuleAction{Action: C.RuleActionTypeResolve, ResolveOptions: option.RouteActionResolve{Server: "chosen", DisableCache: true, RewriteTTL: &zero}})
+	home := makeRule(option.RawDefaultRule{IPCIDR: []string{"192.168.0.0/16"}}, option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: "home"}})
+	dns := &replayTestDNS{}
+	router := &Router{ctx: ctx, logger: log.StdLogger(), dns: dns, dnsTransport: &replayTestTransports{current: &replayTestTransport{}}, outbound: &replayTestOutbounds{}, rules: []adapter.Rule{resolve, home}}
+	metadata := replayTestMetadata()
+	_, pending := router.BeginPreMatch(metadata, nil)
+	require.NotNil(t, pending)
+	verdict := pending.Resolve(ctx)
+	require.Equal(t, adapter.PreMatchContinue, verdict.Action)
+	require.NotNil(t, verdict.RouteContext)
+	socketCtx, cancel := context.WithCancel(verdict.RouteContext(ctx))
+	defer cancel()
+	rule, _, _, _, err := router.matchRule(socketCtx, &metadata, nil, nil)
+	require.NoError(t, err)
+	require.Same(t, home, rule)
+	require.Equal(t, []netip.Addr{netip.MustParseAddr("192.168.1.1")}, metadata.DestinationAddresses)
+	require.Equal(t, 1, dns.queries)
+	metadata = replayTestMetadata()
+	_, _, _, _, err = router.matchRule(socketCtx, &metadata, nil, nil)
+	require.NoError(t, err)
+	require.Equal(t, 2, dns.queries)
