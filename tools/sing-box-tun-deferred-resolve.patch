+func TestDeferredPolicyValidatesCurrentOwnerAndFakeMapping(t *testing.T) {
+	m := flowTestMetadata()
+	m.ProcessInfo = &adapter.ConnectionOwner{UserId: 1234, AndroidPackageNames: []string{"app.a"}}
+	original := M.ParseSocksaddr("198.18.0.9:443")
+	m.FakeIP = true
+	m.OriginDestination = original
+	now := &flowTestOwner{owner: m.ProcessInfo}
+	fake := &flowTestFakeStore{domain: m.Destination.Fqdn}
+	r := flowTestRouter(flowTestDNS{})
+	r.dnsTransport = flowTestFakeTransports{fake: flowTestFake{store: fake}}
+	r.processSearcher = newPlatformSearcher(now)
+	var err error
+	r.processCache, err = freelru.New[processCacheKey, processCacheEntry](8, maphash.NewHasher[processCacheKey]().Hash32, true)
+	require.NoError(t, err)
+	key := processCacheKey{Network: m.Network, Source: m.Source.AddrPort(), Destination: original.AddrPort()}
+	r.processCache.Add(key, processCacheEntry{result: m.ProcessInfo})
+	valid := r.pendingFlowValid(context.Background(), m, original, m.Destination.Fqdn, newFlowResolveReplay(r))
+	require.True(t, valid())
+	require.Equal(t, "198.18.0.9", now.request.DestinationAddress)
+	now.owner = &adapter.ConnectionOwner{UserId: 4321, AndroidPackageNames: []string{"app.b"}}
+	require.False(t, valid())
+	_, cached := r.processCache.Get(key)
+	require.False(t, cached)
+	now.owner = m.ProcessInfo
+	fake.domain = "another.example"
+	require.False(t, valid())
+	fake.domain = ""
+	require.False(t, valid())
+}
