+func TestDeferredPolicyDropsLateSuccessAfterCancellation(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	dns := flowTestDNS{lookup: func(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error) {
+		close(started)
+		<-release
+		return []netip.Addr{netip.MustParseAddr("198.51.100.7")}, nil
+	}}
+	r := flowTestRouter(dns, flowTestRule{action: &R.RuleActionResolve{Server: "a"}}, flowTestRule{action: &R.RuleActionHijackDNS{}})
+	_, p := r.BeginPreMatch(flowTestMetadata(), nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan adapter.PreMatchResult, 1)
+	go func() { done <- p.Resolve(ctx) }()
+	<-started
+	cancel()
+	close(release)
+	result := <-done
+	require.Equal(t, adapter.PreMatchReject, result.Action)
+	require.True(t, result.Transient)
+	require.Nil(t, result.RouteContext)
