+func TestWarmRouteDeliversWithItsOwnResolverAtCapacity(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		server := &warmTestTransport{flowTestTransport: flowTestTransport{tag: "a"}}
+		manager := warmTestTransports{flowTestTransports{byTag: map[string]adapter.DNSTransport{"a": server}}}
+		ctx := service.ContextWith[adapter.DNSTransportManager](context.Background(), manager)
+		options := option.DNSOptions{RawDNSOptions: option.RawDNSOptions{DNSClientOptions: option.DNSClientOptions{Strategy: option.DomainStrategy(C.DomainStrategyIPv4Only)}}}
+		dnsRouter, err := D.NewRouter(ctx, log.NewNOPFactory(), options)
+		require.NoError(t, err)
+		scope := adapter.NewScope(ctx, log.NewNOPFactory().Logger())
+		defer scope.Close()
+		require.NoError(t, dnsRouter.Start(adapter.StartStateStart, scope))
+		addresses, err := dnsRouter.Lookup(ctx, "warm.example", adapter.DNSQueryOptions{Transport: server})
+		require.NoError(t, err)
+		require.Equal(t, []netip.Addr{netip.MustParseAddr("203.0.113.7")}, addresses)
+		r := flowTestRouter(flowTestDNS{},
+			flowTestRule{action: &R.RuleActionResolve{Server: "a"}},
+			flowTestRule{match: func(m *adapter.InboundContext) bool {
+				return len(m.DestinationAddresses) == 1 && m.DestinationAddresses[0] == addresses[0]
+			}, action: &R.RuleActionRoute{Outbound: "allowed"}},
+			flowTestRule{action: &R.RuleActionReject{Method: C.RuleActionRejectMethodDrop}},
+		)
+		r.dns, r.dnsTransport, r.outbound = dnsRouter, manager, warmTestOutbounds{}
+		warm, found := dnsRouter.LookupFreshCache(ctx, "warm.example", adapter.DNSQueryOptions{Transport: server})
+		require.True(t, found, "seed is eligible for synchronous matching")
+		require.Equal(t, addresses, warm)
+		forward := tun.NewForwardDispatcher(warmTestHandler{router: r}, nil, nil, 0, 0)
+		defer forward.Close()
+		link := channel.New(1, 1500, "")
+		defer link.Close()
+		down := new(warmTestDelivery)
+		(&tun.LinkEndpointFilter{LinkEndpoint: link, Dispatcher: forward}).Attach(down)
+		send := func(last byte) {
+			data := make([]byte, header.IPv4MinimumSize+header.UDPMinimumSize)
+			ip := header.IPv4(data)
+			ip.Encode(&header.IPv4Fields{TotalLength: uint16(len(data)), TTL: 64, Protocol: uint8(header.UDPProtocolNumber), SrcAddr: tcpip.AddrFrom4([4]byte{192, 0, 2, 1}), DstAddr: tcpip.AddrFrom4([4]byte{198, 18, 0, last})})
+			ip.SetChecksum(^ip.CalculateChecksum())
+			header.UDP(ip.Payload()).Encode(&header.UDPFields{SrcPort: 41000, DstPort: 9000, Length: header.UDPMinimumSize})
+			pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(data)})
+			defer pkt.DecRef()
+			link.InjectInbound(header.IPv4ProtocolNumber, pkt)
+		}
+		// The public packet path has no capacity inspection API. Observe the actual
+		// admission boundary with independent names, stopping on the first refusal.
+		var active int32
+		for last := byte(1); last <= 32; last++ {
+			send(last)
+			synctest.Wait()
+			observed := server.cold.Load()
+			if observed == active {
+				break
+			}
+			active = observed
+		}
+		require.Positive(t, active)
+		require.Less(t, active, int32(32))
+		require.Empty(t, down.lastOctets)
+		send(100)
+		synctest.Wait()
+		require.Equal(t, []byte{100}, down.lastOctets)
+		require.EqualValues(t, 1, server.warm.Load(), "warming is the only transport exchange for this name")
+		require.Equal(t, active, server.cold.Load())
+	})
+}
