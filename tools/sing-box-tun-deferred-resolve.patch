diff --git a/route/tun_resolve.go b/route/tun_resolve.go
new file mode 100644
index 0000000..229eeae
--- /dev/null
+++ b/route/tun_resolve.go
@@ -0,0 +1,133 @@
+package route
+
+import (
+	"context"
+	"errors"
+	"slices"
+
+	"github.com/sagernet/sing-box/option"
+	R "github.com/sagernet/sing-box/route/rule"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"sync"
+
+	"github.com/sagernet/sing-box/adapter"
+)
+
+var errTunResolverBusy = errors.New("TUN route resolver is busy")
+
+func transientPreMatchReject() adapter.PreMatchResult {
+	return adapter.PreMatchResult{Action: adapter.PreMatchReject, Transient: true}
+}
+
+// A slow resolver cannot consume every lookup slot. No packet or goroutine waits for a slot:
+// secondary resolves and socket fallback use the same budget as the deferred first resolve.
+type tunResolveAdmission struct {
+	mu       sync.Mutex
+	byServer map[string]int
+	total    int
+}
+
+const (
+	tunResolvesPerServer = 16
+	tunResolvesTotal     = 256
+)
+
+func (a *tunResolveAdmission) acquire(server string) bool {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.total >= tunResolvesTotal || a.byServer[server] >= tunResolvesPerServer {
+		return false
+	}
+	if a.byServer == nil {
+		a.byServer = make(map[string]int)
+	}
+	a.byServer[server]++
+	a.total++
+	return true
+}
+
+func (a *tunResolveAdmission) release(server string) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	a.total--
+	a.byServer[server]--
+	if a.byServer[server] == 0 {
+		delete(a.byServer, server)
+	}
+}
+
+// Different resolver tags may go through the same tunnel or endpoint.
+func tunResolveGroups(servers []option.DNSServerOptions) map[string]string {
+	groups := make(map[string]string)
+	for _, server := range servers {
+		var outbound string
+		switch options := server.Options.(type) {
+		case option.DialerOptionsWrapper:
+			outbound = options.TakeDialerOptions().Detour
+		case *option.OpenVPNDNSServerOptions:
+			outbound = options.Endpoint
+		case *option.TailscaleDNSServerOptions:
+			outbound = options.Endpoint
+		}
+		if outbound != "" {
+			groups[server.Tag] = "outbound:" + outbound
+		}
+	}
+	return groups
+}
+
+func (r *Router) tunResolveGroup(server string) string {
+	if group, ok := r.tunResolveGroups[server]; ok {
+		return group
+	}
+	return "resolver:" + server
+}
+
+// Delayed decisions can outlive the application socket that supplied the source port.
+// Use the original wire tuple and an uncached platform owner lookup before installation.
+func (r *Router) pendingFlowValid(ctx context.Context, metadata adapter.InboundContext, destination M.Socksaddr, originalDomain string, replay *flowResolveReplay) func() bool {
+	var owner *adapter.ConnectionOwner
+	if metadata.ProcessInfo != nil {
+		copy := *metadata.ProcessInfo
+		copy.AndroidPackageNames = slices.Clone(copy.AndroidPackageNames)
+		owner = &copy
+	}
+	return func() bool {
+		if ctx.Err() != nil || !replay.current() {
+			return false
+		}
+		if metadata.FakeIP {
+			transport := r.dnsTransport.FakeIP()
+			if transport == nil {
+				return false
+			}
+			domain, ok := transport.Store().Lookup(destination.Addr)
+			if !ok || domain != originalDomain {
+				return false
+			}
+		}
+		searcher, platform := r.processSearcher.(*platformSearcher)
+		if !platform || metadata.Network == N.NetworkICMP {
+			return true
+		}
+		current, err := searcher.FindProcessInfo(ctx, metadata.Network, metadata.Source.AddrPort(), destination.AddrPort())
+		if err != nil {
+			current = nil
+		}
+		if (owner == nil && current == nil) || (owner != nil && current != nil && owner.UserId == current.UserId && slices.Equal(owner.AndroidPackageNames, current.AndroidPackageNames)) {
+			return true
+		}
+		r.processCache.Remove(processCacheKey{Network: metadata.Network, Source: metadata.Source.AddrPort(), Destination: destination.AddrPort()})
+		return false
+	}
+}
+
+func preMatchSniffEnd(rules []adapter.Rule) int {
+	for i := len(rules) - 1; i >= 0; i-- {
+		if _, ok := rules[i].Action().(*R.RuleActionSniff); ok {
+			return i + 1
+		}
+	}
+	return 0
+}
