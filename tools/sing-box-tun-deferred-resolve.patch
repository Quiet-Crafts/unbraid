+type testDNSClearGate struct {
+	adapter.NetworkManager
+	suspend func() func()
+	flush   func()
+}
+
+func (g testDNSClearGate) SuspendPendingFlows() func() { return g.suspend() }
+func (g testDNSClearGate) FlushSystemDNSCache()        { g.flush() }
+
+func TestExplicitClearHoldsAdmissionsUntilFlush(t *testing.T) {
+	ctx := context.Background()
+	transport := &fakeDNSTransport{tag: "exit", address: netip.MustParseAddr("192.0.2.9")}
+	r := raceTestRouter(t, transport)
+	r.client = NewClient(ClientOptions{Context: ctx, Logger: r.logger})
+	options := adapter.DNSQueryOptions{Transport: transport, Strategy: C.DomainStrategyIPv4Only}
+	_, err := r.Lookup(ctx, "clear.example", options)
+	require.NoError(t, err)
+	var held, flushed bool
+	gate := testDNSClearGate{
+		suspend: func() func() {
+			_, hit := r.LookupFreshCache(ctx, "clear.example", options)
+			require.True(t, hit)
+			held = true
+			return func() { require.True(t, flushed); held = false }
+		},
+		flush: func() {
+			require.True(t, held)
+			_, hit := r.LookupFreshCache(ctx, "clear.example", options)
+			require.False(t, hit)
+			flushed = true
+		},
+	}
+	r.ctx = service.ContextWith[adapter.NetworkManager](ctx, gate)
+	r.ClearCache()
+	require.True(t, flushed)
+	require.False(t, held)
+}
