+
+type heldDNSAnswer struct {
+	fakeDNSTransport
+	started chan struct{}
+	release chan struct{}
+}
+
+func (h *heldDNSAnswer) Exchange(ctx context.Context, msg *dns.Msg) (*dns.Msg, error) {
+	close(h.started)
+	<-h.release
+	return h.fakeDNSTransport.Exchange(ctx, msg)
+}
+
+func TestDNSClearCacheInFlight(t *testing.T) {
+	for _, path := range []string{"exchange", "optimistic exchange", "optimistic lookup"} {
+		t.Run(path, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				ctx := context.Background()
+				c := NewClient(ClientOptions{Context: ctx, OptimisticTimeout: time.Hour})
+				msg := new(dns.Msg).SetQuestion("clear.example.", dns.TypeA)
+				options := adapter.DNSQueryOptions{Strategy: C.DomainStrategyIPv4Only}
+				oldIP := netip.MustParseAddr("192.0.2.1")
+				newIP := netip.MustParseAddr("192.0.2.2")
+				old := &heldDNSAnswer{fakeDNSTransport{tag: "test", address: oldIP}, make(chan struct{}), make(chan struct{})}
+				fresh := &fakeDNSTransport{tag: "test", address: newIP, immediate: true}
+				if path == "exchange" {
+					go func() {
+						_, _ = c.Exchange(ctx, old, msg.Copy(), options, nil)
+					}()
+				} else {
+					seed := &fakeDNSTransport{tag: "test", address: oldIP}
+					_, err := c.Exchange(ctx, seed, msg.Copy(), options, nil)
+					require.NoError(t, err)
+					time.Sleep(301 * time.Second) // expire the 300-second record in virtual time
+					if path == "optimistic lookup" {
+						ips, err := c.Lookup(ctx, old, "clear.example", options, nil)
+						require.NoError(t, err)
+						require.Equal(t, []netip.Addr{oldIP}, ips)
+					} else {
+						reply, err := c.Exchange(ctx, old, msg.Copy(), options, nil)
+						require.NoError(t, err)
+						require.Equal(t, oldIP, responseAddress(t, reply))
+					}
+				}
+				<-old.started
+				c.ClearCache()
+				var next *dns.Msg
+				c.ExchangeAsync(ctx, fresh, msg.Copy(), options, nil, func(reply *dns.Msg, _ error) { next = reply })
+				synctest.Wait()
+				startedBeforeRelease := fresh.queryCount.Load()
+				close(old.release)
+				synctest.Wait()
+				require.EqualValues(t, 1, startedBeforeRelease)
+				require.Equal(t, newIP, responseAddress(t, next))
+				hit, err := c.Exchange(ctx, fresh, msg.Copy(), options, nil)
+				require.NoError(t, err)
+				require.Equal(t, newIP, responseAddress(t, hit))
+				require.EqualValues(t, 1, fresh.queryCount.Load())
+			})
+		})
+	}
+}
+
+func TestClearCacheKeepsWaitersInTheirAdmissionGeneration(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := context.Background()
+		c := NewClient(ClientOptions{Context: ctx})
+		opts := adapter.DNSQueryOptions{}
+		msg := new(dns.Msg).SetQuestion("caller.example.", dns.TypeA)
+		addr := netip.MustParseAddr("192.0.2.7")
+		old := &heldDNSAnswer{fakeDNSTransport{tag: "test", address: addr}, make(chan struct{}), make(chan struct{})}
+		waiter := &fakeDNSTransport{tag: "test", address: addr.Next()}
+		current := &fakeDNSTransport{tag: "test", address: addr.Next().Next()}
+		go func() { _, _ = c.Exchange(ctx, old, msg.Copy(), opts, nil) }()
+		<-old.started
+		go func() { _, _ = c.Exchange(ctx, waiter, msg.Copy(), opts, nil) }()
+		synctest.Wait()
+		require.Zero(t, waiter.queryCount.Load())
+		c.ClearCache()
+		close(old.release)
+		synctest.Wait()
+		require.EqualValues(t, 1, waiter.queryCount.Load())
+		response, err := c.Exchange(ctx, current, msg.Copy(), opts, nil)
+		require.NoError(t, err)
+		require.Equal(t, current.address, responseAddress(t, response))
+		require.EqualValues(t, 1, current.queryCount.Load())
+	})
+}
