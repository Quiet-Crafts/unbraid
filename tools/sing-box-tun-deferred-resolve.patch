+func TestDeferredPolicyResumesAfterTheMatchedAction(t *testing.T) {
+	addr := netip.MustParseAddr("198.51.100.7")
+	var seen []string
+	var prefix int
+	always := &R.RuleActionReject{Method: C.RuleActionRejectMethodDrop}
+	first := &R.RuleActionResolve{Server: "a", DisableCache: true}
+	second := &R.RuleActionResolve{Server: "b"}
+	dns := flowTestDNS{lookup: func(ctx context.Context, name string, opts adapter.DNSQueryOptions) ([]netip.Addr, error) {
+		require.NoError(t, ctx.Err())
+		require.Equal(t, "host.example", name)
+		seen = append(seen, opts.Transport.Tag())
+		require.Equal(t, len(seen) == 1, opts.DisableCache)
+		return []netip.Addr{addr}, nil
+	}}
+	r := flowTestRouter(dns,
+		flowTestRule{match: func(m *adapter.InboundContext) bool { prefix++; return true }, action: &R.RuleActionRouteOptions{OverridePort: 8443}},
+		flowTestRule{action: first},
+		flowTestRule{action: &R.RuleActionSniff{PacketSniffers: []sniff.PacketSniffer{func(ctx context.Context, m *adapter.InboundContext, packet []byte) error {
+			require.Equal(t, []byte{1, 2, 3}, packet)
+			m.Protocol = "example"
+			return nil
+		}}}},
+		flowTestRule{action: second},
+		flowTestRule{match: func(m *adapter.InboundContext) bool {
+			return m.Protocol == "example" && m.Destination.Port == 8443 && len(m.DestinationAddresses) == 1 && m.DestinationAddresses[0] == addr
+		}, action: &R.RuleActionHijackDNS{}},
+		flowTestRule{action: always})
+	packet := []byte{1, 2, 3}
+	_, pending := r.BeginPreMatch(flowTestMetadata(), packet)
+	require.NotNil(t, pending)
+	require.Equal(t, "resolver:a", pending.Resolver)
+	require.Empty(t, seen)
+	packet[0] = 9
+	require.True(t, pending.Valid())
+	result := pending.Resolve(context.Background())
+	require.Equal(t, adapter.PreMatchHijackDNS, result.Action)
+	require.Equal(t, []string{"a", "b"}, seen)
+	require.Equal(t, 1, prefix)
+	require.True(t, pending.Resolve(context.Background()).Transient)
+	require.Len(t, seen, 2)
+}
