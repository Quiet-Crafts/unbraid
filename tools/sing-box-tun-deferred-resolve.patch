+func TestTunLookupAdmissionGroupsAndFallback(t *testing.T) {
+	var calls int
+	errDNS := errors.New("test lookup")
+	r := flowTestRouter(flowTestDNS{lookup: func(context.Context, string, adapter.DNSQueryOptions) ([]netip.Addr, error) {
+		calls++
+		return nil, errDNS
+	}})
+	remote := &option.RemoteDNSServerOptions{}
+	remote.Detour = "shared"
+	r.tunResolveGroups = tunResolveGroups([]option.DNSServerOptions{
+		{Tag: "a", Options: remote}, {Tag: "b", Options: &option.OpenVPNDNSServerOptions{Endpoint: "shared"}},
+		{Tag: "home", Options: &option.TailscaleDNSServerOptions{Endpoint: "tailnet"}}})
+	group := r.tunResolveGroup("a")
+	require.Equal(t, group, r.tunResolveGroup("b"))
+	require.NotEqual(t, group, r.tunResolveGroup("home"))
+	for range tunResolvesPerServer {
+		require.True(t, r.tunResolves.acquire(group))
+	}
+	m := flowTestMetadata()
+	r.rules = []adapter.Rule{flowTestRule{action: &R.RuleActionResolve{Server: "b"}}}
+	_, _, _, _, err := r.matchRule(context.Background(), &m, nil, nil)
+	require.ErrorIs(t, err, errTunResolverBusy)
+	require.Zero(t, calls)
+	m.InboundType = "other"
+	_, _, _, _, err = r.matchRule(context.Background(), &m, nil, nil)
+	require.ErrorIs(t, err, errDNS)
+	require.Equal(t, 1, calls)
+	r.tunResolves.release(group)
+	m.InboundType = C.TypeTun
+	_, _, _, _, err = r.matchRule(context.Background(), &m, nil, nil)
+	require.ErrorIs(t, err, errDNS)
+	require.Equal(t, 2, calls)
+}
