new file mode 100644
index 0000000..6753cda
--- /dev/null
+++ b/route/flow_resolve_replay.go
@@ -0,0 +1,174 @@
+package route
+
+import (
+	"context"
+	"net/netip"
+	"reflect"
+	"slices"
+	"sync/atomic"
+
+	"github.com/sagernet/sing-box/adapter"
+	R "github.com/sagernet/sing-box/route/rule"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// A receipt belongs to the accepted socket. It is never indexed by a flow tuple or domain.
+// Any unrecorded actions follow the ordinary full matcher, including its DNS lookup.
+const maxFlowResolveReceipts = 8
+const maxFlowResolveAddresses = 64
+
+type flowResolveReplay struct {
+	router             *Router
+	epoch              uint64
+	networkEnvironment uint64
+	sealed             bool // A missing observation ends the replayable prefix.
+	claimed            atomic.Bool
+	answers            []flowResolveAnswer
+}
+
+type flowResolveContextKey struct{}
+
+type flowResolveAnswer struct {
+	action      *R.RuleActionResolve
+	options     R.RuleActionResolve
+	hasTTL      bool
+	ttl         uint32
+	transport   adapter.DNSTransport
+	environment []string
+	flow        flowResolveIdentity
+	owner       *adapter.ConnectionOwner
+	addresses   []netip.Addr
+}
+
+type flowResolveIdentity struct {
+	inbound, inboundType, network, user          string
+	source, destination, original, routeOriginal M.Socksaddr
+	fakeIP                                       bool
+}
+
+func resolveIdentity(metadata *adapter.InboundContext) flowResolveIdentity {
+	return flowResolveIdentity{
+		inbound: metadata.Inbound, inboundType: metadata.InboundType, network: metadata.Network, user: metadata.User,
+		source: metadata.Source, destination: metadata.Destination, original: metadata.OriginDestination,
+		routeOriginal: metadata.RouteOriginalDestination, fakeIP: metadata.FakeIP,
+	}
+}
+
+func newFlowResolveReplay(router *Router) *flowResolveReplay {
+	replay := &flowResolveReplay{router: router, epoch: router.tunResolveEpoch.Load()}
+	if router.network != nil {
+		replay.networkEnvironment = router.network.NetworkEnvironment()
+	}
+	return replay
+}
+
+func (r *flowResolveReplay) current() bool {
+	return r.epoch == r.router.tunResolveEpoch.Load() && (r.router.network == nil || r.networkEnvironment == r.router.network.NetworkEnvironment())
+}
+
+func (r *flowResolveReplay) hasResults() bool {
+	return r != nil && len(r.answers) != 0
+}
+
+func (r *flowResolveReplay) environmentBeforeLookup(transport adapter.DNSTransport) []string {
+	if r == nil {
+		return nil
+	}
+	if t, ok := transport.(adapter.DNSTransportWithEnvironment); ok {
+		return slices.Clone(t.Environment())
+	}
+	return nil
+}
+
+func sameResolveEnvironment(transport adapter.DNSTransport, env []string) bool {
+	if t, ok := transport.(adapter.DNSTransportWithEnvironment); ok {
+		return slices.Equal(t.Environment(), env)
+	}
+	return true
+}
+
+func (r *flowResolveReplay) record(metadata *adapter.InboundContext, action *R.RuleActionResolve, transport adapter.DNSTransport, environment []string) {
+	if r == nil || r.sealed {
+		return
+	}
+	if len(r.answers) >= maxFlowResolveReceipts || action.Server == "" || transport == nil || !metadata.Destination.IsDomain() || !r.current() {
+		r.sealed = true
+		return
+	}
+	// Only an explicitly selected transport with stable object identity can supply a receipt.
+	value := reflect.ValueOf(transport)
+	if value.Kind() != reflect.Pointer || value.IsNil() || !sameResolveEnvironment(transport, environment) || len(metadata.DestinationAddresses) == 0 || len(metadata.DestinationAddresses) > maxFlowResolveAddresses {
+		r.sealed = true
+		return
+	}
+	a := flowResolveAnswer{action: action, options: *action, transport: transport, environment: environment,
+		flow: resolveIdentity(metadata), addresses: slices.Clone(metadata.DestinationAddresses)}
+	if action.RewriteTTL != nil {
+		a.hasTTL, a.ttl, a.options.RewriteTTL = true, *action.RewriteTTL, nil
+	}
+	if metadata.ProcessInfo != nil {
+		owner := *metadata.ProcessInfo
+		owner.AndroidPackageNames = slices.Clone(owner.AndroidPackageNames)
+		a.owner = &owner
+	}
+	r.answers = append(r.answers, a)
+}
+
+func (r *flowResolveReplay) routeContext(ctx context.Context) context.Context {
+	return context.WithValue(ctx, flowResolveContextKey{}, r)
+}
+
+type flowResolveClaim struct {
+	ctx     context.Context
+	replay  *flowResolveReplay
+	answers []flowResolveAnswer
+}
+
+// The first full routing pass takes ownership. Child contexts and subsequent passes cannot replay it.
+func claimFlowResolveReplay(ctx context.Context, router *Router) *flowResolveClaim {
+	r, _ := ctx.Value(flowResolveContextKey{}).(*flowResolveReplay)
+	if r == nil || r.router != router || !r.claimed.CompareAndSwap(false, true) {
+		return nil
+	}
+	answers := r.answers
+	r.answers = nil
+	if ctx.Err() != nil || !r.current() {
+		return nil
+	}
+	return &flowResolveClaim{ctx: ctx, replay: r, answers: answers}
+}
+
+func sameFlowResolveOwner(a, b *adapter.ConnectionOwner) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return a.UserId == b.UserId && a.ProcessID == b.ProcessID && a.UserName == b.UserName &&
+		a.ProcessPath == b.ProcessPath && slices.Equal(a.AndroidPackageNames, b.AndroidPackageNames)
+}
+
+func (a *flowResolveAnswer) matches(metadata *adapter.InboundContext, action *R.RuleActionResolve) bool {
+	options := *action
+	options.RewriteTTL = nil
+	return action == a.action && options == a.options && (action.RewriteTTL != nil) == a.hasTTL &&
+		(!a.hasTTL || *action.RewriteTTL == a.ttl) && a.flow == resolveIdentity(metadata) && sameFlowResolveOwner(a.owner, metadata.ProcessInfo)
+}
+
+func (c *flowResolveClaim) apply(metadata *adapter.InboundContext, action *R.RuleActionResolve) bool {
+	if c == nil || len(c.answers) == 0 {
+		return false
+	}
+	answer := &c.answers[0]
+	if c.ctx.Err() == nil && c.replay.current() && answer.matches(metadata, action) {
+		transport, ok := c.replay.router.dnsTransport.Transport(action.Server)
+		if ok && transport == answer.transport && sameResolveEnvironment(transport, answer.environment) {
+			// Full matching narrows this private list according to the rule it actually selects.
+			metadata.DestinationAddresses = answer.addresses
+			c.answers[0] = flowResolveAnswer{}
+			c.answers = c.answers[1:]
+			return true
+		}
+	}
+	// Full policy took a different path. No later result from the old path is authoritative.
+	c.answers = nil
+	return false
+}
