+func TestLookupFreshCacheUsesOnlyExactLiveMemoryAnswers(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx := context.Background()
+		first := &fakeDNSTransport{tag: "east", address: netip.MustParseAddr("192.0.2.7")}
+		other := &fakeDNSTransport{tag: "west", address: netip.MustParseAddr("192.0.2.8")}
+		r := raceTestRouter(t, first, other)
+		r.defaultDomainStrategy = C.DomainStrategyIPv4Only
+		r.client = NewClient(ClientOptions{Context: ctx, Logger: r.logger, OptimisticTimeout: time.Hour})
+		options := adapter.DNSQueryOptions{Transport: first}
+		name := "warm.example"
+		_, ok := r.LookupFreshCache(ctx, name, options)
+		require.False(t, ok)
+		_, err := r.Lookup(ctx, name, options)
+		require.NoError(t, err)
+		got, ok := r.LookupFreshCache(ctx, name, options)
+		require.True(t, ok)
+		require.Equal(t, []netip.Addr{first.address}, got)
+		for _, restricted := range []adapter.DNSQueryOptions{
+			{}, {Transport: other}, {Transport: dynamicCacheTestTransport{first}}, {Transport: first, DisableCache: true}, {Transport: first, LookupStrategy: C.DomainStrategyPreferIPv6},
+			{Transport: first, ClientSubnet: netip.MustParsePrefix("192.0.2.0/24")},
+		} {
+			_, ok = r.LookupFreshCache(ctx, name, restricted)
+			require.False(t, ok)
+		}
+		time.Sleep(301 * time.Second)
+		_, ok = r.LookupFreshCache(ctx, name, options)
+		require.False(t, ok)
+		synctest.Wait()
+		require.EqualValues(t, 1, first.queryCount.Load())
+		require.Zero(t, other.queryCount.Load())
+		// A stale miss must leave the optimistic entry intact: lookup returns it
+		// while the resolver is still blocked, before refresh can return a new answer.
+		refresh := &heldDNSAnswer{fakeDNSTransport{tag: "east", address: other.address}, make(chan struct{}), make(chan struct{})}
+		done := make(chan []netip.Addr, 1)
+		go func() {
+			stale, _ := r.Lookup(ctx, name, adapter.DNSQueryOptions{Transport: refresh})
+			done <- stale
+		}()
+		<-refresh.started
+		synctest.Wait()
+		select {
+		case stale := <-done:
+			require.Equal(t, got, stale)
+		default:
+			close(refresh.release)
+			t.Fatal("lookup waited on a refresh after the cache probe")
+		}
+		close(refresh.release)
+	})
+}
