+// NarrowDestinationAddresses keeps only the resolved addresses the rule's own destination ip_cidr (or ip_is_private)
+// covers, when that is what matched: one local address in a name's answer must not take its public ones along to a
+// route meant for local ones (unbraid). Called for a matched rule that picks an outbound.
+func (r *abstractDefaultRule) NarrowDestinationAddresses(metadata *adapter.InboundContext) {
+	// Inverted, with a rule set, matched on a DNS answer or by a domain item: what matched is not these items alone.
+	if r.invert || r.ruleSetItem != nil || !r.destinationIPCIDRMatchesDestination(metadata) || metadata.DestinationAddressMatchFromResponse ||
+		metadata.Destination.IsIP() || len(metadata.DestinationAddresses) < 2 || matchAnyItem(r.destinationAddressItems, metadata) {
+		return
+	}
+	covered := common.Filter(metadata.DestinationAddresses, func(address netip.Addr) bool {
+		single := *metadata
+		single.DestinationAddresses = []netip.Addr{address}
+		return matchAnyItem(r.destinationIPCIDRItems, &single)
+	})
+	if len(covered) > 0 {
+		metadata.DestinationAddresses = covered
+	}
+}
+
 func (r *abstractDefaultRule) Action() adapter.RuleAction {
 	return r.action
 }
diff --git a/route/rule/rule_narrow_test.go b/route/rule/rule_narrow_test.go
new file mode 100644
index 0000000..5ab21bd
--- /dev/null
+++ b/route/rule/rule_narrow_test.go
@@ -0,0 +1,63 @@
+package rule
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+
+	"github.com/stretchr/testify/require"
+)
+
+var lanAndPublic = []netip.Addr{netip.MustParseAddr("192.168.1.10"), netip.MustParseAddr("203.0.113.5"), netip.MustParseAddr("fd00::10")}
+
+func resolvedForTest(addresses ...netip.Addr) adapter.InboundContext {
+	metadata := testMetadata("nas.example")
+	metadata.DestinationAddresses = addresses
+	return metadata
+}
+
+// A name whose answer holds a local address and a public one: the local route gets the local ones only.
+func TestNarrowDestinationAddressesKeepsWhatTheRuleCovers(t *testing.T) {
+	t.Parallel()
+	rule := routeRuleForTest(func(rule *abstractDefaultRule) {
+		addDestinationIPCIDRItem(t, rule, []string{"192.168.0.0/16", "fc00::/7"})
+	})
+	metadata := resolvedForTest(lanAndPublic...)
+	require.True(t, rule.Match(&metadata))
+	rule.NarrowDestinationAddresses(&metadata)
+	require.Equal(t, []netip.Addr{lanAndPublic[0], lanAndPublic[2]}, metadata.DestinationAddresses)
+
+	private := routeRuleForTest(func(rule *abstractDefaultRule) { addDestinationIPIsPrivateItem(rule) })
+	metadata = resolvedForTest(lanAndPublic...)
+	require.True(t, private.Match(&metadata))
+	private.NarrowDestinationAddresses(&metadata)
+	require.NotContains(t, metadata.DestinationAddresses, lanAndPublic[1])
+}
+
+// What else matched, not these items alone: every address stays.
+func TestNarrowDestinationAddressesLeavesOtherMatchesAlone(t *testing.T) {
+	t.Parallel()
+	byDomain := routeRuleForTest(func(rule *abstractDefaultRule) {
+		addDestinationAddressItem(t, rule, []string{"nas.example"}, nil)
+		addDestinationIPCIDRItem(t, rule, []string{"192.168.0.0/16"})
+	})
+	inverted := routeRuleForTest(func(rule *abstractDefaultRule) {
+		addDestinationIPCIDRItem(t, rule, []string{"10.0.0.0/8"})
+		rule.invert = true
+	})
+	noAddressRule := routeRuleForTest(func(rule *abstractDefaultRule) { addDestinationPortItem(rule, []uint16{443}) })
+	for _, rule := range []*DefaultRule{byDomain, inverted, noAddressRule} {
+		metadata := resolvedForTest(lanAndPublic...)
+		require.True(t, rule.Match(&metadata))
+		rule.NarrowDestinationAddresses(&metadata)
+		require.Equal(t, lanAndPublic, metadata.DestinationAddresses)
+	}
+
+	// Matched on a DNS answer, not on what the connection dials.
+	lan := routeRuleForTest(func(rule *abstractDefaultRule) { addDestinationIPCIDRItem(t, rule, []string{"192.168.0.0/16"}) })
+	metadata := resolvedForTest(lanAndPublic...)
+	metadata.DestinationAddressMatchFromResponse = true
+	lan.NarrowDestinationAddresses(&metadata)
+	require.Equal(t, lanAndPublic, metadata.DestinationAddresses)
+}
