+// unbraid: a route picked by an address rule dials only the resolved addresses that rule covers.
+func narrowDestinationAddresses(rule adapter.Rule, metadata *adapter.InboundContext) {
+	if narrowing, isNarrowing := rule.(interface {
+		NarrowDestinationAddresses(*adapter.InboundContext)
+	}); isNarrowing {
+		narrowing.NarrowDestinationAddresses(metadata)
+	}
+}
