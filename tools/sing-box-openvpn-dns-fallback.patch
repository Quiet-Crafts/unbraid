@@ -0,0 +1,44 @@
+package openvpn
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	boxDNS "github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/log"
+	ovpntransport "github.com/sagernet/sing-box/transport/openvpn"
+	N "github.com/sagernet/sing/common/network"
+)
+
+// Unbraid: the fallback resolver answers only when the server pushes no DNS configuration at all.
+func TestFallbackOnlyWithoutPushedDNS(t *testing.T) {
+	newTransport := func(fallback string) *DNSTransport {
+		d := &DNSTransport{
+			TransportAdapter: boxDNS.NewTransportAdapter(C.DNSTypeOpenVPN, "test", nil),
+			ctx:              context.Background(),
+			logger:           log.NewNOPFactory().NewLogger("test"),
+			dialer:           N.SystemDialer,
+		}
+		if fallback != "" {
+			d.fallback = netip.MustParseAddr(fallback)
+		}
+		return d
+	}
+	d := newTransport("9.9.9.9")
+	if err := d.updateResolvers(ovpntransport.Configuration{}); err != nil || len(d.defaultResolvers) != 1 {
+		t.Fatalf("no pushed DNS: want the fallback, got %d resolvers, err %v", len(d.defaultResolvers), err)
+	}
+	fallback := d.defaultResolvers[0]
+	if err := d.updateResolvers(ovpntransport.Configuration{DNS: []netip.Addr{netip.MustParseAddr("10.8.0.1")}}); err != nil || len(d.defaultResolvers) != 1 || d.defaultResolvers[0] == fallback {
+		t.Fatalf("pushed DNS must replace the fallback, err %v", err)
+	}
+	if err := d.updateResolvers(ovpntransport.Configuration{DNSRoutes: []string{"corp.example"}}); err == nil {
+		t.Fatal("domain routes without DNS servers must still fail, not use the fallback")
+	}
+	none := newTransport("")
+	if err := none.updateResolvers(ovpntransport.Configuration{}); err != nil || len(none.defaultResolvers) != 0 {
+		t.Fatalf("without a fallback nothing is added, got %d", len(none.defaultResolvers))
+	}
+}
