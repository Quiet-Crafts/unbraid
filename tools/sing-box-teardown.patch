+
+// callWithin runs a handler and gives up waiting after waitLimit (a handler that went on to use the instance can
+// stream until its client leaves); the call's context ends with the test.
+func callWithin(t *testing.T, call func(s *StartedService, ctx context.Context) error, s *StartedService) error {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	done := make(chan error, 1)
+	go func() { done <- call(s, ctx) }()
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(waitLimit):
+		t.Fatal("the handler did not return: it went on to use the instance")
+		return nil
+	}
+}
+
+// A stop that lands after the handler saw the service started, before it reads the instance: refuse, not panic.
+func TestInstanceReadAfterStopIsRefused(t *testing.T) {
+	for _, reader := range instanceReaders {
+		t.Run(reader.name, func(t *testing.T) {
+			s, _ := startTestService(t)
+			hook(t, &beforeInstanceRead, func() { _ = s.CloseService() })
+			if err := callWithin(t, reader.call, s); status.Code(err) != codes.Unavailable {
+				t.Fatalf("want Unavailable, got %v", err)
+			}
+		})
+	}
+}
+
+// A reload parked with the next instance published but not started, when the handler reads it: refuse.
+func TestInstanceReadDuringReloadIsRefused(t *testing.T) {
+	for _, reader := range instanceReaders {
+		t.Run(reader.name, func(t *testing.T) {
+			s, config := startTestService(t)
+			gate := &startGate{entered: make(chan struct{}), release: make(chan struct{})}
+			gateAccess.Lock()
+			currentGate = gate
+			gateAccess.Unlock()
+			reloaded := make(chan error, 1)
+			var releaseOnce sync.Once
+			release := func() { releaseOnce.Do(func() { close(gate.release) }) }
+			t.Cleanup(func() {
+				gateAccess.Lock()
+				currentGate = nil
+				gateAccess.Unlock()
+				release()
+			})
+			hook(t, &beforeInstanceRead, func() {
+				go func() { reloaded <- s.StartOrReloadService(s.ctx, config, nil) }()
+				select {
+				case <-gate.entered:
+				case err := <-reloaded:
+					t.Errorf("reload finished without starting the next instance: %v", err)
+				case <-time.After(waitLimit):
+					t.Error("reload never reached the next instance's start")
+				}
+			})
+			err := callWithin(t, reader.call, s)
+			release()
+			if status.Code(err) != codes.Unavailable {
+				t.Errorf("want Unavailable, got %v", err)
+			}
+			select {
+			case err := <-reloaded:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(waitLimit):
+				t.Fatal("reload did not finish")
+			}
+		})
+	}
+}
+
+// A stop or reload that begins while a handler uses the instance waits for the handler to finish with it, and the
+// handler's long work (a test, a ping) is cut short so the wait stays short.
+func TestInstanceInUseIsNotClosed(t *testing.T) {
+	closers := []struct {
+		name string
+		run  func(s *StartedService, config string) error
+	}{
+		{"Stop", func(s *StartedService, _ string) error { return s.CloseService() }},
+		{"Reload", func(s *StartedService, config string) error { return s.StartOrReloadService(s.ctx, config, nil) }},
+	}
+	for _, closer := range closers {
+		for _, reader := range instanceReaders {
+			t.Run(closer.name+"/"+reader.name, func(t *testing.T) {
+				s, config := startTestService(t)
+				callCtx, cancelCall := context.WithCancel(context.Background())
+				defer cancelCall()
+				busy := make(chan struct{})
+				hook(t, &instanceUseBusy, func() { close(busy) })
+				var closeErr error
+				closerDone := make(chan struct{})
+				leased := false
+				hook(t, &instanceLeased, func() {
+					leased = true
+					go func() {
+						closeErr = closer.run(s, config)
+						close(closerDone)
+						// A stream that outlives its lease (the connections stream) ends with its client.
+						cancelCall()
+					}()
+					select {
+					case <-busy:
+					case <-closerDone:
+						t.Error("the instance was closed while a handler held it")
+					case <-time.After(waitLimit):
+						t.Error("the stop or reload neither waited nor finished")
+					}
+				})
+				callDone := make(chan error, 1)
+				go func() { callDone <- reader.call(s, callCtx) }()
+				select {
+				case <-callDone:
+				case <-time.After(waitLimit):
+					t.Fatal("the handler did not return after the stop or reload began")
+				}
+				if !leased {
+					t.Fatal("the handler never took the instance")
+				}
+				select {
+				case <-closerDone:
+				case <-time.After(waitLimit):
+					t.Fatal("the stop or reload did not finish after the handler returned")
+				}
+				if closeErr != nil {
+					t.Fatal(closeErr)
+				}
+			})
+		}
+	}
+}
+
+// With nothing landing in between, the handlers get past the check and fail on their own terms.
+func TestInstanceReadWhenStartedProceeds(t *testing.T) {
+	s, _ := startTestService(t)
+	if err := s.StartSTUNTest(&STUNTestRequest{OutboundTag: "missing"}, stream[STUNTestProgress](context.Background())); status.Code(err) != codes.NotFound {
+		t.Fatalf("STUN: want NotFound for an unknown outbound, got %v", err)
+	}
+	if _, err := s.TailscaleLogout(context.Background(), &TailscaleLogoutRequest{EndpointTag: "ts"}); status.Code(err) != codes.NotFound {
+		t.Fatalf("logout: want NotFound for an unknown endpoint, got %v", err)
+	}
+	// Every lease ended with its call: a stop does not wait.
+	stopped := make(chan struct{})
+	go func() { _ = s.CloseService(); close(stopped) }()
+	select {
+	case <-stopped:
+	case <-time.After(waitLimit):
+		t.Fatal("stop waited for a lease no handler holds")
+	}
+}
