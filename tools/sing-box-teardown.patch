+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// Stand-in gRPC streams: the handlers under test return before they send or receive anything.
+type testStream[Res any] struct {
+	grpc.ServerStream
+	ctx context.Context
+}
+
+func (s testStream[Res]) Context() context.Context { return s.ctx }
+func (testStream[Res]) Send(*Res) error            { return nil }
+
+type testBidiStream[Req, Res any] struct{ testStream[Res] }
+
+func (testBidiStream[Req, Res]) Recv() (*Req, error) { return nil, io.EOF }
+
+func stream[Res any]() testStream[Res] { return testStream[Res]{ctx: context.Background()} }
+
+func bidi[Req, Res any]() testBidiStream[Req, Res] {
+	return testBidiStream[Req, Res]{stream[Res]()}
+}
+
+const raceTestConfig = `{"log":{"disabled":true},"outbounds":[{"type":"direct","tag":"direct"}]}`
+
+func startTestService(t *testing.T) *StartedService {
+	t.Helper()
+	// The include package imports this one, so the test registers just what its configuration uses.
+	outbounds := outbound.NewRegistry()
+	direct.RegisterOutbound(outbounds)
+	transports := dns.NewTransportRegistry()
+	local.RegisterTransport(transports)
+	ctx := box.Context(context.Background(), inbound.NewRegistry(), outbounds, endpoint.NewRegistry(), transports,
+		service.NewRegistry(), certificate.NewRegistry())
+	s := NewStartedService(ServiceOptions{Context: ctx, LogMaxLines: 16})
+	if err := s.StartOrReloadService(ctx, raceTestConfig, nil); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = s.CloseService()
+		s.Close()
+	})
+	return s
+}
+
+// Every handler that reads the instance after waitForStarted, with a request that reaches that read.
+var instanceReaders = []struct {
+	name string
