diff --git a/experimental/libbox/endpoint_cleanup_test.go b/experimental/libbox/endpoint_cleanup_test.go
new file mode 100644
index 0000000..17100a1
--- /dev/null
+++ b/experimental/libbox/endpoint_cleanup_test.go
@@ -0,0 +1,159 @@
+//go:build with_gvisor && with_wireguard && with_openvpn
+
+package libbox
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"runtime"
+	"runtime/pprof"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	box "github.com/sagernet/sing-box"
+)
+
+// A placeholder WireGuard peer: an all-zero key and a local address, never contacted (the endpoint is not started).
+const cleanupTestEndpoint = `{"type":"wireguard","tag":"wg","address":["10.0.0.2/32"],"private_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","peers":[{"address":"127.0.0.1","port":51820,"public_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","allowed_ips":["0.0.0.0/0"]}]}`
+
+// liveGoroutines returns all live goroutines and those running inside a userspace network stack.
+func liveGoroutines() (all int, stacks int) {
+	var dump strings.Builder
+	_ = pprof.Lookup("goroutine").WriteTo(&dump, 2)
+	for _, goroutine := range strings.Split(dump.String(), "\n\n") {
+		if strings.TrimSpace(goroutine) == "" {
+			continue
+		}
+		all++
+		if strings.Contains(goroutine, "/gvisor/pkg/") {
+			stacks++
+		}
+	}
+	return
+}
+
+// assertNoGrowth runs round 40 times and fails when goroutines, or network-stack goroutines, keep growing.
+func assertNoGrowth(t *testing.T, round func(t *testing.T)) {
+	round(t) // warm up lazily started globals
+	runtime.GC()
+	beforeAll, beforeStacks := liveGoroutines()
+	const rounds = 40
+	for i := 0; i < rounds; i++ {
+		round(t)
+	}
+	var afterAll, afterStacks int
+	for deadline := time.Now().Add(5 * time.Second); ; {
+		runtime.GC()
+		afterAll, afterStacks = liveGoroutines()
+		if (afterAll <= beforeAll+4 && afterStacks <= beforeStacks) || time.Now().After(deadline) {
+			break
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	t.Logf("%d rounds: goroutines %d -> %d, network-stack goroutines %d -> %d", rounds, beforeAll, afterAll, beforeStacks, afterStacks)
+	if afterAll > beforeAll+4 || afterStacks > beforeStacks {
+		t.Fatalf("goroutines grew from %d to %d (network stack %d to %d)", beforeAll, afterAll, beforeStacks, afterStacks)
+	}
+}
+
+func TestCheckConfigReleasesWireGuardStack(t *testing.T) {
+	config := `{"log":{"disabled":true},"endpoints":[` + cleanupTestEndpoint + `]}`
+	assertNoGrowth(t, func(t *testing.T) {
+		if err := CheckConfig(config); err != nil {
+			t.Fatal(err)
+		}
+	})
+}
+
+// The OpenVPN client builds its device and network stack the same way. Static-key mode, placeholder key material.
+func TestCheckConfigReleasesOpenVPNStack(t *testing.T) {
+	lines := []string{"-----BEGIN OpenVPN Static key V1-----"}
+	for i := 0; i < 16; i++ {
+		lines = append(lines, strings.Repeat("0", 32))
+	}
+	lines = append(lines, "-----END OpenVPN Static key V1-----")
+	key, _ := json.Marshal(lines)
+	config := `{"log":{"disabled":true},"endpoints":[{"type":"openvpn-client","tag":"ovpn","server":"127.0.0.1","server_port":1194,` +
+		`"mode":"static_key","network":"udp","address":["10.8.0.2/30"],"peer_address":"10.8.0.1","topology":"p2p",` +
+		`"static_key":` + string(key) + `,"key_direction":"client","cipher":"AES-256-CBC","auth":"SHA256"}]}`
+	assertNoGrowth(t, func(t *testing.T) {
+		if err := CheckConfig(config); err != nil {
+			t.Fatal(err)
+		}
+	})
+}
+
+// A configuration that fails after an endpoint was built (here: a second endpoint without a key) releases it.
+func TestFailedCheckConfigReleasesWireGuardStack(t *testing.T) {
+	broken := `{"type":"wireguard","tag":"broken","address":["10.0.0.3/32"],"peers":[{"address":"127.0.0.1","port":51820,"public_key":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=","allowed_ips":["0.0.0.0/0"]}]}`
+	config := `{"log":{"disabled":true},"endpoints":[` + cleanupTestEndpoint + `,` + broken + `]}`
+	assertNoGrowth(t, func(t *testing.T) {
+		if err := CheckConfig(config); err == nil || !strings.Contains(err.Error(), "private key") {
+			t.Fatalf("want a missing key error, got %v", err)
+		}
+	})
+}
+
+// A WireGuard stack whose constructor fails part way (here: the same address twice) is released too.
+func TestFailedStackConstructorReleasesStack(t *testing.T) {
+	endpoint := strings.Replace(cleanupTestEndpoint, `"address":["10.0.0.2/32"]`, `"address":["10.0.0.2/32","10.0.0.2/32"]`, 1)
+	config := `{"log":{"disabled":true},"endpoints":[` + endpoint + `]}`
+	assertNoGrowth(t, func(t *testing.T) {
+		if err := CheckConfig(config); err == nil {
+			t.Fatal("duplicate local address accepted")
+		}
+	})
+}
+
+// A start that fails before the endpoints' initialize stage (the cache file cannot be opened) releases them.
+func TestStartFailingAtCacheFileReleasesWireGuardStack(t *testing.T) {
+	// The cache file's folder is a regular file, so opening the database fails.
+	blocker := filepath.Join(t.TempDir(), "not-a-folder")
+	if err := os.WriteFile(blocker, nil, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cachePath := strconv.Quote(filepath.Join(blocker, "cache.db"))
+	config := `{"log":{"disabled":true},"experimental":{"cache_file":{"enabled":true,"path":` + cachePath + `}},"endpoints":[` + cleanupTestEndpoint + `]}`
+	assertNoGrowth(t, func(t *testing.T) {
+		ctx := baseContext(nil)
+		options, err := parseConfig(ctx, config)
+		if err != nil {
+			t.Fatal(err)
+		}
+		instance, err := box.New(box.Options{Context: ctx, Options: options})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = instance.Start(); err == nil || !strings.Contains(err.Error(), "cache") {
+			t.Fatalf("start: want a cache file error, got %v", err)
+		}
+		// The caller closes again after a failed start, as the service does: that must stay harmless.
+		_ = instance.Close()
+	})
+}
+
+// A successful start and stop closes the stack once, through the endpoint's own cleanup and the box's.
+func TestStartedBoxReleasesWireGuardStackOnce(t *testing.T) {
+	config := `{"log":{"disabled":true},"endpoints":[` + cleanupTestEndpoint + `]}`
+	assertNoGrowth(t, func(t *testing.T) {
+		ctx := baseContext(nil)
+		options, err := parseConfig(ctx, config)
+		if err != nil {
+			t.Fatal(err)
+		}
+		instance, err := box.New(box.Options{Context: ctx, Options: options})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = instance.Start(); err != nil {
+			t.Fatal(err)
+		}
+		if err = instance.Close(); err != nil {
+			t.Fatal(err)
+		}
+		_ = instance.Close()
+	})
+}
