+// Unbraid: waitForStarted reports that the service started, but a reload or a stop can land before the handler reads
+// the instance, leaving it nil (or the next one, not started yet), and it can close the instance while the handler
+// still uses it. A panic in a handler ends the whole process, and the VPN with it. So a handler takes a lease: the
+// instance is read under the lock and refused unless it is started, and a reload or stop waits for every lease to
+// end before it closes the instance. The lease's context ends as soon as the reload or stop begins, so a long call
+// (a test, a ping, a request to a server) returns early instead of holding the stop up. Call release once the
+// handler no longer uses the instance; calling it again does nothing.
+func (s *StartedService) leaseInstance(ctx context.Context) (instance *Instance, leaseCtx context.Context, release func(), err error) {
+	beforeInstanceRead()
+	s.serviceAccess.RLock()
+	if s.instance == nil || s.serviceStatus == nil || s.serviceStatus.Status != ServiceStatus_STARTED || s.instanceUseCtx == nil {
+		s.serviceAccess.RUnlock()
+		return nil, nil, nil, status.Error(codes.Unavailable, "service not started")
+	}
+	// This never waits: a reload or stop waits for leases only after it took the instance away under the write lock.
+	s.instanceUse.RLock()
+	instance = s.instance
+	leaseCtx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(s.instanceUseCtx, cancel)
+	s.serviceAccess.RUnlock()
+	var once sync.Once
+	release = func() {
+		once.Do(func() {
+			stop()
+			cancel()
+			s.instanceUse.RUnlock()
+		})
+	}
+	instanceLeased()
+	return instance, leaseCtx, release, nil
+}
+
+// takeInstanceUse detaches the lease context of the instance being taken away. Call with serviceAccess held.
+func (s *StartedService) takeInstanceUse() context.CancelFunc {
+	cancel := s.instanceUseCancel
+	s.instanceUseCtx, s.instanceUseCancel = nil, nil
+	return cancel
+}
+
+// endInstanceUse ends the leases on an instance that was just taken away and waits for them, before it is closed.
+// Call without serviceAccess held.
+func (s *StartedService) endInstanceUse(cancel context.CancelFunc) {
+	if cancel != nil {
+		cancel()
+	}
+	if !s.instanceUse.TryLock() {
+		instanceUseBusy()
+		s.instanceUse.Lock()
+	}
+	s.instanceUse.Unlock()
+}
