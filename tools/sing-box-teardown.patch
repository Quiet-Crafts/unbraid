+func (g gateService) Start(stage adapter.StartStage, _ *adapter.Scope) error {
+	gateAccess.Lock()
+	gate := currentGate
+	gateAccess.Unlock()
+	if stage != adapter.StartStateStart || gate == nil {
+		return nil
+	}
+	gate.enterOnce.Do(func() { close(gate.entered) })
+	select {
+	case <-gate.release:
+	case <-g.ctx.Done():
