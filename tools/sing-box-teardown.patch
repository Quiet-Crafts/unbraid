diff --git a/common/stun/stun_cancel_test.go b/common/stun/stun_cancel_test.go
new file mode 100644
index 0000000..80ba9cf
--- /dev/null
+++ b/common/stun/stun_cancel_test.go
@@ -0,0 +1,96 @@
+package stun
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+// A server that takes every request and never answers; it counts what it got.
+func silentServer(t *testing.T) (addr string, requests *atomic.Int32, first <-chan struct{}) {
+	t.Helper()
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+	requests = new(atomic.Int32)
+	got := make(chan struct{})
+	go func() {
+		buf := make([]byte, 1500)
+		for {
+			if _, _, err := conn.ReadFrom(buf); err != nil {
+				return
+			}
+			if requests.Add(1) == 1 {
+				close(got)
+			}
+		}
+	}()
+	return conn.LocalAddr().String(), requests, got
+}
+
+type plainDialer struct{}
+
+func (plainDialer) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	var d net.Dialer
+	return d.DialContext(ctx, network, destination.String())
+}
+
+func (plainDialer) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	return udpConn{conn}, nil
+}
+
+// Run addresses the server with the engine's own address type; a plain socket wants a UDP address.
+type udpConn struct{ net.PacketConn }
+
+func (c udpConn) WriteTo(b []byte, addr net.Addr) (int, error) {
+	if socksaddr, ok := addr.(M.Socksaddr); ok {
+		addr = socksaddr.UDPAddr()
+	}
+	return c.PacketConn.WriteTo(b, addr)
+}
+
+// A test waiting for an answer that never comes returns as soon as its context ends, not after its retries
+// (0.5 + 1 + 2 seconds), and sends nothing after that.
+func TestRunReturnsWhenCancelledMidExchange(t *testing.T) {
+	addr, requests, first := silentServer(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	done := make(chan error, 1)
+	go func() {
+		_, err := Run(Options{Server: addr, Dialer: plainDialer{}, Context: ctx})
+		done <- err
+	}()
+	select {
+	case <-first:
+	case <-time.After(5 * time.Second):
+		t.Fatal("the request never reached the server")
+	}
+	start := time.Now()
+	cancel()
+	select {
+	case err := <-done:
+		if elapsed := time.Since(start); elapsed > 250*time.Millisecond {
+			t.Fatalf("returned %v after the cancel", elapsed)
+		}
+		if err != context.Canceled {
+			t.Fatalf("want context.Canceled, got %v", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("did not return after the cancel")
+	}
+	sent := requests.Load()
+	time.Sleep(1200 * time.Millisecond) // past the first two retransmit times
+	if later := requests.Load(); later != sent {
+		t.Fatalf("%d more requests after the test returned", later-sent)
+	}
+}
diff --git a/daemon/instance_inflight_test.go b/daemon/instance_inflight_test.go
new file mode 100644
index 0000000..91ec5c9
--- /dev/null
+++ b/daemon/instance_inflight_test.go
@@ -0,0 +1,344 @@
+package daemon
+
+import (
+	"context"
+	"net"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/log"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+// A test outbound: its UDP sockets are real, and it records when a socket is opened, when a read is waiting, when
+// that read has finished unwinding, and when its instance closes it, so a test can check the order of the last two.
+type probeOptions struct {
+	Network string `json:"network,omitempty"`
+}
+
+type probeEvent struct {
+	probe int32
+	what  string
+}
+
+// How long a read keeps running after its socket was closed: the call is still inside the engine for that long.
+const probeUnwind = 100 * time.Millisecond
+
+var (
+	probeCount   atomic.Int32
+	probeAccess  sync.Mutex
+	probeEvents  []probeEvent
+	probeReading chan struct{}
+)
+
+func resetProbes(t *testing.T) {
+	probeAccess.Lock()
+	probeEvents = nil
+	probeReading = make(chan struct{})
+	probeAccess.Unlock()
+	probeCount.Store(0)
+}
+
+func probeRecord(probe int32, what string) {
+	probeAccess.Lock()
+	defer probeAccess.Unlock()
+	probeEvents = append(probeEvents, probeEvent{probe, what})
+	if what == "reading" {
+		select {
+		case <-probeReading:
+		default:
+			close(probeReading)
+		}
+	}
+}
+
+// probeSaw reports the position of the first event, or -1.
+func probeSaw(probe int32, what string) int {
+	probeAccess.Lock()
+	defer probeAccess.Unlock()
+	for i, event := range probeEvents {
+		if event == (probeEvent{probe, what}) {
+			return i
+		}
+	}
+	return -1
+}
+
+type probe struct {
+	outbound.Adapter
+	id int32
+}
+
+func newProbe(_ context.Context, _ adapter.Router, _ log.ContextLogger, tag string, options probeOptions) (adapter.Outbound, error) {
+	network := []string{N.NetworkTCP, N.NetworkUDP}
+	if options.Network != "" {
+		network = []string{options.Network}
+	}
+	return &probe{outbound.NewAdapter("test-probe", tag, network, nil), probeCount.Add(1)}, nil
+}
+
+func (p *probe) Start(stage adapter.StartStage, scope *adapter.Scope) error {
+	if stage == adapter.StartStateStart {
+		scope.Add(func() error {
+			probeRecord(p.id, "engine closed")
+			return nil
+		})
+	}
+	return nil
+}
+
+func (*probe) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	return nil, os.ErrInvalid
+}
+
+func (p *probe) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	probeRecord(p.id, "listen")
+	return &probeConn{conn, p.id}, nil
+}
+
+type probeConn struct {
+	net.PacketConn
+	probe int32
+}
+
+// The engine addresses packets with its own address type; a plain socket wants a UDP address.
+func (c *probeConn) WriteTo(b []byte, addr net.Addr) (int, error) {
+	if socksaddr, ok := addr.(M.Socksaddr); ok {
+		addr = socksaddr.UDPAddr()
+	}
+	return c.PacketConn.WriteTo(b, addr)
+}
+
+func (c *probeConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	probeRecord(c.probe, "reading")
+	n, addr, err := c.PacketConn.ReadFrom(b)
+	if err != nil && !os.IsTimeout(err) {
+		time.Sleep(probeUnwind)
+		probeRecord(c.probe, "read returned")
+	}
+	return n, addr, err
+}
+
+// A UDP server that never answers; it counts the requests it got.
+func silentSTUNServer(t *testing.T) (addr string, requests *atomic.Int32) {
+	t.Helper()
+	conn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+	requests = new(atomic.Int32)
+	go func() {
+		buf := make([]byte, 1500)
+		for {
+			if _, _, err := conn.ReadFrom(buf); err != nil {
+				return
+			}
+			requests.Add(1)
+		}
+	}()
+	return conn.LocalAddr().String(), requests
+}
+
+// A stream whose client does not read: Send waits until the client leaves, as gRPC's does once its window is full.
+type stuckStream[Res any] struct {
+	testStream[Res]
+	entered chan struct{}
+	once    sync.Once
+}
+
+func (s *stuckStream[Res]) Send(*Res) error {
+	s.once.Do(func() { close(s.entered) })
+	<-s.ctx.Done()
+	return s.ctx.Err()
+}
+
+var closers = []struct {
+	name string
+	run  func(s *StartedService, config string) error
+}{
+	{"Stop", func(s *StartedService, _ string) error { return s.CloseService() }},
+	{"Reload", func(s *StartedService, config string) error { return s.StartOrReloadService(s.ctx, config, nil) }},
+}
+
+func waitFor(t *testing.T, ch <-chan struct{}, what string) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(waitLimit):
+		t.Fatal(what)
+	}
+}
+
+// A stop or reload arriving while a STUN test waits for an answer that never comes: the test is cut short at once
+// (not after its retries), the stop or reload takes well under the limit, the instance is closed only after the
+// call's read has returned, and the cancelled call sends nothing more.
+func TestSTUNInFlightIsCutShort(t *testing.T) {
+	for _, closer := range closers {
+		t.Run(closer.name, func(t *testing.T) {
+			resetProbes(t)
+			s, config := startTestService(t)
+			server, requests := silentSTUNServer(t)
+			callCtx, cancelCall := context.WithCancel(context.Background())
+			defer cancelCall()
+			callDone := make(chan error, 1)
+			go func() {
+				callDone <- s.StartSTUNTest(&STUNTestRequest{OutboundTag: "probe", Server: server}, stream[STUNTestProgress](callCtx))
+			}()
+			waitFor(t, probeReading, "the STUN test never started reading")
+			deadline := time.Now().Add(waitLimit)
+			for requests.Load() == 0 && time.Now().Before(deadline) {
+				time.Sleep(time.Millisecond)
+			}
+			if requests.Load() == 0 {
+				t.Fatal("the request never reached the server")
+			}
+
+			start := time.Now()
+			if err := closer.run(s, config); err != nil {
+				t.Fatal(err)
+			}
+			elapsed := time.Since(start)
+			t.Logf("%s took %v with a STUN test in flight", closer.name, elapsed)
+			if elapsed >= instanceUseLimit {
+				t.Fatalf("%s took %v, the limit is %v", closer.name, elapsed, instanceUseLimit)
+			}
+			select {
+			case <-callDone:
+			case <-time.After(time.Second):
+				t.Fatal("the STUN test did not return")
+			}
+			returned, closed := probeSaw(1, "read returned"), probeSaw(1, "engine closed")
+			if returned < 0 || closed < 0 {
+				t.Fatalf("read returned at %d, engine closed at %d: want both", returned, closed)
+			}
+			if closed < returned {
+				t.Fatal("the instance was closed while the call was still reading")
+			}
+			sent := requests.Load()
+			time.Sleep(1200 * time.Millisecond) // past the next two retransmit times
+			if later := requests.Load(); later != sent {
+				t.Fatalf("%d more requests after the call was cut short", later-sent)
+			}
+		})
+	}
+}
+
+// A call held past the limit by a client that does not read: the stop goes on at the limit, and the instance stays
+// open until that call ends, then closes. A reload cannot start the next instance before that (it needs the cache
+// file the old one holds), and finishes once the call ended.
+func TestCallPastTheLimitClosesLate(t *testing.T) {
+	saved := instanceUseLimit
+	instanceUseLimit = 300 * time.Millisecond
+	t.Cleanup(func() { instanceUseLimit = saved })
+	for _, closer := range closers {
+		t.Run(closer.name, func(t *testing.T) {
+			resetProbes(t)
+			s, config := startTestService(t)
+			server, requests := silentSTUNServer(t)
+			callCtx, cancelCall := context.WithCancel(context.Background())
+			defer cancelCall()
+			client := &stuckStream[STUNTestProgress]{testStream: stream[STUNTestProgress](callCtx), entered: make(chan struct{})}
+			callDone := make(chan error, 1)
+			go func() {
+				callDone <- s.StartSTUNTest(&STUNTestRequest{OutboundTag: "probe", Server: server}, client)
+			}()
+			waitFor(t, client.entered, "the STUN test never reported progress")
+
+			start := time.Now()
+			closerDone := make(chan error, 1)
+			go func() { closerDone <- closer.run(s, config) }()
+			if closer.name == "Stop" {
+				select {
+				case err := <-closerDone:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(waitLimit):
+					t.Fatal("the stop did not go on at the limit")
+				}
+				elapsed := time.Since(start)
+				t.Logf("stop took %v with a limit of %v", elapsed, instanceUseLimit)
+				if elapsed < instanceUseLimit || elapsed > instanceUseLimit+time.Second {
+					t.Fatalf("stop took %v, want the limit %v", elapsed, instanceUseLimit)
+				}
+			} else {
+				time.Sleep(instanceUseLimit + 500*time.Millisecond)
+			}
+			if probeSaw(1, "engine closed") >= 0 {
+				t.Fatal("the instance was closed while a call still held it")
+			}
+
+			cancelCall()
+			select {
+			case <-callDone:
+			case <-time.After(waitLimit):
+				t.Fatal("the call did not return after its client left")
+			}
+			deadline := time.Now().Add(waitLimit)
+			for probeSaw(1, "engine closed") < 0 && time.Now().Before(deadline) {
+				time.Sleep(10 * time.Millisecond)
+			}
+			if probeSaw(1, "engine closed") < 0 {
+				t.Fatal("the instance was never closed after the call ended")
+			}
+			if closer.name == "Reload" {
+				select {
+				case err := <-closerDone:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(waitLimit):
+					t.Fatal("the reload did not finish")
+				}
+			}
+			if n := requests.Load(); n != 0 {
+				t.Fatalf("%d requests sent by a call whose instance was stopping", n)
+			}
+		})
+	}
+}
+
+// A STUN test on an outbound that carries TCP only is refused before anything is sent.
+func TestSTUNRefusesOutboundWithoutUDP(t *testing.T) {
+	resetProbes(t)
+	s, _ := startTestService(t)
+	server, requests := silentSTUNServer(t)
+	err := s.StartSTUNTest(&STUNTestRequest{OutboundTag: "tcp-only", Server: server}, stream[STUNTestProgress](context.Background()))
+	if status.Code(err) != codes.FailedPrecondition {
+		t.Fatalf("want FailedPrecondition, got %v", err)
+	}
+	if probeSaw(2, "listen") >= 0 || requests.Load() != 0 {
+		t.Fatal("a socket was opened or a request sent")
+	}
+}
+
+// A call whose client already left gets no lease: no socket is opened, nothing is sent.
+func TestCallFromGoneClientDoesNothing(t *testing.T) {
+	resetProbes(t)
+	s, _ := startTestService(t)
+	server, requests := silentSTUNServer(t)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	// waitForStarted returns at once for a started service, whatever the context.
+	err := s.StartSTUNTest(&STUNTestRequest{OutboundTag: "probe", Server: server}, stream[STUNTestProgress](ctx))
+	if status.Code(err) != codes.Canceled {
+		t.Fatalf("want Canceled, got %v", err)
+	}
+	if probeSaw(1, "listen") >= 0 || requests.Load() != 0 {
+		t.Fatal("a socket was opened or a request sent")
+	}
+}
diff --git a/daemon/instance_race_test.go b/daemon/instance_race_test.go
