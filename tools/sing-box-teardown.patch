+// Unbraid: waitForStarted reports that the service started, but a reload or a stop can land before the handler reads
+// the instance, leaving it nil (or the next one, not started yet), and it can close the instance while the handler
+// still uses it. A panic in a handler ends the whole process, and the VPN with it. So a handler takes a lease: the
+// instance is read under the lock and refused unless it is started, and the instance is closed only after every
+// lease on it has ended. The lease's context ends as soon as a reload or stop begins (or the client leaves), and the
+// work done under a lease waits on the network only through that context (a STUN test closes its socket when it
+// ends), so the call returns at once instead of holding the stop up. A call whose client has already left gets no
+// lease, so it never starts its work. Call release once the handler no longer uses the instance; calling it again
+// does nothing.
+func (s *StartedService) leaseInstance(ctx context.Context) (instance *Instance, leaseCtx context.Context, release func(), err error) {
+	beforeInstanceRead()
+	if ctx.Err() != nil {
+		return nil, nil, nil, status.FromContextError(ctx.Err()).Err()
+	}
+	s.serviceAccess.RLock()
+	leases := s.instanceLeases
+	if s.instance == nil || s.serviceStatus == nil || s.serviceStatus.Status != ServiceStatus_STARTED || leases == nil {
+		s.serviceAccess.RUnlock()
+		return nil, nil, nil, status.Error(codes.Unavailable, "service not started")
+	}
+	// A reload or stop ends the leases only after it took them away under the write lock, so this one counts.
+	leases.take()
+	instance = s.instance
+	leaseCtx, cancel := context.WithCancel(ctx)
+	stop := context.AfterFunc(leases.ctx, cancel)
+	s.serviceAccess.RUnlock()
+	var once sync.Once
+	release = func() {
+		once.Do(func() {
+			stop()
+			cancel()
+			leases.give()
+		})
+	}
+	instanceLeased()
+	return instance, leaseCtx, release, nil
+}
+
+// Unbraid: how long a reload or stop waits for the calls still using the instance it takes away. Their contexts end
+// first and everything they wait on ends with them, so they return within milliseconds. Past this limit (only a
+// client that stops reading its stream can hold a call that long) the reload or stop goes on, and the instance is
+// closed by the last of those calls when it ends: never while one still uses it.
+var instanceUseLimit = 2 * time.Second
+
+// instanceLeases counts the calls using one started instance.
+type instanceLeases struct {
+	ctx    context.Context
+	cancel context.CancelFunc
+	access sync.Mutex
+	held   int
+	taken  bool
+	idle   chan struct{} // closed once the instance was taken away and no call holds it
+}
+
+func newInstanceLeases() *instanceLeases {
+	ctx, cancel := context.WithCancel(context.Background())
+	return &instanceLeases{ctx: ctx, cancel: cancel, idle: make(chan struct{})}
+}
+
+func (l *instanceLeases) take() {
+	l.access.Lock()
+	l.held++
+	l.access.Unlock()
+}
+
+func (l *instanceLeases) give() {
+	l.access.Lock()
+	l.held--
+	if l.taken && l.held == 0 {
+		close(l.idle)
+	}
+	l.access.Unlock()
+}
+
+// end cancels every lease and reports whether a call still holds one.
+func (l *instanceLeases) end() (busy bool) {
+	l.cancel()
+	l.access.Lock()
+	defer l.access.Unlock()
+	l.taken = true
+	if l.held == 0 {
+		close(l.idle)
+		return false
+	}
+	return true
+}
+
+// takeInstanceLeases detaches the leases of the instance being taken away. Call with serviceAccess held.
+func (s *StartedService) takeInstanceLeases() *instanceLeases {
+	leases := s.instanceLeases
+	s.instanceLeases = nil
+	return leases
+}
+
+// retireInstance closes an instance that was just taken away, after its leases ended: it waits for them up to
+// instanceUseLimit, and past that leaves the close to the last of them. Call without serviceAccess held.
+func (s *StartedService) retireInstance(instance *Instance, leases *instanceLeases) {
+	if leases != nil && leases.end() {
+		instanceUseBusy()
+		timer := time.NewTimer(instanceUseLimit)
+		defer timer.Stop()
+		select {
+		case <-leases.idle:
+		case <-timer.C:
+			s.WriteMessage(log.LevelWarn, "a call still uses the stopped instance: it is closed when that call ends")
+			go func() {
+				<-leases.idle
+				if instance != nil {
+					_ = instance.Close()
+				}
+			}()
+			return
+		}
+	}
+	if instance != nil {
+		_ = instance.Close()
+	}
+}
