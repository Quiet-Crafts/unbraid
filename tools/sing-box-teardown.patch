+// A stop that lands after the handler saw the service started, before it reads the instance: refuse, not panic.
+func TestInstanceReadAfterStopIsRefused(t *testing.T) {
+	for _, reader := range instanceReaders {
+		t.Run(reader.name, func(t *testing.T) {
+			s, _ := startTestService(t)
+			hook(t, &beforeInstanceRead, func() { _ = s.CloseService() })
+			if err := callWithin(t, reader.call, s); status.Code(err) != codes.Unavailable {
+				t.Fatalf("want Unavailable, got %v", err)
+			}
+		})
+	}
+}
+
+// A reload parked with the next instance published but not started, when the handler reads it: refuse.
+func TestInstanceReadDuringReloadIsRefused(t *testing.T) {
+	for _, reader := range instanceReaders {
+		t.Run(reader.name, func(t *testing.T) {
+			s, config := startTestService(t)
+			gate := &startGate{entered: make(chan struct{}), release: make(chan struct{})}
+			gateAccess.Lock()
+			currentGate = gate
+			gateAccess.Unlock()
+			reloaded := make(chan error, 1)
+			var releaseOnce sync.Once
+			release := func() { releaseOnce.Do(func() { close(gate.release) }) }
+			t.Cleanup(func() {
+				gateAccess.Lock()
+				currentGate = nil
+				gateAccess.Unlock()
+				release()
+			})
+			hook(t, &beforeInstanceRead, func() {
+				go func() { reloaded <- s.StartOrReloadService(s.ctx, config, nil) }()
+				select {
+				case <-gate.entered:
+				case err := <-reloaded:
+					t.Errorf("reload finished without starting the next instance: %v", err)
+				case <-time.After(waitLimit):
+					t.Error("reload never reached the next instance's start")
+				}
+			})
+			err := callWithin(t, reader.call, s)
+			release()
+			if status.Code(err) != codes.Unavailable {
+				t.Errorf("want Unavailable, got %v", err)
+			}
+			select {
+			case err := <-reloaded:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(waitLimit):
+				t.Fatal("reload did not finish")
+			}
+		})
+	}
+}
