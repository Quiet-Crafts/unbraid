+// callWithin runs a handler and gives up waiting after waitLimit (a handler that went on to use the instance can
+// stream until its client leaves); the call's context ends with the test.
+func callWithin(t *testing.T, call func(s *StartedService, ctx context.Context) error, s *StartedService) error {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+	done := make(chan error, 1)
+	go func() { done <- call(s, ctx) }()
+	select {
+	case err := <-done:
+		return err
+	case <-time.After(waitLimit):
+		t.Fatal("the handler did not return: it went on to use the instance")
+		return nil
+	}
+}
