+const waitLimit = 10 * time.Second
+
+// Stand-in gRPC streams. Sends are dropped; a bidirectional stream hands out its first message once, then ends.
+type testStream[Res any] struct {
+	grpc.ServerStream
+	ctx context.Context
+}
+
+func (s testStream[Res]) Context() context.Context { return s.ctx }
+func (testStream[Res]) Send(*Res) error            { return nil }
+
+type testBidiStream[Req, Res any] struct {
+	testStream[Res]
+	first *Req
+}
+
+func (s *testBidiStream[Req, Res]) Recv() (*Req, error) {
+	first := s.first
+	s.first = nil
+	if first == nil {
+		return nil, io.EOF
+	}
+	return first, nil
+}
+
+func stream[Res any](ctx context.Context) testStream[Res] { return testStream[Res]{ctx: ctx} }
+
+func bidi[Req, Res any](ctx context.Context, first *Req) *testBidiStream[Req, Res] {
+	return &testBidiStream[Req, Res]{stream[Res](ctx), first}
+}
+
+// A service that, while a gate is set, holds the box's start until the test releases it: a reload then stays parked
+// with the next instance published and not started.
+type startGate struct {
+	entered, release chan struct{}
+	enterOnce        sync.Once
+}
+
+var (
+	gateAccess  sync.Mutex
+	currentGate *startGate
+)
+
+type gateService struct{ ctx context.Context }
+
+func (gateService) Type() string { return "test-gate" }
+func (gateService) Tag() string  { return "gate" }
+
+func (g gateService) Start(stage adapter.StartStage, _ *adapter.Scope) error {
+	gateAccess.Lock()
+	gate := currentGate
+	gateAccess.Unlock()
+	if stage != adapter.StartStateStart || gate == nil {
+		return nil
+	}
+	gate.enterOnce.Do(func() { close(gate.entered) })
+	select {
+	case <-gate.release:
+	case <-g.ctx.Done():
+	}
+	return nil
+}
+
+func testConfig(t *testing.T) string {
+	t.Helper()
+	config, err := json.Marshal(map[string]any{
+		"log":          map[string]any{"disabled": true},
+		"experimental": map[string]any{"cache_file": map[string]any{"path": filepath.Join(t.TempDir(), "cache.db")}},
+		"outbounds":    []any{map[string]any{"type": "direct", "tag": "direct"}},
+		"services":     []any{map[string]any{"type": "test-gate", "tag": "gate"}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(config)
+}
+
+// startTestService starts a real service with a per-test cache file; config is what a reload uses again.
+func startTestService(t *testing.T) (s *StartedService, config string) {
+	t.Helper()
+	// The include package imports this one, so the test registers just what its configuration uses.
+	outbounds := outbound.NewRegistry()
+	direct.RegisterOutbound(outbounds)
+	transports := dns.NewTransportRegistry()
+	local.RegisterTransport(transports)
+	services := service.NewRegistry()
+	service.Register[struct{}](services, "test-gate", func(ctx context.Context, _ log.ContextLogger, _ string, _ struct{}) (adapter.Service, error) {
+		return gateService{ctx}, nil
+	})
+	ctx := box.Context(context.Background(), inbound.NewRegistry(), outbounds, endpoint.NewRegistry(), transports,
+		services, certificate.NewRegistry())
+	s = NewStartedService(ServiceOptions{Context: ctx, LogMaxLines: 16})
+	config = testConfig(t)
+	if err := s.StartOrReloadService(ctx, config, nil); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		_ = s.CloseService()
+		s.Close()
+	})
+	return s, config
+}
+
+func hook(t *testing.T, target *func(), run func()) {
+	var once sync.Once
+	*target = func() { once.Do(run) }
+	t.Cleanup(func() { *target = func() {} })
+}
+
