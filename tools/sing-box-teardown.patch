@@ -71,9 +71,33 @@ func (m *Manager) Create(ctx context.Context, router adapter.Router, logger log.
 	defer m.access.Unlock()
 	_, loaded := m.endpointByTag[tag]
 	if loaded {
+		closeConstructed(endpoint)
 		return E.New("duplicate endpoint tag: ", tag)
 	}
 	m.endpoints = append(m.endpoints, endpoint)
 	m.endpointByTag[tag] = endpoint
 	return nil
 }
+
+// Unbraid: some endpoints build their network stack or device in the constructor but registered its cleanup only in
+// their initialize stage, so a box closed before that stage (a configuration check, a start that failed earlier, a
+// constructor error further on) left them running. Such endpoints implement CloseConstructed, which releases what
+// the constructor built and runs at most once, so calling it after the endpoint's own cleanup is harmless.
+type constructedCloser interface {
+	CloseConstructed() error
+}
+
+func closeConstructed(endpoint adapter.Endpoint) {
+	if closer, isCloser := endpoint.(constructedCloser); isCloser {
+		_ = closer.CloseConstructed()
+	}
+}
+
+// CloseConstructed releases what the constructors of all created endpoints built. The box calls it last when it
+// closes, and when it fails to build.
+func (m *Manager) CloseConstructed() error {
+	for _, endpoint := range m.Endpoints() {
+		closeConstructed(endpoint)
+	}
+	return nil
+}
