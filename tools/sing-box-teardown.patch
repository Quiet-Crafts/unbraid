index 0000000..894eb38
--- /dev/null
+++ b/daemon/instance_race_test.go
@@ -0,0 +1,367 @@
+package daemon
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/certificate"
+	"github.com/sagernet/sing-box/adapter/endpoint"
+	"github.com/sagernet/sing-box/adapter/inbound"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/adapter/service"
+	"github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing-box/dns/transport/local"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/protocol/direct"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/status"
+)
+
+const waitLimit = 10 * time.Second
+
+// Stand-in gRPC streams. Sends are dropped; a bidirectional stream hands out its first message once, then ends.
+type testStream[Res any] struct {
+	grpc.ServerStream
+	ctx context.Context
+}
+
+func (s testStream[Res]) Context() context.Context { return s.ctx }
+func (testStream[Res]) Send(*Res) error            { return nil }
+
+type testBidiStream[Req, Res any] struct {
+	testStream[Res]
+	first *Req
+}
+
+func (s *testBidiStream[Req, Res]) Recv() (*Req, error) {
+	first := s.first
+	s.first = nil
+	if first == nil {
+		return nil, io.EOF
+	}
+	return first, nil
+}
+
+func stream[Res any](ctx context.Context) testStream[Res] { return testStream[Res]{ctx: ctx} }
+
+func bidi[Req, Res any](ctx context.Context, first *Req) *testBidiStream[Req, Res] {
