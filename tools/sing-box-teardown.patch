+	outbounds := outbound.NewRegistry()
+	direct.RegisterOutbound(outbounds)
+	outbound.Register[probeOptions](outbounds, "test-probe", newProbe)
+	transports := dns.NewTransportRegistry()
+	local.RegisterTransport(transports)
