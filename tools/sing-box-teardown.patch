+}
+
+// pauseAfterWaitForStarted runs land once, in the window between waitForStarted and the instance read.
+func pauseAfterWaitForStarted(t *testing.T, land func()) {
+	var once sync.Once
+	beforeInstanceRead = func() { once.Do(land) }
+	t.Cleanup(func() { beforeInstanceRead = func() {} })
+}
+
+// A stop that lands after the handler saw the service started: the handler must refuse, not panic.
+func TestInstanceReadAfterStopIsRefused(t *testing.T) {
+	for _, reader := range instanceReaders {
+		t.Run(reader.name, func(t *testing.T) {
+			s := startTestService(t)
+			pauseAfterWaitForStarted(t, func() { _ = s.CloseService() })
+			if err := reader.call(s); status.Code(err) != codes.Unavailable {
+				t.Fatalf("want Unavailable, got %v", err)
+			}
+		})
+	}
+}
+
+// A reload that lands in the same window: the old instance is gone and the next one is not started yet.
+func TestInstanceReadDuringReloadIsRefused(t *testing.T) {
+	for _, reader := range instanceReaders {
+		t.Run(reader.name, func(t *testing.T) {
+			s := startTestService(t)
+			reloaded := make(chan error, 1)
+			pauseAfterWaitForStarted(t, func() {
+				go func() { reloaded <- s.StartOrReloadService(s.ctx, raceTestConfig, nil) }()
+				for deadline := time.Now().Add(5 * time.Second); time.Now().Before(deadline); time.Sleep(time.Millisecond) {
+					s.serviceAccess.RLock()
+					moved := s.serviceStatus.Status != ServiceStatus_STARTED
+					s.serviceAccess.RUnlock()
+					if moved {
+						return
+					}
+				}
+				t.Error("reload never began")
+			})
+			if err := reader.call(s); status.Code(err) != codes.Unavailable {
+				t.Fatalf("want Unavailable, got %v", err)
+			}
+			if err := <-reloaded; err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
+}
+
+// With nothing landing in between, the handlers get past the check and fail on their own terms.
+func TestInstanceReadWhenStartedProceeds(t *testing.T) {
+	s := startTestService(t)
+	if err := s.StartSTUNTest(&STUNTestRequest{OutboundTag: "missing"}, stream[STUNTestProgress]()); status.Code(err) != codes.NotFound {
+		t.Fatalf("STUN: want NotFound for an unknown outbound, got %v", err)
+	}
+	if _, err := s.TailscaleLogout(context.Background(), &TailscaleLogoutRequest{EndpointTag: "ts"}); status.Code(err) != codes.NotFound {
+		t.Fatalf("logout: want NotFound for an unknown endpoint, got %v", err)
+	}
+}
