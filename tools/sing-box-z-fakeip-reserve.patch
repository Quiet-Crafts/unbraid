+func InboundDNSQueryOptions(metadata *InboundContext) DNSQueryOptions {
+	owner := metadata.ProcessInfo
+	if metadata.InboundType == C.TypeTun && owner != nil && owner.IndividualApp && owner.UserId > 0 {
+		return DNSQueryOptions{fakeIPCaller: uint32(owner.UserId)}
+	}
+	return DNSQueryOptions{}
+}
