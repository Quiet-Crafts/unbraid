+type fakeIPCallerKey struct{}
+
+// FakeIPCallerBucket returns the app's accounting bucket, or zero for shared callers.
+func FakeIPCallerBucket(ctx context.Context) uint32 {
+	bucket, _ := ctx.Value(fakeIPCallerKey{}).(uint32)
+	return bucket
+}
+
+// Bind the caller only to this exchange's fake-IP transport. A bootstrap
+// lookup inheriting a context but using its own options cannot inherit its charge.
+func (o DNSQueryOptions) ContextForTransport(ctx context.Context, transport DNSTransport) context.Context {
+	bucket := o.fakeIPCaller
+	if bucket != 0 && transport.Type() != C.DNSTypeFakeIP {
+		bucket = 0
+	}
+	if FakeIPCallerBucket(ctx) == bucket {
+		return ctx
+	}
+	return context.WithValue(ctx, fakeIPCallerKey{}, bucket)
+}
