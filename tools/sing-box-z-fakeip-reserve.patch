+
+func TestFakeIPReserveAcrossReload(t *testing.T) {
+	path := t.TempDir() + "/dns.db"
+	query := func(store *Store, name string, rcode int) {
+		t.Helper()
+		transport := Transport{store: store, inet4Enabled: true}
+		q := new(dns.Msg).SetQuestion(name+".test.", dns.TypeA)
+		answer, err := transport.Exchange(context.Background(), q)
+		if err != nil || answer == nil || answer.Rcode != rcode {
+			t.Fatalf("%s: got %v, %v; want rcode %d", name, answer, err, rcode)
+		}
+	}
+	s, c, stop := mustStart(t, path, rangeA)
+	for i := 0; i < 11; i++ {
+		query(s, fmt.Sprint(i), dns.RcodeSuccess)
+	}
+	query(s, "new", dns.RcodeServerFailure)
+	query(s, "1", dns.RcodeSuccess)
+	if Remaining() != 2 || c.FakeIPTrouble() {
+		t.Fatalf("denial left %d, trouble %t", Remaining(), c.FakeIPTrouble())
+	}
+	stop()
+	s, c, stop = mustStart(t, path, rangeA)
+	query(s, "new", dns.RcodeServerFailure)
+	query(s, "1", dns.RcodeSuccess)
+	if Remaining() != 2 || c.FakeIPTrouble() {
+		t.Fatal("reload changed reserve")
+	}
+	stop()
+	s, _, stop = mustStart(t, path, rangeB)
+	defer stop()
+	query(s, "new", dns.RcodeSuccess)
+}
+
+func TestFakeIPReserveSharedNamesAndFamilies(t *testing.T) {
+	s := NewStore(context.Background(), logger.NOP(), rangeA, netip.MustParsePrefix("fd00::/124"))
+	if err := s.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	for _, v6 := range []bool{false, true} {
+		for i := 0; i < 10; i++ {
+			if _, err := s.create(fmt.Sprintf("common%d.test", i), v6, 7, true); err != nil {
+				t.Fatal(err)
+			}
+		}
+		first, err := s.create("reserved.test", v6, 7, true)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, uid := range []uint32{0, 7, 42} {
+			if again, err := s.create("reserved.test", v6, uid, true); err != nil || again != first {
+				t.Fatalf("shared hit: %s, %v", again, err)
+			}
+		}
+		if _, err := s.create("second.test", v6, 7, true); err != adapter.ErrFakeIPAllowance {
+			t.Fatalf("quota: %v", err)
+		}
+		if _, err := s.create("second.test", v6, 42, true); err != nil {
+			t.Fatal(err)
+		}
+		if owner, ok := s.Lookup(first); !ok || owner != "reserved.test" {
+			t.Fatalf("old mapping: %s", owner)
+		}
+	}
+}
+
+func TestFakeIPReserveConcurrentSharedName(t *testing.T) {
+	s := NewStore(context.Background(), logger.NOP(), rangeA, netip.Prefix{})
+	if err := s.Start(); err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	for i := 0; i < 10; i++ {
+		if _, err := s.Create(fmt.Sprint(i), false); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var wg sync.WaitGroup
+	var answers [4]netip.Addr
+	start := make(chan struct{})
+	for i := range answers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			addr, err := s.create("shared.test", false, uint32(i+1), true)
+			if err != nil {
+				t.Error(err)
+			}
+			answers[i] = addr
+		}()
+	}
+	close(start)
+	wg.Wait()
+	for _, addr := range answers {
+		if addr != answers[0] {
+			t.Fatalf("multiple mappings: %v", answers)
+		}
+	}
+	counts := s.storage.(*MemoryStorage).reserve[0]
+	if Remaining() != 2 || len(counts.used) != 1 {
+		t.Fatalf("left %d, charged identities %d", Remaining(), len(counts.used))
+	}
+}
+
+func TestFakeIPReserveStartsOnOldDatabaseRemainder(t *testing.T) {
+	path := t.TempDir() + "/cache.db"
+	// Simulate the old format. Keep 3 of 29 addresses free: much less than
+	// the normal 7-position reserve on this range.
+	prefix := netip.MustParsePrefix("198.18.0.0/27")
+	s, c, stop := mustStart(t, path, prefix)
+	for i := 0; i < 26; i++ {
+		if _, err := s.Create(fmt.Sprint(i), false); err != nil {
+			t.Fatal(err)
+		}
+	}
+	stop()
+	s, c, stop = mustStart(t, path, prefix)
+	defer stop()
+	if _, err := s.create("a", false, 0, true); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := s.create("b", false, 0, true); err != adapter.ErrFakeIPAllowance {
+		t.Fatalf("shared limit: %v", err)
+	}
+	for _, uid := range []uint32{32, 33} {
+		if _, err := s.create(fmt.Sprint("healthy", uid), false, uid, true); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if Remaining() != 0 || c.FakeIPTrouble() {
+		t.Fatal("unexpected capacity or store failure")
+	}
+}
+
+func TestFakeIPReserveSizes(t *testing.T) {
+	for _, tc := range []struct {
+		prefix string
+		wanted int64
+	}{
+		{"198.18.0.0/18", 4095}, {"198.18.0.0/27", 7}, {"198.18.0.0/30", 0}, {"fd00::/64", 4095},
+	} {
+		prefix := netip.MustParsePrefix(tc.prefix)
+		last := broadcastAddress(prefix)
+		got := addressesBetween(reserveStart(prefix, last).Prev(), last)
+		if got != tc.wanted {
+			t.Fatalf("%s: reserve %d", tc.prefix, got)
+		}
+	}
+	if (adapter.FakeIPReserve{}).Allowance(4095) != 1023 || (adapter.FakeIPReserve{Caller: 1}).Allowance(4095) != 511 {
+		t.Fatal("unexpected /18 budget")
+	}
+}
