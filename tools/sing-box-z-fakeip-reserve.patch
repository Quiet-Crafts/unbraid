diff --git a/route/dns_caller_test.go b/route/dns_caller_test.go
new file mode 100644
index 0000000..4310e14
--- /dev/null
+++ b/route/dns_caller_test.go
@@ -0,0 +1,115 @@
+package route
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net"
+	"testing"
+
+	mDNS "github.com/miekg/dns"
+	"github.com/sagernet/sing-box/adapter"
+	C "github.com/sagernet/sing-box/constant"
+	D "github.com/sagernet/sing-box/dns"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/stretchr/testify/require"
+)
+
+type callerTransport struct {
+	adapter.DNSTransport
+	kind  string
+	calls chan uint32
+}
+
+func (d *callerTransport) Type() string { return d.kind }
+func (d *callerTransport) Tag() string  { return "test" }
+func (d *callerTransport) Exchange(ctx context.Context, msg *mDNS.Msg) (*mDNS.Msg, error) {
+	d.calls <- adapter.FakeIPCallerBucket(ctx)
+	return new(mDNS.Msg).SetReply(msg), nil
+}
+
+type callerDNS struct {
+	adapter.DNSRouter
+	client    *D.Client
+	transport *callerTransport
+}
+
+func (d callerDNS) ExchangeAsync(ctx context.Context, msg *mDNS.Msg, opts adapter.DNSQueryOptions, _ func(*mDNS.Msg, error)) {
+	// Only record the caller reaching the actual DNS client's transport.
+	_, _ = d.client.Exchange(ctx, d.transport, msg, opts, nil)
+}
+
+type oneQuestionConn struct {
+	N.PacketConn
+	data []byte
+}
+
+func (c *oneQuestionConn) ReadPacket(b *buf.Buffer) (M.Socksaddr, error) {
+	if c.data == nil {
+		return M.Socksaddr{}, io.EOF
+	}
+	_, err := b.Write(c.data)
+	c.data = nil
+	return M.ParseSocksaddr("192.0.2.2:5555"), err
+}
+func (*oneQuestionConn) Close() error { return nil }
+
+func TestFakeIPCallerAcrossDNSHijacks(t *testing.T) {
+	ctx := context.Background()
+	transport := &callerTransport{kind: C.DNSTypeFakeIP, calls: make(chan uint32, 8)}
+	r := flowTestRouter(flowTestDNS{})
+	r.dns = callerDNS{client: D.NewClient(D.ClientOptions{Context: ctx, DisableCache: true}), transport: transport}
+	meta := adapter.InboundContext{InboundType: C.TypeTun, ProcessInfo: &adapter.ConnectionOwner{UserId: 110005, IndividualApp: true}}
+	msg := new(mDNS.Msg).SetQuestion("one.example.", mDNS.TypeA)
+	payload, err := msg.Pack()
+	require.NoError(t, err)
+	r.HijackDNSPacket(ctx, payload, nil, meta)
+	r.hijackDNSPacket(ctx, &oneQuestionConn{data: payload}, nil, meta, nil)
+	client, server := net.Pipe()
+	defer server.Close()
+	go func() {
+		defer client.Close()
+		_ = binary.Write(client, binary.BigEndian, uint16(len(payload)))
+		_, _ = client.Write(payload)
+	}()
+	require.NoError(t, r.hijackDNSStream(ctx, server, meta))
+	require.Len(t, transport.calls, 3)
+	for range 3 {
+		require.EqualValues(t, 110005, <-transport.calls)
+	}
+}
+
+func TestFakeIPCallerIsScopedToTheInboundExchange(t *testing.T) {
+	ctx := context.Background()
+	fake := &callerTransport{kind: C.DNSTypeFakeIP, calls: make(chan uint32, 1)}
+	plain := &callerTransport{kind: C.DNSTypeLocal, calls: make(chan uint32, 1)}
+	individual := &adapter.ConnectionOwner{UserId: 110005, IndividualApp: true}
+	opts := adapter.InboundDNSQueryOptions(&adapter.InboundContext{InboundType: C.TypeTun, ProcessInfo: individual})
+	prior := opts.ContextForTransport(ctx, fake)
+	require.EqualValues(t, 110005, adapter.FakeIPCallerBucket(prior))
+	for _, tc := range []struct {
+		label, inbound string
+		owner          *adapter.ConnectionOwner
+		want           uint32
+	}{
+		{"another user", C.TypeTun, &adapter.ConnectionOwner{UserId: 10005, IndividualApp: true}, 10005},
+		{"shared or system", C.TypeTun, &adapter.ConnectionOwner{UserId: 110005}, 0},
+		{"missing owner", C.TypeTun, nil, 0}, {"missing UID", C.TypeTun, &adapter.ConnectionOwner{UserId: -1, IndividualApp: true}, 0},
+		{"Tailscale", C.TypeTailscale, individual, 0}, {"internal", "", individual, 0},
+	} {
+		t.Run(tc.label, func(t *testing.T) {
+			next := adapter.InboundDNSQueryOptions(&adapter.InboundContext{InboundType: tc.inbound, ProcessInfo: tc.owner})
+			require.Equal(t, tc.want, adapter.FakeIPCallerBucket(next.ContextForTransport(prior, fake)))
+		})
+	}
+	client := D.NewClient(D.ClientOptions{Context: ctx, DisableCache: true})
+	msg := new(mDNS.Msg).SetQuestion("nested.example.", mDNS.TypeA)
+	_, err := client.Exchange(prior, plain, msg.Copy(), opts, nil)
+	require.NoError(t, err)
+	require.Zero(t, <-plain.calls)
+	_, err = client.Exchange(prior, fake, msg.Copy(), adapter.DNSQueryOptions{}, nil)
+	require.NoError(t, err)
+	require.Zero(t, <-fake.calls)
+}
