+// Admission starts strictly below the app's quarter-full rotation watermark.
+// Cap bookkeeping even when a larger range is configured.
+func reserveStart(prefix netip.Prefix, last netip.Addr) netip.Addr {
+	capacity := addressesBetween(prefix.Addr().Next(), last)
+	count := min(int64(4095), max(int64(0), (capacity-1)/4))
+	raw := last.As16()
+	n := new(big.Int).SetBytes(raw[:])
+	n.Sub(n, big.NewInt(count)).FillBytes(raw[:])
+	return netip.AddrFrom16(raw).Unmap()
+}
