diff --git a/stack_gvisor_icmp_translate.go b/stack_gvisor_icmp_translate.go
new file mode 100644
index 0000000..dec0f29
--- /dev/null
+++ b/stack_gvisor_icmp_translate.go
@@ -0,0 +1,91 @@
+//go:build with_gvisor
+
+package tun
+
+import (
+	"math"
+
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+)
+
+// Forward only the transport's admitted echo. The active dispatcher owns the
+// port's return path and assigns distinct echo IDs when aliases share an answer.
+func (f *ICMPForwarder) forwardTranslatedEcho(key icmpFlowKey, pkt *stack.PacketBuffer, verdict FlowVerdict) {
+	raw, packet, ok := translatedEchoPacket(key, pkt)
+	if !ok {
+		return
+	}
+	f.dispatcher.installVerdict(packet.flowKey(), &packet, raw, verdict)
+	f.dispatcher.Flush()
+}
+
+// An established aliased echo may arrive whole or reassembled on later sends.
+// Share its normal idle timer, return selector, and reset with raw dispatch.
+func (f *ICMPForwarder) forwardCachedTranslation(key icmpFlowKey, pkt *stack.PacketBuffer) bool {
+	d := f.dispatcher
+	if d == nil {
+		return false
+	}
+	k := key.flowKey()
+	d.access.Lock()
+	entry := d.table[k]
+	if entry == nil || entry.action != ActionFlow || !entry.flow.dnatAddress || d.entryExpired(entry, d.now()) {
+		d.access.Unlock()
+		return false
+	}
+	raw, packet, ok := translatedEchoPacket(key, pkt)
+	if ok {
+		d.handleHit(k, entry, &packet, raw, d.now())
+	}
+	d.access.Unlock()
+	d.Flush()
+	return true
+}
+
+func translatedEchoPacket(key icmpFlowKey, pkt *stack.PacketBuffer) ([]byte, forwardPacket, bool) {
+	network := pkt.NetworkHeader().Slice()
+	transport := pkt.TransportHeader().Slice()
+	length := len(transport) + pkt.Data().Size()
+	if key.v6 {
+		if len(network) < header.IPv6MinimumSize || length > math.MaxUint16 {
+			return nil, forwardPacket{}, false
+		}
+		// After reassembly the first fragment's network header remains attached.
+		// Strip only a sole fragment header immediately preceding the echo.
+		switch uint8(header.IPv6(network).TransportProtocol()) {
+		case uint8(header.ICMPv6ProtocolNumber):
+			if len(network) != header.IPv6MinimumSize {
+				return nil, forwardPacket{}, false
+			}
+		case uint8(header.IPv6FragmentExtHdrIdentifier):
+			if len(network) != header.IPv6MinimumSize+header.IPv6FragmentHeaderSize || network[header.IPv6MinimumSize] != uint8(header.ICMPv6ProtocolNumber) {
+				return nil, forwardPacket{}, false
+			}
+		default:
+			return nil, forwardPacket{}, false
+		}
+		network = network[:header.IPv6MinimumSize]
+	} else if len(network) < header.IPv4MinimumSize || len(network) != int(header.IPv4(network).HeaderLength()) || length+len(network) > math.MaxUint16 {
+		return nil, forwardPacket{}, false
+	}
+	raw := make([]byte, 0, len(network)+length)
+	raw = append(raw, network...)
+	raw = append(raw, transport...)
+	raw = append(raw, pkt.Data().AsRange().ToSlice()...)
+	if key.v6 {
+		h := header.IPv6(raw)
+		h.SetNextHeader(uint8(header.ICMPv6ProtocolNumber))
+		h.SetPayloadLength(uint16(length))
+	} else {
+		h := header.IPv4(raw)
+		h.SetTotalLength(uint16(len(raw)))
+		h.SetChecksum(0)
+		h.SetChecksum(^h.CalculateChecksum())
+	}
+	packet, ok := parseForwardPacket(raw)
+	if !ok || packet.fragment || !packet.hasFlow || packet.flowKey() != key.flowKey() {
+		return nil, forwardPacket{}, false
+	}
+	return raw, packet, true
+}
diff --git a/stack_gvisor_icmp_translate_test.go b/stack_gvisor_icmp_translate_test.go
new file mode 100644
index 0000000..932b232
--- /dev/null
+++ b/stack_gvisor_icmp_translate_test.go
@@ -0,0 +1,41 @@
+//go:build with_gvisor
+
+package tun
+
+import (
+	"net/netip"
+	"testing"
+
+	"github.com/sagernet/sing-tun/gtcpip/header"
+)
+
+// Two ordinary requests for the same tuple can finish different stages of
+// admission independently. A late positive must preserve a live refusal.
+func TestEchoKeepsLiveRefusal(t *testing.T) {
+	raw := make([]byte, header.IPv4MinimumSize+header.ICMPv4MinimumSize)
+	ip := header.IPv4(raw)
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(header.ICMPv4ProtocolNumber),
+		SrcAddr: netip.MustParseAddr("192.0.2.1"), DstAddr: netip.MustParseAddr("198.51.100.2"),
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	echo := header.ICMPv4(ip.Payload())
+	echo.SetType(header.ICMPv4Echo)
+	echo.SetIdent(43)
+	echo.SetChecksum(header.ICMPv4Checksum(echo, 0))
+	packet, ok := parseForwardPacket(raw)
+	if !ok || !packet.hasFlow {
+		t.Fatal("invalid test echo")
+	}
+	for _, action := range []FlowAction{ActionDrop, ActionReject} {
+		d := NewForwardDispatcher(nil, &pendingTestWriteback{}, nil, 0, 0)
+		key := packet.flowKey()
+		d.installVerdict(key, &packet, raw, FlowVerdict{Action: action})
+		entry := d.table[key]
+		handled := d.installVerdict(key, &packet, raw, FlowVerdict{Action: ActionFlow, Destination: netip.MustParseAddrPort("192.0.2.2:43")})
+		if !handled || d.table[key] != entry || entry.action != action {
+			t.Fatalf("late approval replaced refusal %v", action)
+		}
+		d.Close()
+	}
+}
