index 0000000..3ab21b7
--- /dev/null
+++ b/stack_gvisor_transport_policy_test.go
@@ -0,0 +1,362 @@
+//go:build with_gvisor
+
+package tun
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/buffer"
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/link/channel"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+	"github.com/sagernet/gvisor/pkg/tcpip/transport/tcp"
+	"github.com/sagernet/sing/common/buf"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+type transportTestPolicy struct {
+	Handler
+	decide  func(uint8, netip.AddrPort, []byte) (FlowVerdict, *PendingFlowDecision)
+	sockets chan transportTestSocket
+	streams chan netip.AddrPort
+}
+
+type transportTestSocket struct {
+	ctx  context.Context
+	conn N.PacketConn
+}
+
+func (h *transportTestPolicy) BeginFlow(network uint8, _, destination netip.AddrPort, payload []byte) (FlowVerdict, *PendingFlowDecision) {
+	return h.decide(network, destination, payload)
+}
+
+func (h *transportTestPolicy) NewPacketConnectionEx(ctx context.Context, conn N.PacketConn, _, _ M.Socksaddr, _ N.CloseHandlerFunc) {
+	h.sockets <- transportTestSocket{ctx, conn}
+}
+
+func (h *transportTestPolicy) NewConnectionEx(_ context.Context, conn net.Conn, _ M.Socksaddr, dst M.Socksaddr, _ N.CloseHandlerFunc) {
+	h.streams <- dst.AddrPort()
+	conn.Close()
+}
+
+func testReceive[T any](t *testing.T, ch <-chan T) T {
+	t.Helper()
+	select {
+	case v := <-ch:
+		return v
+	case <-time.After(3 * time.Second):
+		t.Fatal("timed out waiting for the transport")
+		var zero T
+		return zero
+	}
+}
+
+func checkTransportError(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func checkTransportEqual[T comparable](t *testing.T, want, got T) {
+	t.Helper()
+	if got != want {
+		t.Fatalf("got %v, want %v", got, want)
+	}
+}
+
+type transportTestKey struct{}
+
+func TestReassembledUDPPolicyAndBindings(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	var queries, phase atomic.Int32
+	observedPhase := make(chan int32, 1)
+	healthy := make(chan []byte, 1)
+	h := &transportTestPolicy{sockets: make(chan transportTestSocket, 8)}
+	h.decide = func(network uint8, dst netip.AddrPort, input []byte) (FlowVerdict, *PendingFlowDecision) {
+		queries.Add(1)
+		if dst.Port() == 105 {
+			observedPhase <- phase.Load()
+			return FlowVerdict{Action: ActionDrop}, nil
+		}
+		if dst.Port() == 101 {
+			healthy <- append([]byte(nil), input...)
+			return FlowVerdict{Action: ActionDrop}, nil
+		}
+		if dst.Port() == 102 {
+			if phase.Load() != 0 {
+				// Destination binding must survive a missing optional replay receipt.
+				return FlowVerdict{Action: ActionAccept, DestinationBound: true}, nil
+			}
+			return FlowVerdict{}, &PendingFlowDecision{Resolver: "test", Resolve: func(ctx context.Context) FlowVerdict {
+				close(started)
+				select {
+				case <-release:
+				case <-ctx.Done():
+					return FlowVerdict{Action: ActionDrop}
+				}
+				return FlowVerdict{Action: ActionAccept, DestinationBound: true, RouteContext: func(ctx context.Context) context.Context {
+					return context.WithValue(ctx, transportTestKey{}, dst)
+				}}
+			}}
+		}
+		return FlowVerdict{Action: ActionAccept}, nil
+	}
+	ep := channel.New(16, 1500, "")
+	ip, err := NewGVisorStack(ep)
+	checkTransportError(t, err)
+	defer func() { ip.Close(); ip.Wait(); ep.Close() }()
+	f := NewUDPForwarder(context.Background(), ip, h, UDPNatOptions{Timeout: time.Minute, Shared: true})
+	f.decisions = new(flowDecisionQueue)
+	checkTransportError(t, f.Start())
+	defer func() { f.decisions.invalidate(true); f.Close() }()
+	ip.SetTransportProtocolHandler(header.UDPProtocolNumber, f.HandlePacket)
+	src := tcpip.AddrFrom4([4]byte{192, 0, 2, 2})
+	dst := tcpip.AddrFrom4([4]byte{198, 51, 100, 3})
+	inject := func(id, offset uint16, more bool, data []byte) {
+		raw := make([]byte, header.IPv4MinimumSize+len(data))
+		ip4 := header.IPv4(raw)
+		var flags uint8
+		if more {
+			flags = header.IPv4FlagMoreFragments
+		}
+		ip4.Encode(&header.IPv4Fields{ID: id, TotalLength: uint16(len(raw)), Flags: flags, FragmentOffset: offset, TTL: 64, Protocol: uint8(header.UDPProtocolNumber), SrcAddr: src, DstAddr: dst})
+		ip4.SetChecksum(^ip4.CalculateChecksum())
+		copy(ip4.Payload(), data)
+		p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(raw)})
+		ep.InjectInbound(header.IPv4ProtocolNumber, p)
+		p.DecRef()
+	}
+	body := func(port uint16) []byte {
+		raw := make([]byte, header.UDPMinimumSize+16)
+		header.UDP(raw).Encode(&header.UDPFields{SrcPort: 40000, DstPort: port, Length: uint16(len(raw))})
+		copy(raw[8:], []byte("abcdefghijklmnop"))
+		return raw
+	}
+	send := func(id, port uint16, split bool) {
+		raw := body(port)
+		if split {
+			inject(id, 0, true, raw[:16])
+			inject(id, 16, false, raw[16:])
+		} else {
+			inject(id, 0, false, raw)
+		}
+	}
+	read := func(s transportTestSocket, port uint16) {
+		b := buf.New()
+		defer b.Release()
+		checkTransportError(t, s.conn.SetReadDeadline(time.Now().Add(3*time.Second)))
+		address, e := s.conn.ReadPacket(b)
+		checkTransportError(t, e)
+		checkTransportEqual(t, port, address.Port)
+		checkTransportEqual(t, "abcdefghijklmnop", string(b.Bytes()))
+	}
+	send(1, 102, true)
+	testReceive(t, started)
+	send(2, 101, false)
+	checkTransportEqual(t, "abcdefghijklmnop", string(testReceive(t, healthy)))
+	send(3, 103, false)
+	ordinary := testReceive(t, h.sockets)
+	read(ordinary, 103)
+	checkTransportEqual(t, true, ordinary.ctx.Value(transportTestKey{}) == nil)
+	send(4, 104, false)
+	read(ordinary, 104) // ordinary endpoint-independent mapping still shares the socket
+	close(release)
+	bound := testReceive(t, h.sockets)
+	read(bound, 102)
+	checkTransportEqual(t, uint16(102), bound.ctx.Value(transportTestKey{}).(netip.AddrPort).Port())
+	before := queries.Load()
+	send(5, 102, false)
+	read(bound, 102)
+	checkTransportEqual(t, before, queries.Load())
+	// Fragments have no policy authority. A partially assembled packet that
+	// survives retirement must first be judged in the new generation.
+	partial := body(105)
+	inject(8, 0, true, partial[:16])
+	checkTransportEqual(t, 0, len(observedPhase))
+	checkTransportError(t, N.ReportHandshakeSuccess(ordinary.conn))
+	f.decisions.invalidate(false)
+	testReceive(t, bound.ctx.Done())
+	checkTransportEqual(t, context.Canceled, N.ReportHandshakeSuccess(bound.conn))
+	checkTransportError(t, ordinary.ctx.Err())
+	phase.Store(1)
+	inject(8, 16, false, partial[16:])
+	checkTransportEqual(t, 1, testReceive(t, observedPhase))
+	send(9, 102, false)
+	replacement := testReceive(t, h.sockets)
+	read(replacement, 102)
+	checkTransportEqual(t, false, replacement.conn == bound.conn || replacement.conn == ordinary.conn)
+	send(10, 104, false)
+	read(ordinary, 104)
+}
+
+func TestTransportPendingSYNUsesNoHandshakeSlot(t *testing.T) {
+	started, retired := make(chan struct{}), make(chan struct{})
+	var attempts atomic.Int32
+	h := &transportTestPolicy{streams: make(chan netip.AddrPort, 3)}
+	h.decide = func(_ uint8, dst netip.AddrPort, _ []byte) (FlowVerdict, *PendingFlowDecision) {
+		if dst.Port() == 210 && attempts.Add(1) == 1 {
+			return FlowVerdict{}, &PendingFlowDecision{Resolver: "test", Resolve: func(ctx context.Context) FlowVerdict {
+				close(started)
+				<-ctx.Done()
+				close(retired)
+				return FlowVerdict{Action: ActionAccept}
+			}}
+		}
+		return FlowVerdict{Action: ActionAccept}, nil
+	}
+	ep := channel.New(16, 1500, "")
+	ip, err := NewGVisorStack(ep)
+	checkTransportError(t, err)
+	defer func() { ip.Close(); ip.Wait(); ep.Close() }()
+	f := NewTCPForwarder(context.Background(), ip, h)
+	f.forwarder = tcp.NewForwarder(ip, 0, 1, f.Forward)
+	f.decisions = new(flowDecisionQueue)
+	defer f.decisions.invalidate(true)
+	send := func(port uint16, seq uint32) {
+		id, p := testTransportSYN(port, seq)
+		checkTransportEqual(t, true, f.HandlePacket(id, p))
+		p.DecRef()
+	}
+	send(210, 1)
+	testReceive(t, started)
+	send(210, 1)
+	send(211, 1)
+	checkTransportEqual(t, uint16(211), testReceive(t, h.streams).Port())
+	send(210, 2)
+	testReceive(t, retired)
+	checkTransportEqual(t, uint16(210), testReceive(t, h.streams).Port())
+	f.decisions.workers.Wait()
+	checkTransportEqual(t, 2, attempts.Load())
+	checkTransportEqual(t, 0, len(h.streams))
+}
+
+func TestTransportHandshakeLeaseRetiresOnlyPending(t *testing.T) {
+	generation, retire := context.WithCancel(context.Background())
+	pending, later := newFlowHandshakeLease(context.Background(), generation)
+	established, first := newFlowHandshakeLease(context.Background(), generation)
+	checkTransportEqual(t, true, first.claim())
+	retire()
+	testReceive(t, pending.Done())
+	checkTransportEqual(t, false, later.claim())
+	checkTransportError(t, established.Err())
+	first.close()
+	later.close()
+}
+
+func TestTransportPendingEchoWaitsForAuthorization(t *testing.T) {
+	started, release := make(chan struct{}), make(chan struct{})
+	h := &transportTestPolicy{}
+	h.decide = func(_ uint8, dst netip.AddrPort, _ []byte) (FlowVerdict, *PendingFlowDecision) {
+		if dst.Port() == 11 {
+			return FlowVerdict{}, &PendingFlowDecision{Resolver: "test", Resolve: func(ctx context.Context) FlowVerdict {
+				close(started)
+				select {
+				case <-release:
+					return FlowVerdict{Action: ActionAccept}
+				case <-ctx.Done():
+					return FlowVerdict{Action: ActionDrop}
+				}
+			}}
+		}
+		return FlowVerdict{Action: ActionAccept}, nil
+	}
+	ep := channel.New(16, 1500, "")
+	ip, err := NewGVisorStack(ep)
+	checkTransportError(t, err)
+	defer func() { ip.Close(); ip.Wait(); ep.Close() }()
+	f := NewICMPForwarder(ip, h, nil)
+	f.decisions = new(flowDecisionQueue)
+	defer func() { f.decisions.invalidate(true); f.Close() }()
+	ip.SetTransportProtocolHandler(header.ICMPv4ProtocolNumber, f.HandlePacket)
+	request := func(identifier uint16) {
+		raw := make([]byte, header.IPv4MinimumSize+header.ICMPv4MinimumSize)
+		iph := header.IPv4(raw)
+		iph.Encode(&header.IPv4Fields{TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(header.ICMPv4ProtocolNumber), SrcAddr: tcpip.AddrFrom4([4]byte{192, 0, 2, 2}), DstAddr: tcpip.AddrFrom4([4]byte{198, 51, 100, 5})})
+		iph.SetChecksum(^iph.CalculateChecksum())
+		icmp := header.ICMPv4(iph.Payload())
+		icmp.SetType(header.ICMPv4Echo)
+		icmp.SetIdent(identifier)
+		icmp.SetChecksum(header.ICMPv4Checksum(icmp, 0))
+		p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(raw)})
+		ep.InjectInbound(header.IPv4ProtocolNumber, p)
+		p.DecRef()
+	}
+	reply := func(id uint16) {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		p := ep.ReadContext(ctx)
+		if p == nil {
+			t.Fatal("no ICMP packet before deadline")
+		}
+		defer p.DecRef()
+		bytes := p.ToView()
+		defer bytes.Release()
+		echo := header.ICMPv4(header.IPv4(bytes.AsSlice()).Payload())
+		checkTransportEqual(t, header.ICMPv4EchoReply, echo.Type())
+		checkTransportEqual(t, id, echo.Ident())
+	}
+	request(11)
+	testReceive(t, started)
+	checkTransportEqual(t, 0, ep.NumQueued())
+	request(12)
+	reply(12)
+	close(release)
+	reply(11)
+}
+
+func testTransportSYN(port uint16, seq uint32) (stack.TransportEndpointID, *stack.PacketBuffer) {
+	source, dest := tcpip.AddrFrom4([4]byte{192, 0, 2, 2}), tcpip.AddrFrom4([4]byte{198, 51, 100, 4})
+	raw := make([]byte, header.IPv4MinimumSize+header.TCPMinimumSize)
+	iph := header.IPv4(raw)
+	iph.Encode(&header.IPv4Fields{TotalLength: uint16(len(raw)), TTL: 64, Protocol: uint8(header.TCPProtocolNumber), SrcAddr: source, DstAddr: dest})
+	header.TCP(iph.Payload()).Encode(&header.TCPFields{SrcPort: 40000, DstPort: port, SeqNum: seq, DataOffset: header.TCPMinimumSize, Flags: header.TCPFlagSyn})
+	p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(raw)})
+	p.NetworkHeader().Consume(header.IPv4MinimumSize)
+	p.TransportHeader().Consume(header.TCPMinimumSize)
+	p.NetworkProtocolNumber, p.TransportProtocolNumber = header.IPv4ProtocolNumber, header.TCPProtocolNumber
+	p.RXChecksumValidated = true
+	return stack.TransportEndpointID{LocalAddress: dest, RemoteAddress: source, LocalPort: port, RemotePort: 40000}, p
+}
+
+func TestTCPRejectedRequestStopsAtGenerationRetirement(t *testing.T) {
+	for _, mode := range []string{"current", "reset", "close"} {
+		t.Run(mode, func(t *testing.T) {
+			ep := channel.New(4, 1500, "")
+			ip, err := NewGVisorStack(ep)
+			checkTransportError(t, err)
+			defer func() { ip.Close(); ip.Wait(); ep.Close() }()
+			f := NewTCPForwarder(context.Background(), ip, &transportTestPolicy{})
+			f.decisions = new(flowDecisionQueue)
+			generation := f.decisions.generationContextLocked()
+			defer f.decisions.invalidate(true)
+			id, p := testTransportSYN(210, 1)
+			entered, resume, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+			checkTransportEqual(t, true, f.forwarder.HandlePacketWithHandler(id, p, func(r *tcp.ForwarderRequest) {
+				close(entered)
+				<-resume
+				f.forward(r, M.Socksaddr{}, M.Socksaddr{}, FlowVerdict{Action: ActionReject}, generation)
+				close(done)
+			}))
+			p.DecRef()
+			testReceive(t, entered)
+			if mode != "current" {
+				f.decisions.invalidate(mode == "close")
+			}
+			close(resume)
+			testReceive(t, done)
+			want := 0
+			if mode == "current" {
+				want = 1
+			}
+			checkTransportEqual(t, want, ep.NumQueued())
+		})
+	}
+}
