diff --git a/flow_pending_test.go b/flow_pending_test.go
new file mode 100644
index 0000000..f5117e5
--- /dev/null
+++ b/flow_pending_test.go
@@ -0,0 +1,389 @@
+//go:build with_gvisor
+
+package tun
+
+import (
+	"context"
+	"net/netip"
+	"slices"
+	"sync/atomic"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/buffer"
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+)
+
+type pendingTestPolicy struct {
+	Handler
+	begin func(netip.AddrPort) (FlowVerdict, *PendingFlowDecision)
+}
+
+func (p pendingTestPolicy) BeginFlow(_ uint8, _, dst netip.AddrPort, _ []byte) (FlowVerdict, *PendingFlowDecision) {
+	return p.begin(dst)
+}
+
+func (pendingTestPolicy) JudgeFlow(uint8, netip.AddrPort, netip.AddrPort, []byte) FlowVerdict {
+	// A synchronous fallback must not accidentally satisfy a deferred decision.
+	return FlowVerdict{Action: ActionDrop}
+}
+
+type pendingTestDownstream struct {
+	stack.NetworkDispatcher
+	ids []uint16
+}
+
+func (s *pendingTestDownstream) DeliverNetworkPacket(_ tcpip.NetworkProtocolNumber, pkt *stack.PacketBuffer) {
+	data, ok := pkt.Data().PullUp(header.IPv4MinimumSize)
+	if !ok {
+		panic("missing test IPv4 header")
+	}
+	s.ids = append(s.ids, header.IPv4(data).ID())
+}
+
+type pendingTestWriteback struct{ ids []uint16 }
+
+func (*pendingTestWriteback) ReturnHeadroom() int { return 0 }
+
+func (w *pendingTestWriteback) WriteReturnPackets(packets [][]byte) error {
+	for _, packet := range packets {
+		ip := header.IPv4(packet)
+		icmp := header.ICMPv4(ip.Payload())
+		if ip.TransportProtocol() != header.ICMPv4ProtocolNumber || icmp.Type() != header.ICMPv4DstUnreachable {
+			panic("expected an ICMP destination-unreachable reply")
+		}
+		quoted := header.IPv4(icmp.Payload())
+		w.ids = append(w.ids, quoted.ID())
+	}
+	return nil
+}
+
+type pendingTestFilter struct {
+	filter     networkDispatcherFilter
+	downstream pendingTestDownstream
+	writeback  pendingTestWriteback
+	released   atomic.Int32
+}
+
+func newPendingTestFilter(begin func(netip.AddrPort) (FlowVerdict, *PendingFlowDecision)) *pendingTestFilter {
+	f := new(pendingTestFilter)
+	f.filter = networkDispatcherFilter{
+		NetworkDispatcher: &f.downstream,
+		dispatcher:        NewForwardDispatcher(pendingTestPolicy{begin: begin}, &f.writeback, nil, 0, 0),
+	}
+	return f
+}
+
+// Each ordinary datagram carries an IPv4 identification value that is also
+// quoted in its ICMP rejection. The caller surrenders its reference on return.
+func (f *pendingTestFilter) deliver(dstPort, id uint16) {
+	udp := header.UDP(make([]byte, header.UDPMinimumSize+1))
+	udp.Encode(&header.UDPFields{SrcPort: 40000, DstPort: dstPort, Length: uint16(len(udp))})
+	udp.Payload()[0] = 42
+	f.deliverIPv4(id, header.UDPProtocolNumber, udp)
+}
+
+func (f *pendingTestFilter) deliverIPv4(id uint16, protocol tcpip.TransportProtocolNumber, transport []byte) {
+	packet := make([]byte, header.IPv4MinimumSize+len(transport))
+	ip := header.IPv4(packet)
+	ip.Encode(&header.IPv4Fields{
+		TotalLength: uint16(len(packet)), TTL: 64, ID: id, Protocol: uint8(protocol),
+		SrcAddr: tcpip.AddrFrom4([4]byte{192, 0, 2, 1}), DstAddr: tcpip.AddrFrom4([4]byte{198, 51, 100, 1}),
+	})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	copy(ip.Payload(), transport)
+	if protocol == header.TCPProtocolNumber {
+		tcp := header.TCP(ip.Payload())
+		pseudo := header.PseudoHeaderChecksum(protocol, ip.SourceAddress(), ip.DestinationAddress(), uint16(len(transport)))
+		tcp.SetChecksum(^tcp.CalculateChecksum(pseudo))
+	}
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{
+		Payload:   buffer.MakeWithData(packet),
+		OnRelease: func() { f.released.Add(1) },
+	})
+	defer pkt.DecRef()
+	f.filter.DeliverNetworkPacket(header.IPv4ProtocolNumber, pkt)
+}
+
+func TestPendingFilterWakesAndDrainsInOrder(t *testing.T) {
+	for _, test := range []struct {
+		name                string
+		action              FlowAction
+		downstream, replies []uint16
+	}{
+		{"accept", ActionAccept, []uint16{3, 1, 2}, []uint16{4}},
+		{"reject", ActionReject, []uint16{3}, []uint16{4, 1, 2}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				release := make(chan struct{})
+				var started, timedOut atomic.Int32
+				f := newPendingTestFilter(func(dst netip.AddrPort) (FlowVerdict, *PendingFlowDecision) {
+					switch dst.Port() {
+					case 9000:
+						return FlowVerdict{}, &PendingFlowDecision{Resolver: "slow", Resolve: func(ctx context.Context) FlowVerdict {
+							started.Add(1)
+							select {
+							case <-release:
+							case <-ctx.Done():
+							case <-time.After(time.Minute):
+								timedOut.Add(1)
+							}
+							return FlowVerdict{Action: test.action}
+						}}
+					case 9001:
+						return FlowVerdict{}, &PendingFlowDecision{Resolver: "healthy", Resolve: func(context.Context) FlowVerdict {
+							return FlowVerdict{Action: ActionReject}
+						}}
+					default:
+						return FlowVerdict{Action: ActionAccept}, nil
+					}
+				})
+				defer f.filter.dispatcher.Close()
+				f.deliver(9000, 1)
+				synctest.Wait()
+				if started.Load() != 1 || timedOut.Load() != 0 {
+					t.Fatal("initial delivery must return with one decision outstanding")
+				}
+				f.deliver(9000, 2)
+				f.deliver(9002, 3)
+				f.deliver(9001, 4)
+				synctest.Wait()
+				if !slices.Equal(f.downstream.ids, []uint16{3}) || !slices.Equal(f.writeback.ids, []uint16{4}) {
+					t.Fatalf("while held: downstream=%v replies=%v", f.downstream.ids, f.writeback.ids)
+				}
+				close(release)
+				synctest.Wait() // No new packet arrives to wake the dispatcher.
+				if !slices.Equal(f.downstream.ids, test.downstream) || !slices.Equal(f.writeback.ids, test.replies) {
+					t.Fatalf("after completion: downstream=%v replies=%v", f.downstream.ids, f.writeback.ids)
+				}
+				if started.Load() != 1 || timedOut.Load() != 0 || f.released.Load() != 4 {
+					t.Fatalf("starts=%d watchdogs=%d released=%d", started.Load(), timedOut.Load(), f.released.Load())
+				}
+			})
+		})
+	}
+}
+
+func TestPendingFilterRetiresHeldDecision(t *testing.T) {
+	for _, operation := range []string{"reset", "close"} {
+		t.Run(operation, func(t *testing.T) {
+			synctest.Test(t, func(t *testing.T) {
+				retiredAnswer := make(chan struct{})
+				var attempts, canceled, staleReturns, watchdogs atomic.Int32
+				f := newPendingTestFilter(func(netip.AddrPort) (FlowVerdict, *PendingFlowDecision) {
+					if attempts.Add(1) > 1 {
+						return FlowVerdict{Action: ActionAccept}, nil
+					}
+					return FlowVerdict{}, &PendingFlowDecision{Resolver: "old", Resolve: func(ctx context.Context) FlowVerdict {
+						select {
+						case <-ctx.Done():
+							canceled.Add(1)
+						case <-time.After(time.Minute):
+							watchdogs.Add(1)
+						}
+						select {
+						case <-retiredAnswer:
+						case <-time.After(time.Minute):
+							watchdogs.Add(1)
+						}
+						staleReturns.Add(1)
+						// Even if the resolver produces an answer while retiring, it is obsolete.
+						return FlowVerdict{Action: ActionReject}
+					}}
+				})
+				f.deliver(9000, 1)
+				synctest.Wait()
+				if operation == "reset" {
+					defer f.filter.dispatcher.Close()
+					f.filter.dispatcher.ResetNetwork()
+				} else {
+					f.filter.dispatcher.Close()
+				}
+				synctest.Wait()
+				if canceled.Load() != 1 || len(f.writeback.ids) != 0 || len(f.downstream.ids) != 0 || f.released.Load() != 1 {
+					t.Fatalf("%s: canceled=%d replies=%v downstream=%v released=%d", operation, canceled.Load(), f.writeback.ids, f.downstream.ids, f.released.Load())
+				}
+				if operation == "reset" {
+					f.deliver(9000, 2)
+					synctest.Wait()
+					if attempts.Load() != 2 || !slices.Equal(f.downstream.ids, []uint16{2}) || len(f.writeback.ids) != 0 || f.released.Load() != 2 {
+						t.Fatalf("same key after reset: calls=%d downstream=%v replies=%v released=%d", attempts.Load(), f.downstream.ids, f.writeback.ids, f.released.Load())
+					}
+				}
+				close(retiredAnswer)
+				synctest.Wait()
+				if staleReturns.Load() != 1 || watchdogs.Load() != 0 || len(f.writeback.ids) != 0 {
+					t.Fatalf("retired answer: returns=%d watchdogs=%d replies=%v", staleReturns.Load(), watchdogs.Load(), f.writeback.ids)
+				}
+				if operation == "reset" {
+					f.deliver(9000, 3)
+					synctest.Wait()
+					if attempts.Load() != 2 || !slices.Equal(f.downstream.ids, []uint16{2, 3}) || len(f.writeback.ids) != 0 || f.released.Load() != 3 {
+						t.Fatalf("replacement flow after old answer: calls=%d downstream=%v replies=%v released=%d", attempts.Load(), f.downstream.ids, f.writeback.ids, f.released.Load())
+					}
+				}
+			})
+		})
+	}
+}
+
+func TestPendingFilterReservesAnotherResolversCapacity(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		release := make(chan struct{})
+		var held, completed atomic.Int32
+		const healthyPort uint16 = 7000
+		f := newPendingTestFilter(func(dst netip.AddrPort) (FlowVerdict, *PendingFlowDecision) {
+			if dst.Port() == healthyPort {
+				return FlowVerdict{}, &PendingFlowDecision{Resolver: "independent", Resolve: func(context.Context) FlowVerdict {
+					completed.Add(1)
+					return FlowVerdict{Action: ActionAccept}
+				}}
+			}
+			return FlowVerdict{}, &PendingFlowDecision{Resolver: "occupied", Resolve: func(ctx context.Context) FlowVerdict {
+				held.Add(1)
+				select {
+				case <-release:
+				case <-ctx.Done():
+				case <-time.After(time.Minute):
+				}
+				return FlowVerdict{Action: ActionDrop}
+			}}
+		})
+		defer f.filter.dispatcher.Close()
+		for i := 0; i <= maxPendingPerResolver; i++ {
+			f.deliver(9000+uint16(i), uint16(i+1))
+		}
+		f.deliver(healthyPort, 80)
+		synctest.Wait()
+		if held.Load() != maxPendingPerResolver || completed.Load() != 1 || !slices.Equal(f.downstream.ids, []uint16{80}) {
+			t.Fatalf("other resolver's admission: held=%d completed=%d delivered=%v", held.Load(), completed.Load(), f.downstream.ids)
+		}
+		close(release)
+		synctest.Wait()
+		if !slices.Equal(f.downstream.ids, []uint16{80}) || len(f.writeback.ids) != 0 || f.released.Load() != maxPendingPerResolver+2 {
+			t.Fatalf("drain: delivered=%v replies=%v released=%d", f.downstream.ids, f.writeback.ids, f.released.Load())
+		}
+	})
+}
+
+func TestPendingFilterReusedTCPAddressStartsANewDecision(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		oldMayReturn := make(chan struct{})
+		var begins, canceled, watchdogs atomic.Int32
+		f := newPendingTestFilter(func(netip.AddrPort) (FlowVerdict, *PendingFlowDecision) {
+			if begins.Add(1) > 1 {
+				return FlowVerdict{Action: ActionAccept}, nil
+			}
+			return FlowVerdict{}, &PendingFlowDecision{Resolver: "first", Resolve: func(ctx context.Context) FlowVerdict {
+				select {
+				case <-ctx.Done():
+					canceled.Add(1)
+				case <-time.After(time.Minute):
+					watchdogs.Add(1)
+				}
+				select {
+				case <-oldMayReturn:
+				case <-time.After(time.Minute):
