index 0000000..576f64a
--- /dev/null
+++ b/flow_decision.go
@@ -0,0 +1,205 @@
+package tun
+
+import (
+	"context"
+	"net/netip"
+	"sync"
+	"time"
+)
+
+// DeferredFlowHandler identifies the resolver before the packet owner admits work.
+// The continuation owns any policy inputs it retains after BeginFlow returns.
+type DeferredFlowHandler interface {
+	BeginFlow(network uint8, source, destination netip.AddrPort, firstPacket []byte) (FlowVerdict, *PendingFlowDecision)
+}
+
+type PendingFlowDecision struct {
+	Resolver string
+	Resolve  func(context.Context) FlowVerdict
+	Valid    func() bool
+}
+
+// One queue per ingress stage. All commits and retries are serialized with both
+// ordinary packets at that stage and retirement of the owning generation.
+type flowDecisionQueue struct {
+	origin   *ForwardDispatcher
+	lifetime context.Context
+	retire   context.CancelFunc
+
+	workers        sync.WaitGroup
+	mu             sync.Mutex
+	closed         bool
+	pauses         int
+	pending        map[flowKey]*pendingPackets
+	byResolver     map[string]int
+	groupBytes     map[string]int
+	recentFailures [32]struct {
+		key      flowKey
+		resolver string
+		until    time.Time
+	}
+	nextFailure int
+	active      int
+	bytes       int
+}
+
+const (
+	maxPendingPerResolver = 8
+	maxPendingDecisions   = 128
+	maxPacketsPerDecision = 8
+	maxBytesPerDecision   = 128 * 1024
+	maxDecisionBytes      = 4 * 1024 * 1024
+	maxResolverBytes      = 512 * 1024
+)
+
+type flowDecisionPacket struct {
+	commit  func(FlowVerdict)
+	replay  func()
+	release func()
+}
+
+type pendingPackets struct {
+	resolver string
+	tcpSeq   uint32
+	cancel   context.CancelFunc
+	packets  []flowDecisionPacket
+	bytes    int
+}
+
+func (q *flowDecisionQueue) queueIfPendingLocked(key flowKey, size int, retain func() flowDecisionPacket) bool {
+	if q.closed || q.pauses != 0 {
+		return true
+	}
+	p := q.pending[key]
+	if p == nil {
+		return false
+	}
+	q.retainLocked(p, size, retain)
+	return true
+}
+
+func (q *flowDecisionQueue) retainLocked(p *pendingPackets, size int, retain func() flowDecisionPacket) bool {
+	if size < 0 || len(p.packets) >= maxPacketsPerDecision || size > maxBytesPerDecision-p.bytes || size > maxDecisionBytes-q.bytes || size > maxResolverBytes-q.groupBytes[p.resolver] {
+		return false
+	}
+	p.packets = append(p.packets, retain())
+	p.bytes += size
+	q.bytes += size
+	q.groupBytes[p.resolver] += size
+	return true
+}
+
+func (q *flowDecisionQueue) deferLocked(key flowKey, size int, retain func() flowDecisionPacket, decision *PendingFlowDecision) {
+	if q.closed || q.pauses != 0 || decision.Resolve == nil || q.active >= maxPendingDecisions || q.byResolver[decision.Resolver] >= maxPendingPerResolver {
+		return
+	}
+	if q.pending == nil {
+		q.pending = make(map[flowKey]*pendingPackets)
+		q.byResolver = make(map[string]int)
+		q.groupBytes = make(map[string]int)
+	}
+	// A resolver can fail immediately. A short per-flow hold prevents a
+	// retransmission burst from starting a fresh exchange for each datagram.
+	// Only misses reach this point, so an independently warmed answer still wins.
+	now := time.Now()
+	for i := range q.recentFailures {
+		failure := &q.recentFailures[i]
+		if failure.key == key && failure.resolver == decision.Resolver && now.Before(failure.until) {
+			return
+		}
+	}
+	p := &pendingPackets{resolver: decision.Resolver}
+	if !q.retainLocked(p, size, retain) {
+		return
+	}
+	var ctx context.Context
+	ctx, p.cancel = context.WithCancel(context.Background())
+	q.pending[key] = p
+	q.byResolver[decision.Resolver]++
+	q.active++
+	q.workers.Add(1)
+	go func() {
+		defer q.workers.Done()
+		verdict := decision.Resolve(ctx)
+		valid := decision.Valid == nil || ctx.Err() == nil && decision.Valid()
+		p.cancel()
+		q.mu.Lock()
+		defer q.mu.Unlock()
+		q.active--
+		q.byResolver[decision.Resolver]--
+		if q.byResolver[decision.Resolver] == 0 {
+			delete(q.byResolver, decision.Resolver)
+		}
+		if q.pending[key] != p {
+			return
+		}
+		q.removeLocked(key, p)
+		if valid && verdict.Transient {
+			failure := &q.recentFailures[q.nextFailure]
+			failure.key, failure.resolver, failure.until = key, decision.Resolver, time.Now().Add(250*time.Millisecond)
+			q.nextFailure = (q.nextFailure + 1) % len(q.recentFailures)
+		}
+		for i, packet := range p.packets {
+			if valid {
+				if i == 0 {
+					packet.commit(verdict)
+				} else {
+					packet.replay()
+				}
+			}
+			packet.release()
+		}
+	}()
+}
+
+func (q *flowDecisionQueue) generationContextLocked() context.Context {
+	if q.lifetime == nil {
+		q.lifetime, q.retire = context.WithCancel(context.Background())
+		if q.closed {
+			q.retire()
+		}
+	}
+	return q.lifetime
+}
+
+func (q *flowDecisionQueue) invalidate(closing bool) {
+	if q == nil {
+		return
+	}
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	q.invalidateLocked(closing)
+}
+
+func (q *flowDecisionQueue) invalidateLocked(closing bool) {
+	clear(q.recentFailures[:])
+	if closing {
+		q.closed = true
+	}
+	if q.retire != nil {
+		q.retire()
+		q.retire = nil
+		q.lifetime = nil
+	}
+	for key, p := range q.pending {
+		q.discardLocked(key, p)
+	}
+}
+
+func (q *flowDecisionQueue) removeLocked(key flowKey, p *pendingPackets) {
+	delete(q.pending, key)
+	q.bytes -= p.bytes
+	q.groupBytes[p.resolver] -= p.bytes
+	if q.groupBytes[p.resolver] == 0 {
+		delete(q.groupBytes, p.resolver)
+	}
+}
+
+func (q *flowDecisionQueue) discardLocked(key flowKey, p *pendingPackets) {
+	q.removeLocked(key, p)
+	p.cancel()
+	for _, packet := range p.packets {
+		packet.release()
+	}
+	p.packets = nil
+}
