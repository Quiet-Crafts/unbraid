diff --git a/stack_gvisor_transport_decision.go b/stack_gvisor_transport_decision.go
new file mode 100644
index 0000000..477fd1b
--- /dev/null
+++ b/stack_gvisor_transport_decision.go
@@ -0,0 +1,120 @@
+//go:build with_gvisor
+
+package tun
+
+import (
+	"context"
+	"sync/atomic"
+
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+)
+
+// The transport owns an already parsed packet. Never re-inject a reassembled
+// datagram as a raw packet, or allow a pending request to send a local reply.
+type transportAdmission struct {
+	key    flowKey
+	handle DeferredFlowHandler
+	cached func(*stack.PacketBuffer) bool
+	commit func(*stack.PacketBuffer, FlowVerdict)
+}
+
+func (a transportAdmission) admit(q *flowDecisionQueue, pkt *stack.PacketBuffer) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	verdict, prepared := q.takeVerdict(pkt, a.key)
+	a.admitLocked(q, pkt, verdict, prepared)
+}
+
+func (a transportAdmission) admitLocked(q *flowDecisionQueue, pkt *stack.PacketBuffer, verdict FlowVerdict, prepared bool) {
+	retain := func() flowDecisionPacket {
+		// Clone shares backing storage. ICMP may rewrite headers, and the TUN
+		// reader can recycle its input as soon as the stack callback returns.
+		owned := pkt.DeepCopyForForwarding(0)
+		owned.NetworkPacketInfo = pkt.NetworkPacketInfo
+		owned.RXChecksumValidated = pkt.RXChecksumValidated
+		owned.GSOOptions = pkt.GSOOptions
+		owned.NICID = pkt.NICID
+		owned.PktType = pkt.PktType
+		return flowDecisionPacket{
+			commit:  func(v FlowVerdict) { a.commit(owned, v) },
+			replay:  func() { a.admitLocked(q, owned, verdict, prepared) },
+			release: owned.DecRef,
+		}
+	}
+	var sequence uint32
+	if a.key.protocol == uint8(header.TCPProtocolNumber) {
+		sequence = header.TCP(pkt.TransportHeader().Slice()).SequenceNumber()
+		if prior := q.pending[a.key]; prior != nil {
+			if prior.tcpSeq == sequence {
+				return // the original validated SYN owns this attempt
+			}
+			q.discardLocked(a.key, prior)
+		}
+	}
+	if q.queueIfPendingLocked(a.key, pkt.Size(), retain) {
+		return
+	}
+	if prepared {
+		a.commit(pkt, verdict)
+		return
+	}
+	if a.cached != nil && a.cached(pkt) {
+		return
+	}
+	var payload []byte
+	if a.key.protocol == uint8(header.UDPProtocolNumber) {
+		data := pkt.Data()
+		payload, _ = data.PullUp(data.Size())
+	}
+	v, pending := a.handle.BeginFlow(a.key.protocol, a.key.source, a.key.destination, payload)
+	if pending != nil {
+		q.deferLocked(a.key, pkt.Size(), retain, pending)
+		if started := q.pending[a.key]; started != nil {
+			started.tcpSeq = sequence
+		}
+		return
+	}
+	a.commit(pkt, v)
+}
+
+// Routing uses the parent socket context. Retirement can cancel it until the
+// socket begins its handshake. Established connections keep their normal lifetime.
+type flowHandshakeLease struct {
+	committed  atomic.Bool
+	generation context.Context
+	cancel     context.CancelFunc
+	stop       func() bool
+}
+
+func newFlowHandshakeLease(parent, generation context.Context) (context.Context, *flowHandshakeLease) {
+	ctx, cancel := context.WithCancel(parent)
+	l := &flowHandshakeLease{generation: generation, cancel: cancel, stop: context.AfterFunc(generation, cancel)}
+	if generation.Err() != nil {
+		cancel()
+	}
+	return ctx, l
+}
+
+// Called once by the socket under its handshake lock.
+func (l *flowHandshakeLease) claim() bool {
+	if l == nil {
+		return true
+	}
+	if l.committed.Load() {
+		return true
+	}
+	l.stop()
+	if l.generation.Err() != nil {
+		return false
+	}
+	l.committed.Store(true)
+	return true
+}
+
+func (l *flowHandshakeLease) close() {
+	if l != nil {
+		l.stop()
+		l.cancel()
+	}
+}
diff --git a/stack_gvisor_transport_policy_test.go b/stack_gvisor_transport_policy_test.go
