index 0000000..8a7b237
--- /dev/null
+++ b/pkg/tcpip/network/ipv6/ingress_decision_test.go
@@ -0,0 +1,56 @@
+package ipv6_test
+
+import (
+	"testing"
+
+	"github.com/sagernet/gvisor/pkg/buffer"
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/link/channel"
+	"github.com/sagernet/gvisor/pkg/tcpip/network/ipv6"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+	"github.com/sagernet/gvisor/pkg/tcpip/transport/udp"
+)
+
+func TestLocalIngressDecisionAndReassembly(t *testing.T) {
+	s := stack.New(stack.Options{NetworkProtocols: []stack.NetworkProtocolFactory{ipv6.NewProtocol}, TransportProtocols: []stack.TransportProtocolFactory{udp.NewProtocol}})
+	defer s.Destroy()
+	link := channel.New(1, 1500, "")
+	if err := s.CreateNIC(1, link); err != nil {
+		t.Fatal(err)
+	}
+	src := tcpip.AddrFrom16([16]byte{0x20, 1, 0xdb, 8, 15: 1})
+	dst := tcpip.AddrFrom16([16]byte{0x20, 1, 0xdb, 8, 15: 2})
+	if err := s.AddProtocolAddress(1, tcpip.ProtocolAddress{Protocol: ipv6.ProtocolNumber, AddressWithPrefix: dst.WithPrefix()}, stack.AddressProperties{}); err != nil {
+		t.Fatal(err)
+	}
+
+	var received []any
+	s.SetTransportProtocolHandler(udp.ProtocolNumber, func(_ stack.TransportEndpointID, p *stack.PacketBuffer) bool {
+		received = append(received, p.IngressDecision)
+		return true
+	})
+	inject := func(data []byte, exts header.IPv6ExtHdrSerializer, decision string) {
+		hdrLen := header.IPv6MinimumSize + exts.Length()
+		b := make([]byte, hdrLen+len(data))
+		header.IPv6(b).Encode(&header.IPv6Fields{HopLimit: 64, SrcAddr: src, DstAddr: dst, TransportProtocol: udp.ProtocolNumber,
+			PayloadLength: uint16(len(b) - header.IPv6MinimumSize), ExtensionHeaders: exts})
+		copy(b[hdrLen:], data)
+		p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(b)})
+		p.IngressDecision = decision
+		p.RXChecksumValidated = true
+		link.InjectInbound(ipv6.ProtocolNumber, p)
+		p.DecRef()
+	}
+	data := make([]byte, 16)
+	header.UDP(data).Encode(&header.UDPFields{SrcPort: 40001, DstPort: 40002, Length: 16, Checksum: 1})
+	inject(data, nil, "whole")
+	if len(received) != 1 || received[0] != "whole" {
+		t.Fatalf("local packet received %v", received)
+	}
+	inject(data[:8], header.IPv6ExtHdrSerializer{&header.IPv6SerializableFragmentExtHdr{Identification: 1, M: true}}, "first")
+	inject(data[8:], header.IPv6ExtHdrSerializer{&header.IPv6SerializableFragmentExtHdr{Identification: 1, FragmentOffset: 1}}, "last")
+	if len(received) != 2 || received[1] != nil {
+		t.Fatalf("reassembled packet received %v", received)
+	}
+}
