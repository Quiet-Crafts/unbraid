diff --git a/pkg/tcpip/stack/bridge.go b/pkg/tcpip/stack/bridge.go
index d3cc082..23179a2 100644
--- a/pkg/tcpip/stack/bridge.go
+++ b/pkg/tcpip/stack/bridge.go
@@ -100,6 +100,11 @@ func (p *bridgePort) DeliverNetworkPacket(protocol tcpip.NetworkProtocolNumber,
 		// The dispatcher may acquire Stack.mu in DeliverNetworkPacket(), which is
 		// ordered above bridge.mu. So call DeliverNetworkPacket() without holding
 		// bridge.mu to avoid circular locking.
+		if pkt.IngressDecision != nil {
+			// The bridge is another ingress. Its stack must judge the packet itself.
+			pkt = pkt.Clone()
+			defer pkt.DecRef()
+		}
 		d.DeliverNetworkPacket(protocol, pkt)
 	}
 }
diff --git a/pkg/tcpip/stack/ingress_decision_test.go b/pkg/tcpip/stack/ingress_decision_test.go
new file mode 100644
index 0000000..9971bfc
--- /dev/null
+++ b/pkg/tcpip/stack/ingress_decision_test.go
@@ -0,0 +1,48 @@
+package stack
+
+import (
+	"testing"
+
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+)
+
+type ingressRecorder struct {
+	packets  int
+	decision any
+}
+
+func (r *ingressRecorder) DeliverNetworkPacket(_ tcpip.NetworkProtocolNumber, p *PacketBuffer) {
+	r.packets++
+	r.decision = p.IngressDecision
+}
+func (*ingressRecorder) DeliverLinkPacket(tcpip.NetworkProtocolNumber, *PacketBuffer) {}
+
+func TestIngressDecisionEndsAtPacketBoundaries(t *testing.T) {
+	p := NewPacketBuffer(PacketBufferOptions{ReserveHeaderBytes: header.EthernetMinimumSize + header.IPv4MinimumSize})
+	defer p.DecRef()
+	p.NetworkHeader().Push(header.IPv4MinimumSize)
+	p.NetworkProtocolNumber = header.IPv4ProtocolNumber
+	p.LinkHeader().Push(header.EthernetMinimumSize)
+	p.IngressDecision = "local"
+	for _, clone := range []*PacketBuffer{p.Clone(), p.CloneToInbound(), p.DeepCopyForForwarding(0)} {
+		if clone.IngressDecision != nil {
+			t.Error("packet copy inherited the link's decision")
+		}
+		clone.DecRef()
+	}
+	r := &ingressRecorder{}
+	b := NewBridgeEndpoint(1500)
+	b.Attach(r)
+	port := bridgePort{bridge: b}
+	port.DeliverNetworkPacket(header.IPv4ProtocolNumber, p)
+	if r.packets != 1 || r.decision != nil || p.IngressDecision != "local" {
+		t.Fatalf("bridge delivered %d packets, decision %v, original %v", r.packets, r.decision, p.IngressDecision)
+	}
+	// Every object taken from the pool is reset before reuse.
+	reused := PacketBuffer{IngressDecision: "previous packet"}
+	reused.reset()
+	if reused.IngressDecision != nil {
+		t.Error("pool reset preserved the old decision")
+	}
+}
