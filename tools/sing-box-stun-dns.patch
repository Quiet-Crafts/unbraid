@@ -0,0 +1,38 @@
+package daemon
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/dialer"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+func TestSplitSTUNServer(t *testing.T) {
+	for _, c := range []struct{ in, dns, server string }{
+		{"dns-r-nl|stun.l.google.com:19302", "dns-r-nl", "stun.l.google.com:19302"},
+		{"stun.l.google.com:19302", "", "stun.l.google.com:19302"},
+		{"dns-r-nl|74.125.250.129:19302", "dns-r-nl", "74.125.250.129:19302"},
+	} {
+		dns, server := splitSTUNServer(c.in)
+		if dns != c.dns || server != c.server {
+			t.Fatalf("%q: got %q %q", c.in, dns, server)
+		}
+	}
+}
+
+type noTransports struct{ adapter.DNSTransportManager }
+
+func (noTransports) Transport(string) (adapter.DNSTransport, bool) { return nil, false }
+
+// A named DNS server that doesn't exist fails the lookup: it never falls back to the default resolver.
+func TestUnknownResolverFails(t *testing.T) {
+	ctx := service.ContextWith[adapter.DNSTransportManager](context.Background(), noTransports{})
+	d := dialer.NewResolveDialer(ctx, N.SystemDialer, true, "dns-missing", adapter.DNSQueryOptions{}, 0)
+	if _, err := d.ListenPacket(ctx, M.ParseSocksaddr("stun.l.google.com:19302")); err == nil {
+		t.Fatal("an unknown resolver must fail the lookup")
+	}
+}
