--- /dev/null
+++ b/daemon/stun_server.go
@@ -0,0 +1,12 @@
+package daemon
+
+import "strings"
+
+// Unbraid: a STUN test's server may be "<DNS server tag>|<host:port>": its host is then looked up through that DNS
+// server (the tunnel's own), never the default one, and an unknown tag fails the test instead of falling back.
+func splitSTUNServer(server string) (dnsServer string, stunServer string) {
+	if i := strings.IndexByte(server, '|'); i >= 0 {
+		return server[:i], server[i+1:]
+	}
+	return "", server
+}
