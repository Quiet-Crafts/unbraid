index 0000000..e939d96
--- /dev/null
+++ b/experimental/libbox/kem.go
@@ -0,0 +1,48 @@
+package libbox
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"strings"
+
+	"github.com/cloudflare/circl/kem/kyber/kyber1024"
+)
+
+// Kyber1024KeyPair makes a Round-3 Kyber-1024 key pair (the variant IVPN's key exchange uses, not the final
+// ML-KEM). It returns "public|private", both base64.
+func Kyber1024KeyPair() (string, error) {
+	pk, sk, err := kyber1024.GenerateKeyPair(rand.Reader)
+	if err != nil {
+		return "", err
+	}
+	pkb, err := pk.MarshalBinary()
+	if err != nil {
+		return "", err
+	}
+	skb, err := sk.MarshalBinary()
+	if err != nil {
+		return "", err
+	}
+	return base64.StdEncoding.EncodeToString(pkb) + "|" + base64.StdEncoding.EncodeToString(skb), nil
+}
+
+// Kyber1024PSK decapsulates a base64 ciphertext with a base64 private key from Kyber1024KeyPair and returns
+// base64(SHA-256(shared secret)), the WireGuard preshared key.
+func Kyber1024PSK(private, cipher string) (string, error) {
+	skb, err := base64.StdEncoding.DecodeString(private)
+	if err != nil || len(skb) != kyber1024.PrivateKeySize {
+		return "", errors.New("bad Kyber-1024 private key")
+	}
+	ct, err := base64.StdEncoding.DecodeString(strings.Join(strings.Fields(cipher), ""))
+	if err != nil || len(ct) != kyber1024.CiphertextSize {
+		return "", errors.New("bad Kyber-1024 ciphertext")
+	}
+	var sk kyber1024.PrivateKey
+	sk.Unpack(skb)
+	ss := make([]byte, kyber1024.SharedKeySize)
+	sk.DecapsulateTo(ss, ct)
+	h := sha256.Sum256(ss)
+	return base64.StdEncoding.EncodeToString(h[:]), nil
+}
