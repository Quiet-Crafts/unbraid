<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: status and health. Cookie, the profile in use and Tailscale, "6/6 routes OK", the headline, one action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:backgroundTint="#FF1E2428"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include layout="@layout/widget_cookie" />

        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_tag_fill"
                android:backgroundTint="#FF3A2A1F"
                android:ellipsize="end"
                android:fontFamily="monospace"
        android:textStyle="bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:maxWidth="88dp"
                android:paddingHorizontal="7dp"
                android:textAllCaps="true"
                android:textColor="#FFFFA66B"
                android:textSize="9.5dp"
                android:visibility="gone" />

            <include layout="@layout/widget_ts" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/over"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FFFF8A80"
        android:textSize="9.5dp" />

    <TextView
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-condensed"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FFECEFF1"
        android:textSize="25dp" />

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <include layout="@layout/widget_action" />
</LinearLayout>
