<?xml version="1.0" encoding="utf-8"?>
<!-- One route in the 4x2 widget: chip, what it carries, the exit's name and whether it answers. -->
<!-- In a cell of its own: the tile's height is set in code to what the widget leaves, which a list's own item can't take. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:id="@+id/tile"
    android:layout_width="match_parent"
    android:layout_height="116dp"
    android:layout_marginHorizontal="1dp"
    android:background="@drawable/widget_seg_m"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="9dp">

    <include layout="@layout/widget_chip" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#FF9AA5AD"
        android:textSize="9dp" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFECEFF1"
        android:textSize="13sp" />

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot" />

        <TextView
            android:id="@+id/health"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF9AA5AD"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
