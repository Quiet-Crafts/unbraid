<?xml version="1.0" encoding="utf-8"?>
<!-- 1x1: the cookie badge, Tailscale, the profile in use and one action. Everything live is set in code (Widgets). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:backgroundTint="#FF1E2428"
    android:orientation="vertical"
    android:padding="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include
            layout="@layout/widget_cookie"
            android:layout_width="32dp"
            android:layout_height="32dp" />

        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/ts"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/tsDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/tsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
        android:textStyle="bold"
                android:includeFontPadding="false"
                android:text="TS"
                android:textColor="#FFECEFF1"
                android:textSize="9.5dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <!-- The profile in use, small, and how many routes work as a bare count (set and coloured in code). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <TextView
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFA66B"
            android:textSize="10.5dp" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="monospace"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF8EE0A8"
            android:textSize="11.5dp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <!-- The pill is 30 dp tall; the area that takes its taps is the whole lower part of the card. -->
    <FrameLayout
        android:id="@+id/actionArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="30dp">

        <TextView
            android:id="@+id/action"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@drawable/widget_pill"
            android:backgroundTint="#FFFFA66B"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_connect"
            android:textColor="#FF2A1A0F"
            android:textSize="13dp" />
    </FrameLayout>
</LinearLayout>
