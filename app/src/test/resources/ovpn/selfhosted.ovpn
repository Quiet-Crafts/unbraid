# self-hosted OpenVPN 2.6 server, TCP fallback
client
dev tun
proto tcp-client
remote vpn.example.net 443
remote vpn2.example.net 8443 tcp
remote 203.0.113.10 1194 udp
remote-random
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
verify-x509-name "vpn.example.net" name
cipher AES-256-GCM
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-128-CBC
auth SHA256
tls-version-min 1.2
key-direction 1
reneg-sec 3600
keepalive 10 60
pull-filter ignore "route-ipv6"
redirect-gateway def1
dhcp-option DNS 10.8.0.1
auth-user-pass
